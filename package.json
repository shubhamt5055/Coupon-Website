{
  "name": "coupon-website",
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "check": "astro check",
    "generate-types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply coupon-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply coupon-db --remote",
    "db:seed:local": "wrangler d1 execute coupon-db --local --file=./db/seed.sql",
    "db:seed:remote": "wrangler d1 execute coupon-db --remote --file=./db/seed.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.8",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.164.0"
  }
}
