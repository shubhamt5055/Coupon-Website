---
import type { Category, CouponWithRelations, Store } from "../lib/types";

interface Props {
  mode: "create" | "edit";
  coupon?: CouponWithRelations;
  stores: Store[];
  categories: Category[];
}

const { mode, coupon, stores, categories } = Astro.props;
const today = new Date().toISOString().slice(0, 10);
const defaultExpiry = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
---

<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-2xs sm:p-8">
  <form
    id="coupon-admin-form"
    data-mode={mode}
    data-coupon-id={coupon?.id ?? ""}
    class="space-y-6"
  >
    <!-- Heading -->
    <div class="flex items-center gap-3">
      <div>
        <h2 class="text-xl font-extrabold text-[#191f2e]">
          {mode === "create" ? "New Coupon" : "Edit Coupon"}
        </h2>
      </div>
    </div>

    <div
      id="form-alert"
      class="hidden rounded-xl border border-rose-200 bg-rose-50 p-3.5 text-xs font-semibold text-rose-700"
    ></div>

    <!-- Basics -->
    <section class="space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">
        1. Coupon Details
      </h3>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label
            for="title"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Coupon Title
          </label>
          <input
            id="title"
            name="title"
            type="text"
            required
            minlength="5"
            maxlength="140"
            value={coupon?.title ?? ""}
            placeholder="e.g., Flat 25% Off on Headphones & Audio"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Min 5 - Max 140 characters. Special symbols (&lt; &gt; . / ? &quot;
            [ ] &#123; &#125; \ | - + * @ ! ~ # $ ^ ( ) =) are not allowed.
          </p>
        </div>
        <div>
          <label for="code" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Promo Code
          </label>
          <input
            id="code"
            name="code"
            type="text"
            required
            minlength="2"
            maxlength="30"
            value={coupon?.code ?? ""}
            placeholder="e.g., SAVE25"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 font-mono text-xs sm:text-sm uppercase tracking-widest text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Letters, numbers, and hyphens (2–30 characters).
          </p>
        </div>
        <div>
          <label
            for="discount_text"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Discount Badge
          </label>
          <input
            id="discount_text"
            name="discount_text"
            type="text"
            required
            maxlength="40"
            value={coupon?.discount_text ?? ""}
            placeholder="e.g., 25% OFF or ₹150 OFF"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Max 99% OFF (or flat amount, e.g. ₹150 OFF).
          </p>
        </div>
      </div>
    </section>

    <!-- Store & Category -->
    <section class="border-t border-slate-100 pt-5 space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">
        2. Store, Category &amp; Target Link
      </h3>
      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label
            for="store_id"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Store
          </label>
          <select
            id="store_id"
            name="store_id"
            required
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          >
            <option value="">Select store</option>
            {stores.map((s) => (
              <option value={s.id} selected={coupon?.store_id === s.id}>
                {s.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label
            for="category_id"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Category *
          </label>
          <select
            id="category_id"
            name="category_id"
            required
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          >
            <option value="">Select category</option>
            {categories.map((c) => (
              <option value={c.id} selected={coupon?.category_id === c.id}>
                {c.icon} {c.name}
              </option>
            ))}
          </select>
        </div>
        <div>
          <label
            for="affiliate_or_store_url"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Affiliate or Store URL *
          </label>
          <input
            id="affiliate_or_store_url"
            name="affiliate_or_store_url"
            type="url"
            required
            value={coupon?.affiliate_or_store_url ?? ""}
            placeholder="https://www.example.com/offer"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Must start with http:// or https:// with valid domain.
          </p>
        </div>
        <div>
          <label
            for="expiry_date"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Expiry Date
          </label>
          <input
            id="expiry_date"
            name="expiry_date"
            type="date"
            required
            min={today}
            value={
              coupon?.expiry_date
                ? coupon.expiry_date.slice(0, 10)
                : defaultExpiry
            }
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Must be today or a future date.
          </p>
        </div>
      </div>
    </section>

    <!-- Details -->
    <section class="border-t border-slate-100 pt-5 space-y-4">
      <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">
        3. Copy &amp; Restrictions
      </h3>
      <div>
        <label
          for="description"
          class="mb-1 block text-xs font-bold text-[#191f2e]"
        >
          Description
        </label>
        <textarea
          id="description"
          name="description"
          rows="3"
          maxlength="1000"
          placeholder="Brief offer description or eligible products..."
          class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
        >{coupon?.description ?? ""}</textarea>
      </div>
      <div>
        <label for="terms" class="mb-1 block text-xs font-bold text-[#191f2e]">
          Terms &amp; Conditions
        </label>
        <textarea
          id="terms"
          name="terms"
          rows="3"
          maxlength="1500"
          placeholder="e.g., Minimum order value Rs. 499. Valid once per account."
          class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
        >{coupon?.terms ?? ""}</textarea>
      </div>
    </section>

    <!-- Active switch -->
    <label class="flex cursor-pointer items-center justify-between gap-4 rounded-xl border border-slate-200 bg-[#f8fafc] p-4">
      <div>
        <span class="block text-sm font-bold text-[#191f2e]">
          Published &amp; Active
        </span>
        <span class="text-xs text-slate-500">
          Immediately visible to shoppers on the live site
        </span>
      </div>
      <input
        type="checkbox"
        name="is_active"
        checked={coupon ? coupon.is_active === 1 : true}
        class="peer sr-only"
      />
      <span class="relative h-6 w-11 shrink-0 rounded-full bg-slate-300 transition peer-checked:bg-[#60a600] after:absolute after:left-0.5 after:top-0.5 after:h-5 after:w-5 after:rounded-full after:bg-white after:shadow after:transition peer-checked:after:translate-x-5"></span>
    </label>

    <!-- Actions -->
    <div class="flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
      <a
        href="/admin"
        class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 transition"
      >
        Cancel
      </a>
      <button
        type="submit"
        id="submit-coupon-btn"
        class="rounded-lg bg-[#2491ef] px-6 py-2 text-xs font-extrabold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
      >
        {mode === "create" ? "Publish Coupon" : "Save Changes"}
      </button>
    </div>
  </form>
</div>

<script>
  const form = document.getElementById(
    "coupon-admin-form",
  ) as HTMLFormElement | null;
  const alertBox = document.getElementById("form-alert");
  const submitBtn = document.getElementById(
    "submit-coupon-btn",
  ) as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    alertBox?.classList.add("hidden");

    const mode = form.dataset.mode;
    const id = form.dataset.couponId;
    const fd = new FormData(form);

    const payload = {
      title: String(fd.get("title") || "").trim(),
      code: String(fd.get("code") || "")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, ""),
      discount_text: String(fd.get("discount_text") || "").trim(),
      store_id: Number(fd.get("store_id")),
      category_id: Number(fd.get("category_id")),
      affiliate_or_store_url: String(
        fd.get("affiliate_or_store_url") || "",
      ).trim(),
      expiry_date: String(fd.get("expiry_date") || "").trim(),
      description: String(fd.get("description") || "").trim(),
      terms: String(fd.get("terms") || "").trim(),
      is_active: fd.get("is_active") === "on" ? 1 : 0,
    };

    // Client-side validations
    if (payload.title.length < 5) {
      if (alertBox) {
        alertBox.textContent =
          "Coupon title must be at least 5 characters long.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    if (payload.title.length > 140) {
      if (alertBox) {
        alertBox.textContent = "Coupon title cannot exceed 140 characters.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    const letterMatches = payload.title.match(/[\p{L}]/gu);
    if (!letterMatches || letterMatches.length < 2) {
      if (alertBox) {
        alertBox.textContent =
          "Title cannot be only numbers or symbols. Please include descriptive words.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    const disallowedTitleCharsRegex = /[<>./?"\]\[{}\\|+\-*@!~#$^()=]/;
    if (disallowedTitleCharsRegex.test(payload.title)) {
      if (alertBox) {
        alertBox.textContent =
          'Special symbols (< > . / ? " [ ] { } \\ | - + * @ ! ~ # $ ^ ( ) =) are not allowed in Title.';
        alertBox.classList.remove("hidden");
      }
      return;
    }

    const titleAllowedRegex = /^[\p{L}\p{N}\s%₹&',:–—]+$/u;
    if (!titleAllowedRegex.test(payload.title)) {
      if (alertBox) {
        alertBox.textContent =
          "Title contains invalid characters. Special symbols are not allowed.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    if (payload.code.length < 2 || payload.code.length > 30) {
      if (alertBox) {
        alertBox.textContent =
          "Promo code must be between 2 and 30 characters.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    if (!/^[A-Z0-9_-]+$/.test(payload.code)) {
      if (alertBox) {
        alertBox.textContent =
          "Promo code can only contain letters, numbers, hyphens, and underscores.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    const pctMatch = payload.discount_text.match(/(\d+(?:\.\d+)?)\s*%/);
    if (pctMatch) {
      const pctVal = parseFloat(pctMatch[1]);
      if (pctVal > 99) {
        if (alertBox) {
          alertBox.textContent =
            "Discount percentage cannot exceed 99% (maximum allowed is 99% OFF).";
          alertBox.classList.remove("hidden");
        }
        return;
      }
      if (pctVal <= 0) {
        if (alertBox) {
          alertBox.textContent = "Discount percentage must be greater than 0%.";
          alertBox.classList.remove("hidden");
        }
        return;
      }
    }

    try {
      const parsedUrl = new URL(payload.affiliate_or_store_url);
      if (parsedUrl.protocol !== "http:" && parsedUrl.protocol !== "https:") {
        throw new Error("Invalid protocol");
      }
      if (!parsedUrl.hostname || !parsedUrl.hostname.includes(".")) {
        throw new Error("Invalid domain");
      }
    } catch {
      if (alertBox) {
        alertBox.textContent =
          "Please enter a valid store/deal link URL (e.g. https://www.store.com/deal).";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    const todayStr = new Date().toISOString().slice(0, 10);
    if (payload.expiry_date < todayStr) {
      if (alertBox) {
        alertBox.textContent =
          "Expiry date cannot be in the past. Please choose today or a future date.";
        alertBox.classList.remove("hidden");
      }
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = mode === "create" ? "Publishing..." : "Saving...";
    }

    try {
      const endpoint =
        mode === "create" ? "/api/admin/coupons" : `/api/admin/coupons/${id}`;
      const method = mode === "create" ? "POST" : "PUT";
      const res = await fetch(endpoint, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { ok?: boolean; error?: string };

      if (!res.ok || !data.ok) {
        if (alertBox) {
          alertBox.textContent =
            data.error || "Please check all fields and try again.";
          alertBox.classList.remove("hidden");
        }
        return;
      }

      window.location.href = "/admin";
    } catch {
      if (alertBox) {
        alertBox.textContent = "Network error while saving coupon.";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent =
          mode === "create" ? "Publish Coupon" : "Save Changes";
      }
    }
  });
</script>
