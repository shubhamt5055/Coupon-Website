---
import type { Category, CouponWithRelations, Store } from "../lib/types";

interface Props {
  mode: "create" | "edit";
  coupon?: CouponWithRelations;
  stores: Store[];
  categories: Category[];
}

const { mode, coupon, stores, categories } = Astro.props;
const defaultExpiry = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
---

<form
  id="coupon-admin-form"
  data-mode={mode}
  data-coupon-id={coupon?.id ?? ""}
  class="space-y-6 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs dark:border-slate-800 dark:bg-slate-900"
>
  <div
    id="form-alert"
    class="hidden rounded-xl border border-rose-200 bg-rose-50 p-3.5 text-sm font-semibold text-rose-700 dark:border-rose-800 dark:bg-rose-950/60 dark:text-rose-300"
  ></div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="sm:col-span-2">
      <label for="title" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Coupon Title *
      </label>
      <input
        id="title"
        name="title"
        type="text"
        required
        maxlength="140"
        value={coupon?.title ?? ""}
        placeholder="e.g., Flat 25% Off on Headphones & Audio"
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      />
    </div>

    <div>
      <label for="code" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Promo Code *
      </label>
      <input
        id="code"
        name="code"
        type="text"
        required
        maxlength="40"
        value={coupon?.code ?? ""}
        placeholder="e.g., SAVE25"
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 font-mono text-sm uppercase outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      />
    </div>

    <div>
      <label for="discount_text" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Discount Badge Text *
      </label>
      <input
        id="discount_text"
        name="discount_text"
        type="text"
        required
        maxlength="40"
        value={coupon?.discount_text ?? ""}
        placeholder="e.g., 25% OFF or ₹200 OFF"
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      />
    </div>

    <div>
      <label for="store_id" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Store *
      </label>
      <select
        id="store_id"
        name="store_id"
        required
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm outline-none focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="">Select Store</option>
        {stores.map((s) => (
          <option value={s.id} selected={coupon?.store_id === s.id}>
            {s.name}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label for="category_id" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Category *
      </label>
      <select
        id="category_id"
        name="category_id"
        required
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm outline-none focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-950"
      >
        <option value="">Select Category</option>
        {categories.map((c) => (
          <option value={c.id} selected={coupon?.category_id === c.id}>
            {c.icon} {c.name}
          </option>
        ))}
      </select>
    </div>

    <div>
      <label for="affiliate_or_store_url" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Store / Affiliate Link *
      </label>
      <input
        id="affiliate_or_store_url"
        name="affiliate_or_store_url"
        type="url"
        required
        value={coupon?.affiliate_or_store_url ?? ""}
        placeholder="https://www.amazon.in/..."
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      />
    </div>

    <div>
      <label for="expiry_date" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Expiry Date *
      </label>
      <input
        id="expiry_date"
        name="expiry_date"
        type="date"
        required
        value={coupon?.expiry_date?.slice(0, 10) ?? defaultExpiry}
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      />
    </div>

    <div class="sm:col-span-2">
      <label for="description" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Description
      </label>
      <textarea
        id="description"
        name="description"
        rows="3"
        maxlength="1000"
        placeholder="Briefly explain what products or orders this coupon applies to..."
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      >{coupon?.description ?? ""}</textarea>
    </div>

    <div class="sm:col-span-2">
      <label for="terms" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase dark:text-slate-300">
        Terms &amp; Conditions
      </label>
      <textarea
        id="terms"
        name="terms"
        rows="3"
        maxlength="1500"
        placeholder="e.g., Minimum order value Rs. 499. Valid once per account."
        class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950"
      >{coupon?.terms ?? ""}</textarea>
    </div>

    <div class="sm:col-span-2">
      <label class="inline-flex cursor-pointer items-center gap-2.5 text-sm font-semibold text-slate-700 dark:text-slate-200">
        <input
          type="checkbox"
          name="is_active"
          checked={coupon ? coupon.is_active === 1 : true}
          class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
        />
        <span>Active (immediately visible on public website)</span>
      </label>
    </div>
  </div>

  <div class="flex flex-wrap items-center justify-end gap-3 border-t border-slate-200 pt-5 dark:border-slate-800">
    <a
      href="/admin"
      class="rounded-xl border border-slate-300 px-5 py-2.5 text-sm font-semibold text-slate-700 hover:bg-slate-50 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
    >
      Cancel
    </a>
    <button
      type="submit"
      id="submit-coupon-btn"
      class="rounded-xl bg-indigo-600 px-6 py-2.5 text-sm font-bold text-white shadow-xs transition hover:bg-indigo-700 disabled:opacity-60"
    >
      {mode === "create" ? "Publish Coupon" : "Save Changes"}
    </button>
  </div>
</form>

<script>
  const form = document.getElementById("coupon-admin-form") as HTMLFormElement | null;
  const alertBox = document.getElementById("form-alert");
  const submitBtn = document.getElementById("submit-coupon-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    alertBox?.classList.add("hidden");

    const mode = form.dataset.mode;
    const id = form.dataset.couponId;
    const fd = new FormData(form);

    const payload = {
      title: String(fd.get("title") || ""),
      code: String(fd.get("code") || ""),
      discount_text: String(fd.get("discount_text") || ""),
      store_id: Number(fd.get("store_id")),
      category_id: Number(fd.get("category_id")),
      affiliate_or_store_url: String(fd.get("affiliate_or_store_url") || ""),
      expiry_date: String(fd.get("expiry_date") || ""),
      description: String(fd.get("description") || ""),
      terms: String(fd.get("terms") || ""),
      is_active: fd.get("is_active") === "on" ? 1 : 0,
    };

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = mode === "create" ? "Publishing..." : "Saving...";
    }

    try {
      const endpoint = mode === "create" ? "/api/admin/coupons" : `/api/admin/coupons/${id}`;
      const method = mode === "create" ? "POST" : "PUT";
      const res = await fetch(endpoint, {
        method,
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { ok?: boolean; error?: string };

      if (!res.ok || !data.ok) {
        if (alertBox) {
          alertBox.textContent = data.error || "Please check all fields and try again.";
          alertBox.classList.remove("hidden");
        }
        return;
      }

      window.location.href = "/admin";
    } catch {
      if (alertBox) {
        alertBox.textContent = "Network error while saving coupon.";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = mode === "create" ? "Publish Coupon" : "Save Changes";
      }
    }
  });
</script>
