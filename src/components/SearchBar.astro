---
interface Props {
  value?: string;
  placeholder?: string;
  action?: string;
  variant?: "hero" | "compact";
}

const {
  value = "",
  placeholder = "Search brand, code or deal (e.g. Amazon, 50% OFF, Nike)...",
  action = "/coupons",
  variant = "hero",
} = Astro.props;
---

<form
  action={action}
  method="GET"
  role="search"
  class:list={[
    "flex w-full flex-col gap-2 sm:flex-row transition-all",
    variant === "hero"
      ? "mx-auto max-w-2xl rounded-full bg-white p-2 shadow-xl shadow-slate-200/50 border-2 border-slate-200 focus-within:border-[#0499FA] focus-within:shadow-md"
      : "rounded-full border border-slate-200 bg-white p-1.5 focus-within:border-[#0499FA] focus-within:ring-2 focus-within:ring-[#0499FA]/20",
  ]}
>
  <label class="sr-only" for={`search-input-${variant}`}>Search coupons</label>
  <div class="relative flex flex-1 items-center">
    <svg
      class="pointer-events-none absolute left-4 h-5 w-5 text-slate-400"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id={`search-input-${variant}`}
      type="search"
      name="q"
      value={value}
      placeholder={placeholder}
      class="w-full rounded-full bg-transparent py-3 pr-4 pl-12 text-sm font-medium text-[#081126] placeholder-slate-400 outline-none sm:text-base"
    />
  </div>
  <button
    type="submit"
    class="inline-flex items-center justify-center gap-2 rounded-full bg-[#FF7A18] px-7 py-3 text-sm font-black text-white shadow-md shadow-[#FF7A18]/25 transition hover:bg-[#E6680C] active:scale-95"
  >
    <span>Find Deals</span>
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </button>
</form>
