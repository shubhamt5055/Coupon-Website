---
interface Props {
  value?: string;
  placeholder?: string;
  action?: string;
  variant?: "hero" | "compact";
}

const {
  value = "",
  placeholder = "Search for stores, categories, or discount codes (e.g. Swiggy, Amazon, 50% OFF)…",
  action = "/coupons",
  variant = "hero",
} = Astro.props;
---

<form
  action={action}
  method="GET"
  role="search"
  class:list={[
    "flex w-full flex-col gap-2 sm:flex-row transition-all",
    variant === "hero"
      ? "mx-auto max-w-2xl rounded-xl bg-white p-2 shadow-lg border border-slate-200/90 focus-within:border-[#2491ef] focus-within:ring-2 focus-within:ring-[#2491ef]/20"
      : "rounded-lg border border-slate-300 bg-white p-1 focus-within:border-[#2491ef] focus-within:ring-2 focus-within:ring-[#2491ef]/20",
  ]}
>
  <label class="sr-only" for={`search-input-${variant}`}>Search coupons</label>
  <div class="relative flex flex-1 items-center">
    <svg
      class="pointer-events-none absolute left-3.5 h-5 w-5 text-slate-400"
      fill="none"
      stroke="currentColor"
      stroke-width="2.2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id={`search-input-${variant}`}
      type="search"
      name="q"
      value={value}
      placeholder={placeholder}
      class="w-full rounded-lg bg-transparent py-2.5 pr-4 pl-11 text-xs font-medium text-slate-800 placeholder-slate-400 outline-none sm:text-sm"
    />
  </div>
  <button
    type="submit"
    class="inline-flex items-center justify-center gap-1.5 rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-bold text-white uppercase tracking-wider transition hover:bg-[#129fea] active:scale-95 shrink-0 shadow-2xs"
  >
    <span>Find Deals</span>
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
    </svg>
  </button>
</form>
