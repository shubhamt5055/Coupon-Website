---
interface Props {
  value?: string;
  placeholder?: string;
  action?: string;
  variant?: "hero" | "compact";
}

const {
  value = "",
  placeholder = "Search by store name, deal title, or code (e.g. Amazon, ZOMATO150)...",
  action = "/coupons",
  variant = "hero",
} = Astro.props;
---

<form
  action={action}
  method="GET"
  role="search"
  class:list={[
    "flex w-full flex-col gap-2.5 sm:flex-row",
    variant === "hero"
      ? "mx-auto max-w-2xl rounded-2xl bg-white p-2.5 shadow-xl shadow-indigo-950/20 dark:bg-slate-900 dark:ring-1 dark:ring-slate-700"
      : "rounded-xl border border-slate-200 bg-white p-2 dark:border-slate-800 dark:bg-slate-900",
  ]}
>
  <label class="sr-only" for={`search-input-${variant}`}>Search coupons</label>
  <div class="relative flex flex-1 items-center">
    <svg
      class="pointer-events-none absolute left-3.5 h-5 w-5 text-slate-400"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35m1.85-5.15a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
    <input
      id={`search-input-${variant}`}
      type="search"
      name="q"
      value={value}
      placeholder={placeholder}
      class="w-full rounded-xl bg-transparent py-3 pr-4 pl-11 text-sm text-slate-900 placeholder-slate-400 outline-none sm:text-base dark:text-white dark:placeholder-slate-500"
    />
  </div>
  <button
    type="submit"
    class="rounded-xl bg-orange-500 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-orange-600 focus:ring-2 focus:ring-orange-400 focus:outline-none sm:text-base"
  >
    Search Deals
  </button>
</form>
