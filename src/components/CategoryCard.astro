---
import type { Category } from "../lib/types";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const count = category.active_coupon_count ?? 0;
---

<a
  href={`/categories/${category.slug}`}
  class="group flex flex-col items-center rounded-3xl border border-slate-200/80 bg-white p-5 text-center shadow-2xs transition-all duration-200 hover:-translate-y-1 hover:border-emerald-400 hover:shadow-lg hover:shadow-emerald-950/5"
>
  <div class="mb-3 flex h-14 w-14 items-center justify-center rounded-2xl bg-emerald-50/70 text-2xl transition duration-200 group-hover:scale-110 group-hover:bg-emerald-100">
    {category.icon || "🏷️"}
  </div>
  <h3 class="text-sm font-extrabold text-slate-900 group-hover:text-emerald-700 transition sm:text-base">
    {category.name}
  </h3>
  <span class="mt-1.5 inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-slate-500 group-hover:bg-emerald-50 group-hover:text-emerald-800 transition">
    {count} {count === 1 ? "deal" : "deals"}
  </span>
</a>
