---
import type { Category } from "../lib/types";

interface Props {
  category: Category;
  compact?: boolean;
}

const { category } = Astro.props;
const count = category.active_coupon_count ?? 0;
---

<a
  href={`/categories/${category.slug}`}
  class="group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-5 shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:border-[#10B981] hover:shadow-xl hover:shadow-[#064E3B]/10"
>
  <!-- Background Ambient Tint on Hover -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-[#ECFDF5] to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center text-center">
    <!-- Icon Container with 3D Lift -->
    <div class="mb-3.5 flex h-14 w-14 items-center justify-center rounded-2xl bg-[#ECFDF5] text-2xl text-[#064E3B] border border-[#10B981]/30 shadow-xs transition-all duration-300 group-hover:scale-110 group-hover:bg-[#064E3B] group-hover:text-[#ECFDF5] group-hover:shadow-md">
      <span class="transition-transform duration-300 group-hover:rotate-6">
        {category.icon || "🏷️"}
      </span>
    </div>

    <!-- Category Title -->
    <h3 class="text-sm font-black tracking-tight text-slate-900 transition-colors group-hover:text-[#064E3B] sm:text-base">
      {category.name}
    </h3>

    <!-- Deal Count Badge with Live Indicator -->
    <div class="mt-2.5 flex items-center gap-1.5">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[#10B981]/30 bg-[#ECFDF5] px-2.5 py-0.5 text-[11px] font-black text-[#064E3B] transition-all group-hover:border-[#10B981]">
        <span class="h-1.5 w-1.5 rounded-full bg-[#10B981] animate-soft-pulse"></span>
        <span>{count} {count === 1 ? "Deal" : "Deals"}</span>
      </span>
    </div>
  </div>

  <!-- Bottom CTA Pill -->
  <div class="relative z-10 mt-3.5 flex items-center justify-center gap-1 text-[11px] font-extrabold text-slate-400 opacity-60 transition-all duration-200 group-hover:opacity-100 group-hover:text-[#064E3B]">
    <span>Browse Deals</span>
    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
  </div>
</a>
