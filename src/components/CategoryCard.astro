---
import type { Category } from "../lib/types";
import { getCategoryTheme } from "../lib/format";

interface Props {
  category: Category;
  compact?: boolean;
}

const { category } = Astro.props;
const count = category.active_coupon_count ?? 0;
const theme = getCategoryTheme(category.slug || category.name);
---

<a
  href={`/categories/${category.slug}`}
  class:list={[
    "group relative flex flex-col justify-between overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-5 shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:shadow-xl",
    theme.hoverBorder,
  ]}
>
  <!-- Background Ambient Tint on Hover -->
  <div
    class:list={[
      "pointer-events-none absolute inset-0 bg-gradient-to-b opacity-0 transition-opacity duration-300 group-hover:opacity-100",
      theme.bgGradient,
    ]}
  ></div>

  <!-- Content -->
  <div class="relative z-10 flex flex-col items-center text-center">
    <!-- Icon Container with Glow & 3D Lift -->
    <div
      class:list={[
        "mb-3.5 flex h-14 w-14 items-center justify-center rounded-2xl text-2xl shadow-xs transition-all duration-300 group-hover:scale-110 group-hover:shadow-md",
        theme.iconBg,
      ]}
    >
      <span class="transition-transform duration-300 group-hover:rotate-6">
        {category.icon || "🏷️"}
      </span>
    </div>

    <!-- Category Title -->
    <h3
      class:list={[
        "text-sm font-black tracking-tight text-slate-900 transition-colors sm:text-base",
        theme.textColor,
      ]}
    >
      {category.name}
    </h3>

    <!-- Deal Count Badge with Live Indicator -->
    <div class="mt-2.5 flex items-center gap-1.5">
      <span
        class:list={[
          "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[11px] font-black transition-all",
          theme.badgeBg,
        ]}
      >
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-soft-pulse"></span>
        <span>{count} {count === 1 ? "Deal" : "Deals"}</span>
      </span>
    </div>
  </div>

  <!-- Bottom CTA Pill (Slides in on hover) -->
  <div class="relative z-10 mt-3.5 flex items-center justify-center gap-1 text-[11px] font-extrabold text-slate-400 opacity-60 transition-all duration-200 group-hover:opacity-100 group-hover:text-slate-900">
    <span>Browse Deals</span>
    <span class="transition-transform duration-200 group-hover:translate-x-1">→</span>
  </div>
</a>
