---
import type { Category } from "../lib/types";

interface Props {
  category: Category;
}

const { category } = Astro.props;
const count = category.active_coupon_count ?? 0;
---

<a
  href={`/categories/${category.slug}`}
  class="group relative flex flex-col items-center justify-between overflow-hidden rounded-xl border border-slate-200 bg-white p-5 text-center shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:border-[#2491ef] hover:shadow-lg"
>
  <!-- Category Icon Container (GrabOn Style Circular / Rounded Box) -->
  <div class="relative flex h-14 w-14 items-center justify-center rounded-2xl bg-[#eef5ff] text-2xl text-[#2491ef] shadow-2xs transition-transform duration-300 group-hover:scale-110">
    <span>{category.icon || "🏷️"}</span>
  </div>

  <!-- Category Name -->
  <div class="mt-3.5">
    <h3 class="text-sm font-bold text-[#191f2e] transition-colors group-hover:text-[#2491ef]">
      {category.name}
    </h3>

    <!-- Count Pill -->
    <span class="mt-1.5 inline-block rounded-full bg-slate-100 px-2.5 py-0.5 text-[11px] font-bold text-slate-600 transition-colors group-hover:bg-[#eef5ff] group-hover:text-[#2491ef]">
      {count} {count === 1 ? "Offer Live" : "Offers Live"}
    </span>
  </div>

  <!-- Hover Action -->
  <span class="mt-3 flex items-center gap-1 text-[11px] font-bold text-[#2491ef] opacity-0 transition-opacity duration-200 group-hover:opacity-100">
    <span>Browse Deals</span>
    <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
    </svg>
  </span>
</a>
