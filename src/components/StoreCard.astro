---
import type { Store } from "../lib/types";
import StoreLogo from "./StoreLogo.astro";

interface Props {
  store: Store;
}

const { store } = Astro.props;
const count = store.active_coupon_count ?? 0;
---

<a
  href={`/stores/${store.slug}`}
  class="group relative flex flex-col justify-between overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-5 shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:border-[#0499FA] hover:shadow-xl hover:shadow-[#0499FA]/10"
>
  <!-- Ambient Brand Tint on Hover -->
  <div class="pointer-events-none absolute inset-0 bg-gradient-to-br from-[#EAF6FE]/60 via-transparent to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>

  <div class="relative z-10">
    <!-- Top Row: Logo & Live Deals Pill -->
    <div class="flex items-start justify-between gap-3">
      <div class="h-14 w-14 shrink-0 rounded-2xl border border-slate-100 bg-white p-2 shadow-xs transition-transform duration-300 group-hover:scale-105 flex items-center justify-center overflow-hidden">
        <StoreLogo store={store} size="md" />
      </div>

      <!-- Live Count Pill -->
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[#0499FA]/20 bg-[#EAF6FE] px-2.5 py-1 text-[11px] font-black text-[#0499FA] shadow-2xs transition-all">
        <span class="h-1.5 w-1.5 rounded-full bg-[#0499FA] animate-soft-pulse"></span>
        <span>{count} {count === 1 ? "Offer" : "Offers"}</span>
      </span>
    </div>

    <!-- Store Name & Tagline -->
    <div class="mt-4">
      <h3 class="truncate text-base font-black tracking-tight text-[#081126] transition-colors group-hover:text-[#0499FA]">
        {store.name}
      </h3>
      <p class="mt-1 line-clamp-2 text-xs font-medium leading-relaxed text-slate-500">
        {store.description || "Verified Online Coupons & Promo Codes"}
      </p>
    </div>
  </div>

  <!-- Bottom CTA Row -->
  <div class="relative z-10 mt-5 flex items-center justify-between border-t border-slate-100 pt-3.5 text-xs font-bold text-slate-500">
    <span class="flex items-center gap-1 text-[11px] font-bold text-emerald-600">
      <svg class="h-3.5 w-3.5 text-emerald-500" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
      </svg>
      <span>Verified Store</span>
    </span>
    <span class="inline-flex items-center gap-1 font-extrabold text-[#0499FA] transition-all group-hover:translate-x-1 group-hover:text-[#FF7A18]">
      <span>View Deals</span>
      <span>→</span>
    </span>
  </div>
</a>
