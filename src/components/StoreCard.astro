---
import type { Store } from "../lib/types";
import { getStoreColorClass, getStoreInitials, safeImageUrl } from "../lib/format";

interface Props {
  store: Store;
}

const { store } = Astro.props;
const logo = safeImageUrl(store.logo_url);
const count = store.active_coupon_count ?? 0;
const colorClass = getStoreColorClass(store.name);
const initials = getStoreInitials(store.name);
---

<a
  href={`/stores/${store.slug}`}
  class="group flex items-start gap-4 rounded-2xl border border-slate-200/80 bg-white p-5 shadow-xs transition duration-200 hover:-translate-y-1 hover:border-indigo-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-indigo-500/60"
>
  {logo ? (
    <img
      src={logo}
      alt={`${store.name} logo`}
      loading="lazy"
      class="h-12 w-12 shrink-0 rounded-xl border border-slate-200 bg-white object-contain p-1 dark:border-slate-700"
    />
  ) : (
    <div
      class:list={[
        "flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-sm font-extrabold text-white shadow-xs",
        colorClass,
      ]}
    >
      {initials}
    </div>
  )}

  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <h3 class="truncate text-base font-bold text-slate-900 group-hover:text-indigo-600 dark:text-white dark:group-hover:text-indigo-400">
        {store.name}
      </h3>
      <span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-0.5 text-xs font-semibold text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300">
        {count} {count === 1 ? "coupon" : "coupons"}
      </span>
    </div>
    {store.description && (
      <p class="mt-1.5 line-clamp-2 text-xs leading-relaxed text-slate-600 dark:text-slate-400">
        {store.description}
      </p>
    )}
  </div>
</a>
