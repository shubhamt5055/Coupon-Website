---
import type { Store } from "../lib/types";
import StoreLogo from "./StoreLogo.astro";

interface Props {
  store: Store;
}

const { store } = Astro.props;
const count = store.active_coupon_count ?? 0;
---

<a
  href={`/stores/${store.slug}`}
  class="group relative flex flex-col justify-between overflow-hidden rounded-xl border border-slate-200 bg-white p-5 shadow-2xs transition-all duration-300 hover:-translate-y-1 hover:border-[#2491ef] hover:shadow-lg"
>
  <div class="relative z-10">
    <!-- Top Row: Logo & Live Deals Pill -->
    <div class="flex items-start justify-between gap-3">
      <div class="h-14 w-14 shrink-0 rounded-xl border border-slate-200 bg-white p-2 shadow-2xs transition-transform duration-300 group-hover:scale-105 flex items-center justify-center overflow-hidden">
        <StoreLogo store={store} size="md" />
      </div>

      <!-- Live Count Pill (GrabOn Style) -->
      <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2491ef]/20 bg-[#eef5ff] px-2.5 py-1 text-[11px] font-bold text-[#2491ef] shadow-2xs">
        <span class="h-1.5 w-1.5 rounded-full bg-[#60a600] animate-soft-pulse"></span>
        <span>
          {count} {count === 1 ? "Offer" : "Offers"}
        </span>
      </span>
    </div>

    <!-- Store Name & Tagline -->
    <div class="mt-4">
      <h3 class="truncate text-base font-bold tracking-tight text-[#191f2e] transition-colors group-hover:text-[#2491ef]">
        {store.name}
      </h3>
      <p class="mt-1 line-clamp-2 text-xs font-medium leading-relaxed text-slate-500">
        {store.description || "Verified Online Coupons & Promo Codes"}
      </p>
    </div>
  </div>

  <!-- Bottom CTA Row -->
  <div class="relative z-10 mt-5 flex items-center justify-between border-t border-slate-100 pt-3 text-xs font-semibold text-slate-500">
    <span class="flex items-center gap-1 text-[11px] font-bold text-[#60a600]">
      <svg
        class="h-3.5 w-3.5"
        viewBox="0 0 20 20"
        fill="currentColor"
      >
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd"
        />
      </svg>
      <span>Verified Partner</span>
    </span>

    <span class="flex items-center gap-1 text-[#2491ef] font-bold transition-transform group-hover:translate-x-1">
      <span>View Offers</span>
      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </span>
  </div>
</a>
