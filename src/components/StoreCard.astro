---
import type { Store } from "../lib/types";
import { getStoreColorClass, getStoreInitials, safeImageUrl } from "../lib/format";

interface Props {
  store: Store;
}

const { store } = Astro.props;
const logo = safeImageUrl(store.logo_url);
const count = store.active_coupon_count ?? 0;
const colorClass = getStoreColorClass(store.name);
const initials = getStoreInitials(store.name);
---

<a
  href={`/stores/${store.slug}`}
  class="group flex items-start gap-4 rounded-3xl border border-slate-200/80 bg-white p-5 shadow-2xs transition-all duration-200 hover:-translate-y-1 hover:border-emerald-400 hover:shadow-lg hover:shadow-emerald-950/5"
>
  {logo ? (
    <img
      src={logo}
      alt={`${store.name} logo`}
      loading="lazy"
      class="h-12 w-12 shrink-0 rounded-2xl border border-slate-200 bg-white object-contain p-1.5 shadow-xs transition group-hover:scale-105"
    />
  ) : (
    <div
      class:list={[
        "flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-sm font-black text-white shadow-xs transition group-hover:scale-105",
        colorClass,
      ]}
    >
      {initials}
    </div>
  )}

  <div class="min-w-0 flex-1">
    <div class="flex items-center justify-between gap-2">
      <h3 class="truncate text-base font-extrabold text-slate-900 group-hover:text-emerald-700 transition">
        {store.name}
      </h3>
      <span class="shrink-0 rounded-full bg-emerald-50 px-2.5 py-0.5 text-[11px] font-black text-emerald-800 ring-1 ring-emerald-600/20">
        {count} {count === 1 ? "deal" : "deals"}
      </span>
    </div>
    {store.description && (
      <p class="mt-1 line-clamp-2 text-xs leading-relaxed text-slate-500">
        {store.description}
      </p>
    )}
  </div>
</a>
