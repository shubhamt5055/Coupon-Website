---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[#9333EA]/30 bg-[#581C87] text-purple-100">
  <!-- Top Deal Alert / Savings Banner -->
  <div class="border-b border-[#9333EA]/20 bg-[#3B0764] py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-[#EC4899]/20 px-3 py-1 text-xs font-black text-[#FACC15] border border-[#EC4899]/40 shadow-xs">
            <span>⚡ Instant Deal Alerts</span>
          </div>
          <h3 class="mt-2 text-lg font-black tracking-tight text-white sm:text-xl">
            Never miss a working promo code again
          </h3>
          <p class="mt-1 text-xs text-purple-200/80">
            Join 12,000+ smart shoppers who save an average of ₹450 per checkout with CouponHub.
          </p>
        </div>

        <form class="flex w-full max-w-md items-center gap-2 sm:w-auto" onsubmit="event.preventDefault(); alert('Subscribed to deal alerts!');">
          <input
            type="email"
            required
            placeholder="Enter your email address..."
            class="w-full min-w-0 rounded-xl border border-[#9333EA]/50 bg-[#260647] px-4 py-2.5 text-xs font-medium text-white placeholder-purple-300/60 outline-none transition focus:border-[#EC4899] focus:bg-[#1E0438] focus:ring-2 focus:ring-[#EC4899]/30 sm:w-72"
          />
          <button
            type="submit"
            class="shrink-0 rounded-xl bg-gradient-to-r from-[#FACC15] to-[#EC4899] px-5 py-2.5 text-xs font-black text-[#581C87] transition hover:opacity-95 active:scale-95 shadow-md shadow-[#EC4899]/20"
          >
            Get Deals
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Main Links Grid -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2">
        <a href="/" class="group inline-flex items-center gap-3 text-white">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-tr from-[#9333EA] to-[#EC4899] text-white shadow-md shadow-[#EC4899]/30 transition group-hover:scale-105">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-white">
              Coupon<span class="text-[#FACC15]">Hub</span>
            </span>
            <span class="text-[10px] font-bold tracking-wider text-[#38BDF8] uppercase">
              100% Hand-Verified Savings
            </span>
          </div>
        </a>

        <p class="mt-4 max-w-sm text-xs leading-relaxed text-purple-200/80">
          CouponHub is India's community-driven verified coupons platform. We test promo codes across top online stores every morning so you always get maximum savings.
        </p>

        <!-- Trust Badges -->
        <div class="mt-6 flex flex-wrap items-center gap-2 text-[11px] font-bold">
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-[#9333EA]/40 bg-[#3B0764] px-2.5 py-1 text-purple-200">
            <span>🛡️</span> 100% Free Forever
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-[#14B8A6]/40 bg-[#3B0764] px-2.5 py-1 text-[#14B8A6]">
            <span>⚡</span> Direct Store Links
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-[#FACC15]/40 bg-[#3B0764] px-2.5 py-1 text-[#FACC15]">
            <span>🔒</span> Zero Ad Spam
          </span>
        </div>
      </div>

      <!-- Column 2: Top Stores -->
      <div>
        <h4 class="text-xs font-black tracking-wider text-[#FACC15] uppercase">
          Top Stores
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs font-semibold text-purple-200/80">
          <li><a href="/stores/amazon" class="hover:text-[#FACC15] transition">Amazon Coupons</a></li>
          <li><a href="/stores/swiggy" class="hover:text-[#FACC15] transition">Swiggy Promo Codes</a></li>
          <li><a href="/stores/myntra" class="hover:text-[#FACC15] transition">Myntra Fashion Deals</a></li>
          <li><a href="/stores/zomato" class="hover:text-[#FACC15] transition">Zomato Food Offers</a></li>
          <li><a href="/stores/flipkart" class="hover:text-[#FACC15] transition">Flipkart Offers</a></li>
          <li><a href="/stores" class="text-[#38BDF8] font-bold hover:underline">View All Stores →</a></li>
        </ul>
      </div>

      <!-- Column 3: Categories -->
      <div>
        <h4 class="text-xs font-black tracking-wider text-[#EC4899] uppercase">
          Browse Deals
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs font-semibold text-purple-200/80">
          <li><a href="/categories/food" class="hover:text-[#EC4899] transition">🍔 Food &amp; Dining</a></li>
          <li><a href="/categories/fashion" class="hover:text-[#EC4899] transition">👗 Fashion &amp; Apparel</a></li>
          <li><a href="/categories/electronics" class="hover:text-[#EC4899] transition">📱 Electronics &amp; Tech</a></li>
          <li><a href="/categories/travel" class="hover:text-[#EC4899] transition">✈️ Travel &amp; Hotels</a></li>
          <li><a href="/coupons?sort=popular" class="hover:text-[#EC4899] transition">🔥 Trending Today</a></li>
          <li><a href="/categories" class="text-[#38BDF8] font-bold hover:underline">All Categories →</a></li>
        </ul>
      </div>

      <!-- Column 4: Community & Tools -->
      <div>
        <h4 class="text-xs font-black tracking-wider text-[#14B8A6] uppercase">
          Community &amp; Portals
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs font-semibold text-purple-200/80">
          <li><a href="/login" class="hover:text-[#14B8A6] transition">Sign In / Register</a></li>
          <li><a href="/my-coupons" class="hover:text-[#14B8A6] transition">My Submitted Coupons</a></li>
          <li><a href="/submit-coupon" class="hover:text-[#14B8A6] transition">Share a Working Deal</a></li>
          <li><a href="/coupons?includeExpired=1" class="hover:text-[#14B8A6] transition">Expired Archive</a></li>
          <li><a href="/admin" class="hover:text-[#14B8A6] transition">Admin Portal</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-[#9333EA]/20 pt-8 text-xs font-medium text-purple-200/60 sm:flex-row">
      <p>© {year} CouponHub. Handcrafted for smart online savings.</p>
      <div class="flex items-center gap-4 text-purple-200/80">
        <span>Built with Astro SSR &amp; Cloudflare D1</span>
        <span>•</span>
        <a href="/admin" class="font-bold text-[#FACC15] hover:text-white transition">Admin Portal</a>
      </div>
    </div>
  </div>
</footer>
