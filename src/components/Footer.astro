---
const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-slate-900 bg-slate-950 text-slate-300">
  <!-- Top Deal Alert / Savings Banner -->
  <div class="border-b border-slate-800/80 bg-slate-900/60 py-8">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-black text-emerald-400 ring-1 ring-emerald-500/20">
            <span>⚡ Instant Deal Alerts</span>
          </div>
          <h3 class="mt-2 text-lg font-black tracking-tight text-white sm:text-xl">
            Never miss a working promo code again
          </h3>
          <p class="mt-1 text-xs text-slate-400">
            Join 12,000+ shoppers who save an average of ₹450 per checkout with CouponHub.
          </p>
        </div>

        <form class="flex w-full max-w-md items-center gap-2 sm:w-auto" onsubmit="event.preventDefault(); alert('Subscribed to deal alerts!');">
          <input
            type="email"
            required
            placeholder="Enter your email address..."
            class="w-full min-w-0 rounded-xl border border-slate-700 bg-slate-800/80 px-4 py-2.5 text-xs font-medium text-white placeholder-slate-500 outline-none transition focus:border-emerald-500 focus:bg-slate-900 sm:w-72"
          />
          <button
            type="submit"
            class="shrink-0 rounded-xl bg-emerald-500 px-5 py-2.5 text-xs font-black text-slate-950 transition hover:bg-emerald-400 active:scale-95"
          >
            Get Deals
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Main Links Grid -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-5">
      <!-- Brand & Mission Column -->
      <div class="lg:col-span-2">
        <a href="/" class="group inline-flex items-center gap-3 text-white">
          <div class="flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-slate-950 shadow-md shadow-emerald-500/20 transition group-hover:scale-105">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
              <line x1="7" y1="7" x2="7.01" y2="7"/>
            </svg>
          </div>
          <div class="flex flex-col">
            <span class="text-xl font-black tracking-tight text-white">
              Coupon<span class="text-emerald-400">Hub</span>
            </span>
            <span class="text-[10px] font-bold tracking-wider text-emerald-400 uppercase">
              100% Hand-Verified Savings
            </span>
          </div>
        </a>

        <p class="mt-4 max-w-sm text-xs leading-relaxed text-slate-400">
          CouponHub is India's leading community-powered savings platform. We hand-test coupon codes and promo deals across 15+ top online stores every morning.
        </p>

        <!-- Trust Badges -->
        <div class="mt-6 flex flex-wrap items-center gap-2 text-[11px] font-bold text-slate-300">
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-900/80 px-2.5 py-1 text-slate-300">
            <span>🛡️</span> 100% Free Forever
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-900/80 px-2.5 py-1 text-slate-300">
            <span>⚡</span> Direct Store Links
          </span>
          <span class="inline-flex items-center gap-1.5 rounded-lg border border-slate-800 bg-slate-900/80 px-2.5 py-1 text-slate-300">
            <span>🔒</span> Zero Ad Spam
          </span>
        </div>
      </div>

      <!-- Column 2: Top Stores -->
      <div>
        <h4 class="text-xs font-black tracking-wider text-white uppercase">
          Top Stores
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs font-semibold text-slate-400">
          <li><a href="/stores/amazon" class="hover:text-emerald-400 transition">Amazon Coupons</a></li>
          <li><a href="/stores/swiggy" class="hover:text-emerald-400 transition">Swiggy Promo Codes</a></li>
          <li><a href="/stores/myntra" class="hover:text-emerald-400 transition">Myntra Fashion Deals</a></li>
          <li><a href="/stores/zomato" class="hover:text-emerald-400 transition">Zomato Food Offers</a></li>
          <li><a href="/stores/nike" class="hover:text-emerald-400 transition">Nike Sportswear</a></li>
          <li><a href="/stores" class="text-emerald-400 hover:underline">View All 15+ Stores →</a></li>
        </ul>
      </div>

      <!-- Column 3: Categories -->
      <div>
        <h4 class="text-xs font-black tracking-wider text-white uppercase">
          Browse Deals
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs font-semibold text-slate-400">
          <li><a href="/categories/food-dining" class="hover:text-emerald-400 transition">🍕 Food &amp; Dining</a></li>
          <li><a href="/categories/fashion-apparel" class="hover:text-emerald-400 transition">👗 Fashion &amp; Apparel</a></li>
          <li><a href="/categories/electronics" class="hover:text-emerald-400 transition">💻 Electronics &amp; Tech</a></li>
          <li><a href="/categories/travel-hotels" class="hover:text-emerald-400 transition">✈️ Travel &amp; Hotels</a></li>
          <li><a href="/coupons?sort=popular" class="hover:text-emerald-400 transition">🔥 Trending Today</a></li>
          <li><a href="/coupons" class="text-emerald-400 hover:underline">All Categories →</a></li>
        </ul>
      </div>

      <!-- Column 4: Community & Tools -->
      <div>
        <h4 class="text-xs font-black tracking-wider text-white uppercase">
          Community &amp; Portals
        </h4>
        <ul class="mt-4 space-y-2.5 text-xs font-semibold text-slate-400">
          <li><a href="/login" class="hover:text-emerald-400 transition">Sign In / Register</a></li>
          <li><a href="/my-coupons" class="hover:text-emerald-400 transition">My Submitted Coupons</a></li>
          <li><a href="/submit-coupon" class="hover:text-emerald-400 transition">Share a Working Deal</a></li>
          <li><a href="/coupons?includeExpired=1" class="hover:text-emerald-400 transition">Expired Archive</a></li>
          <li><a href="/admin" class="hover:text-emerald-400 transition">Admin Portal</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-800/80 pt-8 text-xs font-medium text-slate-500 sm:flex-row">
      <p>© {year} CouponHub. Handcrafted for smart online shoppers.</p>
      <div class="flex items-center gap-4 text-slate-400">
        <span>Built with Astro SSR &amp; Cloudflare D1</span>
        <span>•</span>
        <a href="#top" class="hover:text-emerald-400">Back to Top ↑</a>
      </div>
    </div>
  </div>
</footer>
