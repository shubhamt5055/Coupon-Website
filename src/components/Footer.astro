---
const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      <div class="sm:col-span-2">
        <a href="/" class="inline-flex items-center gap-2 text-lg font-extrabold text-slate-900 dark:text-white">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-indigo-600 text-sm text-white">%</span>
          <span>Coupon<span class="text-indigo-600 dark:text-indigo-400">Hub</span></span>
        </a>
        <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-600 dark:text-slate-400">
          Verified promo codes, instant store discounts, and daily trending deals — powered by Astro &amp; Cloudflare D1 for lightning-fast savings on mobile and desktop.
        </p>
      </div>

      <div>
        <h3 class="text-xs font-bold tracking-wider text-slate-900 uppercase dark:text-slate-200">
          Explore
        </h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/" class="hover:text-indigo-600 dark:hover:text-indigo-400">Home</a></li>
          <li><a href="/coupons" class="hover:text-indigo-600 dark:hover:text-indigo-400">All Coupons</a></li>
          <li><a href="/categories" class="hover:text-indigo-600 dark:hover:text-indigo-400">Categories</a></li>
          <li><a href="/stores" class="hover:text-indigo-600 dark:hover:text-indigo-400">Stores</a></li>
        </ul>
      </div>

      <div>
        <h3 class="text-xs font-bold tracking-wider text-slate-900 uppercase dark:text-slate-200">
          Management
        </h3>
        <ul class="mt-3 space-y-2 text-sm text-slate-600 dark:text-slate-400">
          <li><a href="/admin" class="hover:text-indigo-600 dark:hover:text-indigo-400">Admin Dashboard</a></li>
          <li><a href="/admin/coupons/new" class="hover:text-indigo-600 dark:hover:text-indigo-400">Submit a Coupon</a></li>
          <li><a href="/coupons?includeExpired=1" class="hover:text-indigo-600 dark:hover:text-indigo-400">Expired Archive</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col items-center justify-between gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 sm:flex-row dark:border-slate-800 dark:text-slate-400">
      <p>© {year} CouponHub. All rights reserved.</p>
      <p>Built with Astro SSR, Tailwind CSS &amp; Cloudflare D1</p>
    </div>
  </div>
</footer>
