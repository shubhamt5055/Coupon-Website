---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const user = Astro.locals.user;

const navLinks = [
  { href: "/", label: "Home" },
  { href: "/coupons", label: "Browse Coupons" },
  { href: "/stores", label: "Top Stores" },
  { href: "/categories", label: "Categories" },
  { href: "/submit-coupon", label: "+ Submit Coupon" },
];

function isActive(href: string): boolean {
  if (href === "/") return currentPath === "/";
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="sticky top-0 z-40 bg-white shadow-xs">
  <!-- Tier 1: Couponly Top Announcement Bar -->
  <div class="border-b border-orange-100 bg-[#FFEDE1] py-2 text-xs font-medium text-[#081126]">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-[#FF7A18] px-2 py-0.5 text-[10px] font-black text-white uppercase tracking-wider">
          Deal Alert
        </span>
        <span class="truncate">Save up to 70% with verified discount coupons and promo codes today!</span>
      </div>
      <div class="hidden items-center gap-4 text-xs font-semibold sm:flex">
        <span class="inline-flex items-center gap-1.5 text-slate-600">
          <span class="h-2 w-2 rounded-full bg-[#0499FA] animate-soft-pulse"></span>
          100% Free &amp; Verified
        </span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600 font-bold">🇮🇳 India (INR ₹)</span>
      </div>
    </div>
  </div>

  <!-- Tier 2: Main Search & User Bar (White) -->
  <div class="border-b border-slate-100 bg-white py-3.5">
    <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8">
      <!-- Brand Logo (Couponly Double Ring Style) -->
      <a href="/" class="group flex items-center gap-2.5 text-slate-900 transition hover:opacity-95 shrink-0">
        <div class="relative flex h-10 w-10 items-center justify-center rounded-2xl bg-gradient-to-tr from-[#0499FA] to-[#36ADFB] text-white shadow-md shadow-[#0499FA]/20 group-hover:scale-105 transition-transform">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/>
            <line x1="7" y1="7" x2="7.01" y2="7"/>
          </svg>
          <span class="absolute -bottom-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-[#FF7A18] ring-2 ring-white">
            <span class="h-1.5 w-1.5 rounded-full bg-white"></span>
          </span>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-black tracking-tight text-[#081126]">
            Coupon<span class="text-[#0499FA]">Hub</span>
          </span>
          <span class="text-[10px] font-bold tracking-wider text-slate-400 uppercase -mt-0.5">
            Verified Deals Hub
          </span>
        </div>
      </a>

      <!-- Middle: Categories Quick Button + Pill Search Bar -->
      <div class="hidden flex-1 items-center justify-center gap-3 md:flex max-w-2xl">
        <a
          href="/categories"
          class="inline-flex items-center gap-2 rounded-full bg-[#EAF6FE] px-4 py-2.5 text-xs font-black text-[#0499FA] transition hover:bg-[#CDEBFE] shrink-0"
        >
          <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
            <rect x="3" y="3" width="7" height="7" rx="1.5" />
            <rect x="14" y="3" width="7" height="7" rx="1.5" />
            <rect x="3" y="14" width="7" height="7" rx="1.5" />
            <rect x="14" y="14" width="7" height="7" rx="1.5" />
          </svg>
          <span>Categories</span>
        </a>

        <!-- Couponly Pill Search Bar with Orange Circle Action Button -->
        <form
          action="/coupons"
          method="GET"
          class="flex flex-1 items-center rounded-full border border-slate-200 bg-white p-1 shadow-2xs transition focus-within:border-[#0499FA] focus-within:ring-2 focus-within:ring-[#0499FA]/20"
        >
          <input
            type="search"
            name="q"
            placeholder="Search stores, coupons or deals (e.g. Amazon, Zomato)..."
            class="w-full bg-transparent px-4 py-1.5 text-xs font-medium text-slate-800 placeholder-slate-400 outline-none"
          />
          <button
            type="submit"
            aria-label="Search Coupons"
            class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#FF7A18] text-white transition hover:bg-[#E6680C] active:scale-95 shadow-xs"
          >
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </form>
      </div>

      <!-- Right User Controls -->
      <div class="flex items-center gap-2.5">
        {user ? (
          <div class="flex items-center gap-2">
            <a
              href="/my-coupons"
              class:list={[
                "flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-xs font-bold transition shadow-2xs",
                isActive("/my-coupons")
                  ? "border-[#0499FA] bg-[#EAF6FE] text-[#0499FA]"
                  : "border-slate-200 bg-white text-slate-700 hover:border-[#0499FA] hover:bg-[#EAF6FE]/60",
              ]}
              title="My Submitted Coupons"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-gradient-to-tr from-[#0499FA] to-[#36ADFB] text-[11px] font-black text-white shadow-2xs">
                {user.name.charAt(0).toUpperCase()}
              </span>
              <span class="max-w-[100px] truncate">{user.name}</span>
            </a>

            <!-- Single Universal Logout Button -->
            <button
              type="button"
              id="navbar-logout-btn"
              class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-600 transition hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600 shadow-2xs cursor-pointer"
              title="Log Out"
            >
              <svg class="h-3.5 w-3.5 text-rose-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
              </svg>
              <span class="hidden sm:inline">Log Out</span>
            </button>
          </div>
        ) : (
          <div class="flex items-center gap-2">
            <a
              href="/login"
              class="px-3 py-1.5 text-xs font-bold text-[#081126] transition hover:text-[#0499FA]"
            >
              Sign In
            </a>
            <a
              href="/login?mode=register"
              class="inline-flex items-center gap-1.5 rounded-full bg-[#0499FA] px-4.5 py-2 text-xs font-black text-white shadow-md shadow-[#0499FA]/20 transition hover:bg-[#0377c4] active:scale-95"
            >
              <span>Sign Up</span>
              <span class="text-xs">→</span>
            </a>
          </div>
        )}

        <!-- Mobile Menu Toggle -->
        <button
          type="button"
          id="mobile-menu-toggle"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          class="flex h-9 w-9 items-center justify-center rounded-xl border border-slate-200 bg-white text-slate-700 shadow-2xs md:hidden"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Tier 3: Couponly Midnight Navy Navigation Bar (#0A1633) -->
  <nav class="hidden bg-[#0A1633] text-white md:block shadow-md" aria-label="Main Navigation">
    <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-2 sm:px-6 lg:px-8">
      <div class="flex items-center gap-1">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-full px-4 py-1.5 text-xs font-bold transition",
              isActive(link.href)
                ? "bg-[#0499FA] text-white shadow-xs font-black"
                : "text-slate-200 hover:bg-white/10 hover:text-white",
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>

      <div class="flex items-center gap-3">
        <a
          href="/admin"
          class="rounded-full bg-white/10 px-3.5 py-1 text-xs font-bold text-slate-300 transition hover:bg-white/20 hover:text-white"
        >
          🛡️ Admin Portal
        </a>
      </div>
    </div>
  </nav>

  <!-- Mobile Drawer -->
  <div
    id="mobile-menu"
    class="hidden border-t border-slate-200 bg-white px-4 py-4 md:hidden shadow-lg"
  >
    <!-- Mobile Search Form -->
    <form action="/coupons" method="GET" class="mb-3 flex items-center rounded-full border border-slate-200 bg-white p-1">
      <input
        type="search"
        name="q"
        placeholder="Search deals..."
        class="w-full bg-transparent px-3 py-1 text-xs text-slate-800 outline-none"
      />
      <button type="submit" class="flex h-7 w-7 items-center justify-center rounded-full bg-[#FF7A18] text-white">
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </button>
    </form>

    <div class="flex flex-col gap-1.5">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class:list={[
            "rounded-xl px-3.5 py-2.5 text-sm font-bold",
            isActive(link.href)
              ? "bg-[#EAF6FE] text-[#0499FA] font-black"
              : "text-slate-700 hover:bg-slate-50",
          ]}
        >
          {link.label}
        </a>
      ))}

      {user ? (
        <div class="mt-2 border-t border-slate-100 pt-3">
          <a
            href="/my-coupons"
            class="flex items-center justify-between rounded-xl bg-[#EAF6FE] px-3.5 py-2.5 text-sm font-bold text-[#0499FA]"
          >
            <span>My Submitted Coupons</span>
            <span class="rounded-full bg-[#0499FA] px-2.5 py-0.5 text-xs font-black text-white">
              {user.name}
            </span>
          </a>
          <button
            type="button"
            id="mobile-logout-btn"
            class="mt-2 w-full rounded-xl bg-rose-50 px-3.5 py-2 text-left text-sm font-bold text-rose-700 transition hover:bg-rose-100"
          >
            Log Out
          </button>
        </div>
      ) : (
        <div class="mt-2 border-t border-slate-100 pt-3 flex gap-2">
          <a
            href="/login"
            class="flex-1 rounded-full border border-slate-200 py-2.5 text-center text-xs font-bold text-[#081126]"
          >
            Sign In
          </a>
          <a
            href="/login?mode=register"
            class="flex-1 rounded-full bg-[#0499FA] py-2.5 text-center text-xs font-bold text-white shadow-xs"
          >
            Sign Up
          </a>
        </div>
      )}

      <a
        href="/admin"
        class="mt-2 rounded-xl border border-dashed border-slate-300 py-2 text-center text-xs font-bold text-slate-500 hover:bg-slate-50"
      >
        Admin Portal →
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById("mobile-menu-toggle");
  const mobileMenu = document.getElementById("mobile-menu");
  toggleBtn?.addEventListener("click", () => {
    const isHidden = mobileMenu?.classList.toggle("hidden");
    toggleBtn.setAttribute("aria-expanded", String(!isHidden));
  });

  const handleLogout = async () => {
    await fetch("/api/auth/logout", { method: "POST" });
    window.location.href = "/login";
  };

  document.getElementById("navbar-logout-btn")?.addEventListener("click", handleLogout);
  document.getElementById("mobile-logout-btn")?.addEventListener("click", handleLogout);
</script>
