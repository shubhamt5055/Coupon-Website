---
import { getDb } from "../lib/cloudflare";
import { getCategoriesWithCounts, getStoresWithCounts } from "../lib/db";

const db = getDb();
const [stores, categories] = await Promise.all([
  getStoresWithCounts(db),
  getCategoriesWithCounts(db),
]);

const today = new Date().toISOString().slice(0, 10);
const defaultExpiry = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
---

<!-- Quick Add Coupon Modal (Zero Login Required) -->
<div
  id="add-coupon-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="add-coupon-modal-title"
>
  <div class="relative w-full max-w-2xl my-8 rounded-2xl bg-white p-6 sm:p-8 shadow-2xl transition max-h-[90vh] overflow-y-auto">
    <!-- Header -->
    <div class="flex items-start justify-between border-b border-slate-100 pb-4">
      <div>
        <h2
          id="add-coupon-modal-title"
          class="mt-2 text-2xl font-black tracking-tight text-[#191f2e]"
        >
          Add a Working Coupon
        </h2>
        <p class="mt-0.5 text-xs text-slate-500">
          Share a discount code with the CouponHub community. No account or
          password needed!
        </p>
      </div>
      <button
        type="button"
        id="close-add-coupon-modal"
        class="rounded-xl border border-slate-200 p-2 text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition"
        aria-label="Close modal"
      >
        <svg
          class="h-5 w-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"
          />
        </svg>
      </button>
    </div>

    <!-- Error Alert Box -->
    <div
      id="modal-submit-alert"
      class="mt-4 hidden rounded-xl border border-rose-200 bg-rose-50 p-3 text-xs font-semibold text-rose-700"
    ></div>

    <!-- Success Box -->
    <div
      id="modal-submit-success"
      class="mt-4 hidden rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-xs font-bold text-emerald-800"
    >
      Coupon published live successfully! Redirecting you now...
    </div>

    <!-- Add Coupon Form -->
    <form id="modal-coupon-form" class="mt-5 space-y-4">
      <!-- Offer Title -->
      <div>
        <label
          for="modal-coupon-title"
          class="mb-1 block text-xs font-bold text-[#191f2e]"
        >
          Coupon Title
        </label>
        <input
          id="modal-coupon-title"
          name="title"
          type="text"
          required
          minlength="5"
          maxlength="140"
          placeholder="e.g. Flat 50% Off on Food Orders"
          class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
        />
        <p class="mt-1 text-[11px] text-slate-400">
          Min 5 - Max 140 characters. Special symbols (&lt; &gt; . / ? &quot; [
          ] &#123; &#125; \ | - + * @ ! ~ # $ ^ ( ) =) are not allowed.
        </p>
      </div>

      <!-- Store & Category -->
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label
            for="modal-coupon-store"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Store / Brand
          </label>
          <select
            id="modal-coupon-store"
            name="store_id"
            required
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          >
            <option value="">Select store</option>
            {stores.map((s) => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="modal-coupon-category"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Category
          </label>
          <select
            id="modal-coupon-category"
            name="category_id"
            required
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          >
            <option value="">Select category</option>
            {categories.map((c) => (
              <option value={c.id}>
                {c.icon} {c.name}
              </option>
            ))}
          </select>
        </div>
      </div>

      <!-- Promo Code & Discount Badge -->
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label
            for="modal-coupon-code"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Promo Code
          </label>
          <input
            id="modal-coupon-code"
            name="code"
            type="text"
            required
            minlength="2"
            maxlength="30"
            placeholder="e.g. SWIGGY50"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 font-mono text-xs sm:text-sm uppercase tracking-widest text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Letters, numbers, and hyphens only (2–30 chars).
          </p>
        </div>

        <div>
          <label
            for="modal-coupon-discount"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Discount Text / Badge
          </label>
          <input
            id="modal-coupon-discount"
            name="discount_text"
            type="text"
            required
            maxlength="40"
            placeholder="e.g. 50% OFF or ₹100 CASHBACK"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Max 99% OFF (or flat amount, e.g. ₹150 OFF).
          </p>
        </div>
      </div>

      <!-- Deal Link & Expiry Date -->
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label
            for="modal-coupon-url"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Store / Deal Link
          </label>
          <input
            id="modal-coupon-url"
            name="affiliate_or_store_url"
            type="url"
            required
            placeholder="https://www.store.com/deal"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Must start with http:// or https:// with valid domain.
          </p>
        </div>

        <div>
          <label
            for="modal-coupon-expiry"
            class="mb-1 block text-xs font-bold text-[#191f2e]"
          >
            Expiry Date
          </label>
          <input
            id="modal-coupon-expiry"
            name="expiry_date"
            type="date"
            required
            min={today}
            value={defaultExpiry}
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
          <p class="mt-1 text-[11px] text-slate-400">
            Must be today or a future date.
          </p>
        </div>
      </div>

      <!-- Description (Optional) -->
      <div>
        <label
          for="modal-coupon-desc"
          class="mb-1 block text-xs font-bold text-[#191f2e]"
        >
          Description (Optional)
        </label>
        <textarea
          id="modal-coupon-desc"
          name="description"
          rows="2"
          maxlength="500"
          placeholder="e.g. Valid on minimum order value of ₹249 on selected restaurants."
          class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
        ></textarea>
      </div>

      <!-- Submit Actions -->
      <div class="mt-6 flex items-center justify-end gap-3 border-t border-slate-100 pt-4">
        <button
          type="button"
          id="cancel-add-coupon-modal"
          class="rounded-lg border border-slate-200 px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50 transition"
        >
          Cancel
        </button>
        <button
          type="submit"
          id="modal-submit-btn"
          class="rounded-lg bg-[#60a600] px-6 py-2.5 text-xs font-extrabold uppercase tracking-wider text-white shadow-xs transition hover:bg-[#528f00] active:scale-95 disabled:opacity-60"
        >
          Submit coupon
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  const addModal = document.getElementById("add-coupon-modal");
  const closeModalBtn = document.getElementById("close-add-coupon-modal");
  const cancelModalBtn = document.getElementById("cancel-add-coupon-modal");
  const form = document.getElementById(
    "modal-coupon-form",
  ) as HTMLFormElement | null;
  const alertBox = document.getElementById("modal-submit-alert");
  const successBox = document.getElementById("modal-submit-success");
  const submitBtn = document.getElementById(
    "modal-submit-btn",
  ) as HTMLButtonElement | null;

  function openAddModal() {
    if (addModal) {
      addModal.classList.remove("hidden");
      addModal.classList.add("flex");
      document.body.style.overflow = "hidden";
      const titleInput = document.getElementById("modal-coupon-title");
      titleInput?.focus();
    }
  }

  function closeAddModal() {
    if (addModal) {
      addModal.classList.add("hidden");
      addModal.classList.remove("flex");
      document.body.style.overflow = "";
    }
    if (alertBox) alertBox.classList.add("hidden");
  }

  // Intercept all clicks to "+ Add Coupon" buttons to open the modal immediately
  document
    .querySelectorAll('a[href="/submit-coupon"], [data-open-add-coupon]')
    .forEach((el) => {
      el.addEventListener("click", (e) => {
        // If user is already on /submit-coupon page, let default link work, otherwise open modal directly!
        if (window.location.pathname !== "/submit-coupon") {
          e.preventDefault();
          openAddModal();
        }
      });
    });

  closeModalBtn?.addEventListener("click", closeAddModal);
  cancelModalBtn?.addEventListener("click", closeAddModal);

  // Close when clicking outside dialog
  addModal?.addEventListener("click", (e) => {
    if (e.target === addModal) {
      closeAddModal();
    }
  });

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (alertBox) alertBox.classList.add("hidden");
    if (successBox) successBox.classList.add("hidden");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Publishing Instantly...";
    }

    const fd = new FormData(form);
    const payload = {
      title: String(fd.get("title") || "").trim(),
      code: String(fd.get("code") || "")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, ""),
      discount_text: String(fd.get("discount_text") || "").trim(),
      store_id: Number(fd.get("store_id")),
      category_id: Number(fd.get("category_id")),
      affiliate_or_store_url: String(
        fd.get("affiliate_or_store_url") || "",
      ).trim(),
      expiry_date: String(fd.get("expiry_date") || "").trim(),
      description: String(fd.get("description") || "").trim(),
      terms: "",
    };

    // Client-side validation
    if (payload.title.length < 5) {
      if (alertBox) {
        alertBox.textContent =
          "Coupon title must be at least 5 characters long.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    if (payload.title.length > 140) {
      if (alertBox) {
        alertBox.textContent = "Coupon title cannot exceed 140 characters.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    const letterMatches = payload.title.match(/[\p{L}]/gu);
    if (!letterMatches || letterMatches.length < 2) {
      if (alertBox) {
        alertBox.textContent =
          "Title cannot be only numbers or symbols. Please include descriptive words.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    const disallowedTitleCharsRegex = /[<>./?"\]\[{}\\|+\-*@!~#$^()=]/;
    if (disallowedTitleCharsRegex.test(payload.title)) {
      if (alertBox) {
        alertBox.textContent =
          'Special symbols (< > . / ? " [ ] { } \\ | - + * @ ! ~ # $ ^ ( ) =) are not allowed in Title.';
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    const titleAllowedRegex = /^[\p{L}\p{N}\s%₹&',:–—]+$/u;
    if (!titleAllowedRegex.test(payload.title)) {
      if (alertBox) {
        alertBox.textContent =
          "Title contains invalid characters. Special symbols are not allowed.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    // Promo code validation
    if (payload.code.length < 2 || payload.code.length > 30) {
      if (alertBox) {
        alertBox.textContent =
          "Promo code must be between 2 and 30 characters.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    if (!/^[A-Z0-9_-]+$/.test(payload.code)) {
      if (alertBox) {
        alertBox.textContent =
          "Promo code can only contain letters, numbers, hyphens, and underscores.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    // Discount percentage check (<= 99%)
    const pctMatch = payload.discount_text.match(/(\d+(?:\.\d+)?)\s*%/);
    if (pctMatch) {
      const pctVal = parseFloat(pctMatch[1]);
      if (pctVal > 99) {
        if (alertBox) {
          alertBox.textContent =
            "Discount percentage cannot exceed 99% (maximum allowed is 99% OFF).";
          alertBox.classList.remove("hidden");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Publish Coupon Instantly";
        }
        return;
      }
      if (pctVal <= 0) {
        if (alertBox) {
          alertBox.textContent = "Discount percentage must be greater than 0%.";
          alertBox.classList.remove("hidden");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Publish Coupon Instantly";
        }
        return;
      }
    }

    // Store / Deal link check
    try {
      const parsedUrl = new URL(payload.affiliate_or_store_url);
      if (parsedUrl.protocol !== "http:" && parsedUrl.protocol !== "https:") {
        throw new Error("Invalid protocol");
      }
      if (!parsedUrl.hostname || !parsedUrl.hostname.includes(".")) {
        throw new Error("Invalid domain");
      }
    } catch {
      if (alertBox) {
        alertBox.textContent =
          "Please enter a valid store/deal link URL (e.g. https://www.store.com/deal).";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    // Expiry date check
    const todayStr = new Date().toISOString().slice(0, 10);
    if (payload.expiry_date < todayStr) {
      if (alertBox) {
        alertBox.textContent =
          "Expiry date cannot be in the past. Please choose today or a future date.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly";
      }
      return;
    }

    try {
      const res = await fetch("/api/coupons/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = (await res.json()) as {
        ok?: boolean;
        id?: number;
        error?: string;
      };

      if (!res.ok || !data.ok) {
        if (alertBox) {
          alertBox.textContent =
            data.error || "Please check all fields and try again.";
          alertBox.classList.remove("hidden");
        }
        return;
      }

      // Success! Show live message and redirect to live coupons
      if (successBox) successBox.classList.remove("hidden");
      setTimeout(() => {
        window.location.href = "/coupons";
      }, 700);
    } catch {
      if (alertBox) {
        alertBox.textContent = "Network error. Please try again.";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
    }
  });
</script>
