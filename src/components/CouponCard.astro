---
import type { CouponWithRelations } from "../lib/types";
import {
  formatDisplayDate,
  getDaysUntilExpiry,
  getStoreColorClass,
  getStoreInitials,
  isCouponExpired,
  maskCouponCode,
  safeExternalUrl,
  safeImageUrl,
} from "../lib/format";

interface Props {
  coupon: CouponWithRelations;
  featuredBadge?: string;
}

const { coupon, featuredBadge } = Astro.props;
const expired = isCouponExpired(coupon.expiry_date);
const daysLeft = getDaysUntilExpiry(coupon.expiry_date);
const expiringSoon = !expired && daysLeft !== null && daysLeft <= 7;
const logo = safeImageUrl(coupon.store_logo_url);
const storeUrl = safeExternalUrl(coupon.affiliate_or_store_url);
const masked = maskCouponCode(coupon.code);
const totalVotes = coupon.worked_count + coupon.didnt_work_count;
const successRate =
  totalVotes > 0 ? Math.round((coupon.worked_count / totalVotes) * 100) : null;
---

<article
  class:list={[
    "group relative flex flex-col justify-between overflow-hidden rounded-2xl border bg-white p-5 shadow-xs transition duration-200 dark:bg-slate-900",
    expired
      ? "border-slate-200/80 opacity-75 grayscale-[30%] dark:border-slate-800"
      : "border-slate-200/90 hover:-translate-y-1 hover:border-indigo-300 hover:shadow-lg dark:border-slate-800 dark:hover:border-indigo-500/60",
  ]}
>
  <div>
    <!-- Top Row: Store + Discount Badge -->
    <div class="mb-3.5 flex items-start justify-between gap-3">
      <a
        href={`/stores/${coupon.store_slug}`}
        class="flex min-w-0 items-center gap-2.5 hover:opacity-85"
      >
        {logo ? (
          <img
            src={logo}
            alt={`${coupon.store_name} logo`}
            loading="lazy"
            class="h-10 w-10 shrink-0 rounded-xl border border-slate-200 bg-white object-contain p-1 dark:border-slate-700"
          />
        ) : (
          <div
            class:list={[
              "flex h-10 w-10 shrink-0 items-center justify-center rounded-xl text-xs font-extrabold text-white",
              getStoreColorClass(coupon.store_name),
            ]}
          >
            {getStoreInitials(coupon.store_name)}
          </div>
        )}
        <div class="min-w-0">
          <p class="truncate text-sm font-bold text-slate-900 dark:text-white">
            {coupon.store_name}
          </p>
          <span class="text-xs text-slate-500 dark:text-slate-400">
            {coupon.category_icon} {coupon.category_name}
          </span>
        </div>
      </a>

      <span
        class:list={[
          "shrink-0 rounded-full px-3 py-1 text-xs font-extrabold tracking-wide uppercase",
          expired
            ? "bg-rose-100 text-rose-700 dark:bg-rose-950/70 dark:text-rose-300"
            : "bg-emerald-100 text-emerald-800 dark:bg-emerald-950/70 dark:text-emerald-300",
        ]}
      >
        {expired ? "EXPIRED" : coupon.discount_text}
      </span>
    </div>

    <!-- Status Pills -->
    <div class="mb-2.5 flex flex-wrap items-center gap-1.5">
      {featuredBadge && !expired && (
        <span class="rounded-md bg-amber-100 px-2 py-0.5 text-[11px] font-bold text-amber-800 dark:bg-amber-950/70 dark:text-amber-300">
          🔥 {featuredBadge}
        </span>
      )}
      {expiringSoon && (
        <span class="rounded-md bg-orange-100 px-2 py-0.5 text-[11px] font-bold text-orange-800 dark:bg-orange-950/70 dark:text-orange-300">
          ⏳ Ends in {daysLeft === 0 ? "today" : `${daysLeft}d`}
        </span>
      )}
      {successRate !== null && !expired && (
        <span class="rounded-md bg-slate-100 px-2 py-0.5 text-[11px] font-semibold text-slate-600 dark:bg-slate-800 dark:text-slate-300">
          ✓ {successRate}% worked
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-base leading-snug font-bold text-slate-900 sm:text-lg dark:text-white">
      <a
        href={`/coupons/${coupon.id}`}
        class="hover:text-indigo-600 dark:hover:text-indigo-400"
      >
        {coupon.title}
      </a>
    </h3>

    {coupon.description && (
      <p class="mt-1.5 line-clamp-2 text-sm text-slate-600 dark:text-slate-400">
        {coupon.description}
      </p>
    )}
  </div>

  <!-- Ticket Divider + Action Box -->
  <div class="mt-4">
    <div class="coupon-divider my-4 h-px text-slate-300 dark:text-slate-700" aria-hidden="true"></div>

    {expired ? (
      <div class="flex items-center justify-between rounded-xl border border-dashed border-slate-300 bg-slate-50 px-3.5 py-2.5 dark:border-slate-700 dark:bg-slate-800/60">
        <span class="font-mono text-sm font-bold text-slate-400 line-through">
          {coupon.code}
        </span>
        <span class="rounded-lg bg-rose-100 px-2.5 py-1 text-xs font-bold text-rose-700 dark:bg-rose-950 dark:text-rose-300">
          Expired
        </span>
      </div>
    ) : (
      <div class="flex items-center justify-between gap-2 rounded-xl border border-dashed border-indigo-400/80 bg-indigo-50/50 p-1.5 pl-3.5 dark:border-indigo-500/50 dark:bg-indigo-950/30">
        <span
          class="coupon-code-display font-mono text-sm font-extrabold tracking-wider text-indigo-700 dark:text-indigo-300"
          data-coupon-code-text={coupon.id}
        >
          {masked}
        </span>
        <button
          type="button"
          class="reveal-coupon-btn rounded-lg bg-indigo-600 px-3.5 py-2 text-xs font-bold text-white shadow-xs transition hover:bg-indigo-700 active:scale-[0.98] sm:text-sm"
          data-coupon-id={coupon.id}
          data-coupon-code={coupon.code}
          data-coupon-title={coupon.title}
          data-coupon-store={coupon.store_name}
          data-coupon-discount={coupon.discount_text}
          data-coupon-url={storeUrl}
        >
          Reveal &amp; Copy
        </button>
      </div>
    )}

    <!-- Metadata Footer -->
    <div class="mt-3.5 flex items-center justify-between gap-2 text-xs text-slate-500 dark:text-slate-400">
      <div class="flex items-center gap-3">
        <span>Exp: {formatDisplayDate(coupon.expiry_date)}</span>
        <span data-coupon-clicks={coupon.id}>{coupon.click_count} uses</span>
      </div>
      <a
        href={`/coupons/${coupon.id}`}
        class="font-semibold text-indigo-600 hover:underline dark:text-indigo-400"
      >
        Details →
      </a>
    </div>
  </div>
</article>
