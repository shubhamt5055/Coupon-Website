---
import type { CouponWithRelations } from "../lib/types";
import {
  formatDisplayDate,
  getDaysUntilExpiry,
  getStoreColorClass,
  getStoreInitials,
  isCouponExpired,
  maskCouponCode,
  safeExternalUrl,
  safeImageUrl,
} from "../lib/format";

interface Props {
  coupon: CouponWithRelations;
  featuredBadge?: string;
}

const { coupon, featuredBadge } = Astro.props;
const expired = isCouponExpired(coupon.expiry_date);
const daysLeft = getDaysUntilExpiry(coupon.expiry_date);
const expiringSoon = !expired && daysLeft !== null && daysLeft <= 7;
const logo = safeImageUrl(coupon.store_logo_url);
const storeUrl = safeExternalUrl(coupon.affiliate_or_store_url);
const masked = maskCouponCode(coupon.code);
const totalVotes = coupon.worked_count + coupon.didnt_work_count;
const successRate =
  totalVotes > 0 ? Math.round((coupon.worked_count / totalVotes) * 100) : 92;
---

<article
  class:list={[
    "group relative flex flex-col justify-between rounded-3xl border bg-white p-5.5 shadow-xs transition-all duration-200 hover:-translate-y-1 hover:shadow-xl",
    expired
      ? "border-slate-200/70 opacity-70 grayscale-[35%]"
      : "border-slate-200/90 hover:border-emerald-400 hover:shadow-emerald-950/5",
  ]}
>
  <div>
    <!-- Top Row: Store Badge + High Impact Discount Pill -->
    <div class="mb-3.5 flex items-start justify-between gap-3">
      <a
        href={`/stores/${coupon.store_slug}`}
        class="flex min-w-0 items-center gap-3 transition hover:opacity-85"
      >
        {logo ? (
          <img
            src={logo}
            alt={`${coupon.store_name} logo`}
            loading="lazy"
            class="h-11 w-11 shrink-0 rounded-2xl border border-slate-200/90 bg-white object-contain p-1.5 shadow-xs"
          />
        ) : (
          <div
            class:list={[
              "flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl text-xs font-black text-white shadow-xs",
              getStoreColorClass(coupon.store_name),
            ]}
          >
            {getStoreInitials(coupon.store_name)}
          </div>
        )}
        <div class="min-w-0">
          <p class="truncate text-sm font-extrabold text-slate-900 group-hover:text-emerald-700 transition">
            {coupon.store_name}
          </p>
          <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500">
            <span>{coupon.category_icon}</span>
            <span>{coupon.category_name}</span>
          </span>
        </div>
      </a>

      <!-- Discount Tag -->
      <span
        class:list={[
          "shrink-0 rounded-xl px-3 py-1.5 text-xs font-black tracking-tight uppercase shadow-xs",
          expired
            ? "bg-slate-100 text-slate-500 ring-1 ring-slate-200"
            : "bg-emerald-50 text-emerald-800 ring-1 ring-emerald-600/20",
        ]}
      >
        {expired ? "EXPIRED" : coupon.discount_text}
      </span>
    </div>

    <!-- Human Trust & Status Pills -->
    <div class="mb-3 flex flex-wrap items-center gap-1.5">
      {featuredBadge && !expired && (
        <span class="inline-flex items-center gap-1 rounded-lg bg-amber-50 px-2 py-0.5 text-[11px] font-extrabold text-amber-800 ring-1 ring-amber-600/20">
          <span>🔥</span>
          <span>{featuredBadge}</span>
        </span>
      )}
      {!expired && !featuredBadge && (
        <span class="inline-flex items-center gap-1 rounded-lg bg-emerald-50 px-2 py-0.5 text-[11px] font-extrabold text-emerald-700 ring-1 ring-emerald-600/20">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500 animate-soft-pulse"></span>
          <span>Staff Verified</span>
        </span>
      )}
      {expiringSoon && (
        <span class="inline-flex items-center gap-1 rounded-lg bg-orange-50 px-2 py-0.5 text-[11px] font-bold text-orange-800 ring-1 ring-orange-500/20">
          <span>⏳</span>
          <span>Ends in {daysLeft === 0 ? "today" : `${daysLeft}d`}</span>
        </span>
      )}
      {!expired && (
        <span class="inline-flex items-center gap-1 rounded-lg bg-slate-50 px-2 py-0.5 text-[11px] font-semibold text-slate-600">
          <span>👍</span>
          <span>{successRate}% verified</span>
        </span>
      )}
    </div>

    <!-- Title & Description -->
    <h3 class="text-base font-extrabold leading-snug tracking-tight text-slate-900 group-hover:text-emerald-800 transition">
      <a href={`/coupons/${coupon.id}`}>
        {coupon.title}
      </a>
    </h3>

    {coupon.description && (
      <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-slate-500">
        {coupon.description}
      </p>
    )}
  </div>

  <!-- Ticket Perforation & Action Box -->
  <div class="mt-5">
    <!-- Dashed Voucher Tear Line -->
    <div class="relative my-3.5">
      <div class="ticket-dashed-line"></div>
    </div>

    {expired ? (
      <div class="flex items-center justify-between rounded-2xl border border-dashed border-slate-300 bg-slate-50/70 px-4 py-3">
        <span class="font-mono text-xs font-bold text-slate-400 line-through">
          {coupon.code}
        </span>
        <span class="rounded-lg bg-slate-200 px-2.5 py-1 text-xs font-bold text-slate-600">
          Deal Expired
        </span>
      </div>
    ) : coupon.is_active === 0 ? (
      <div class="flex items-center justify-between rounded-2xl border border-dashed border-amber-300 bg-amber-50/70 px-4 py-3">
        <span class="font-mono text-xs font-bold text-amber-900">
          {coupon.code}
        </span>
        <span class="rounded-lg bg-amber-200/90 px-2.5 py-1 text-xs font-black text-amber-800">
          Pending Admin Review
        </span>
      </div>
    ) : (
      <div class="flex items-center justify-between gap-2 rounded-2xl border border-slate-200 bg-slate-50/90 p-1.5 pl-4 shadow-2xs transition group-hover:border-emerald-300">
        <div class="flex items-center gap-1.5 font-mono text-xs font-black tracking-wider text-slate-700">
          <svg class="h-3.5 w-3.5 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span
            class="coupon-code-display"
            data-coupon-code-text={coupon.id}
          >
            {masked}
          </span>
        </div>
        <button
          type="button"
          class="reveal-coupon-btn inline-flex items-center gap-1.5 rounded-xl bg-emerald-600 px-4 py-2.5 text-xs font-black text-white shadow-sm transition hover:bg-emerald-700 active:scale-95"
          data-coupon-id={coupon.id}
          data-coupon-code={coupon.code}
          data-coupon-title={coupon.title}
          data-coupon-store={coupon.store_name}
          data-coupon-discount={coupon.discount_text}
          data-coupon-url={storeUrl}
        >
          <span>✂️</span>
          <span>Reveal Code</span>
        </button>
      </div>
    )}

    <!-- Metadata Footer: Expiry + Total Uses -->
    <div class="mt-3.5 flex items-center justify-between text-[11px] font-semibold text-slate-400">
      <div class="flex items-center gap-3">
        <span>Expires {formatDisplayDate(coupon.expiry_date)}</span>
        <span>•</span>
        <span data-coupon-clicks={coupon.id}>{coupon.click_count} redeemed</span>
      </div>
      <a
        href={`/coupons/${coupon.id}`}
        class="font-bold text-slate-600 hover:text-emerald-700 hover:underline"
      >
        View Deal →
      </a>
    </div>

    <!-- Injected actions (e.g. Delete button on /my-coupons) -->
    <slot />
  </div>
</article>
