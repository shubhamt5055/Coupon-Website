---
import type { Store } from "../lib/types";
import {
  getStoreColorClass,
  getStoreInitials,
  safeImageUrl,
} from "../lib/format";

interface Props {
  store: Pick<Store, "name" | "slug" | "logo_url">;
  size?: "sm" | "md" | "lg";
}

const { store, size = "md" } = Astro.props;
const logo = safeImageUrl(store.logo_url);
const key = (store.slug || store.name || "").toLowerCase().trim();

const sizeClasses = {
  sm: "h-8 w-8 text-xs rounded-xl",
  md: "h-11 w-11 text-sm rounded-2xl",
  lg: "h-16 w-16 text-xl rounded-3xl",
}[size];
---

{logo ? (
  <img
    src={logo}
    alt={`${store.name} logo`}
    loading="lazy"
    class:list={["object-contain bg-white p-1", sizeClasses]}
  />
) : key.includes("amazon") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-slate-900 text-amber-400 select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[11px] leading-none">amzn</span>
  </div>
) : key.includes("flipkart") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#2874f0] text-yellow-300 select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight italic text-sm leading-none">fk</span>
  </div>
) : key.includes("zomato") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#e23744] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tighter italic text-[11px] leading-none">zomato</span>
  </div>
) : key.includes("swiggy") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#fc8019] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-wider text-base leading-none">S</span>
  </div>
) : key.includes("myntra") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-linear-to-tr from-[#ff3f6c] via-[#ff905a] to-[#f13ab1] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-sm font-black leading-none">M</span>
  </div>
) : key.includes("makemytrip") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#008cff] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tighter text-[11px] font-black text-rose-200 leading-none">
      MMT
    </span>
  </div>
) : key.includes("nykaa") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#fc2779] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-widest text-[9px] font-extrabold uppercase leading-none">
      NYK
    </span>
  </div>
) : key.includes("croma") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#00b5b8] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[11px] font-extrabold leading-none">
      croma
    </span>
  </div>
) : key.includes("dominos") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#006491] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-black leading-none">DOM</span>
  </div>
) : key.includes("mcdonalds") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#da291c] text-[#ffc72c] select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="text-base font-black leading-none">M</span>
  </div>
) : key.includes("kfc") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#a3080c] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-xs font-black leading-none">KFC</span>
  </div>
) : key.includes("ajio") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#2c4152] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tighter text-[10px] font-bold uppercase leading-none">AJIO</span>
  </div>
) : key.includes("puma") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-black text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-black leading-none">PUMA</span>
  </div>
) : key.includes("nike") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#111111] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-black italic leading-none">NIKE</span>
  </div>
) : key.includes("boat") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#ff0000] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-extrabold leading-none">boAt</span>
  </div>
) : key.includes("oneplus") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#eb0028] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="text-sm font-black leading-none">1+</span>
  </div>
) : key.includes("samsung") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#1428a0] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tighter text-[9px] font-black leading-none">SAMS</span>
  </div>
) : key.includes("uber") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-black text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-bold leading-none">Uber</span>
  </div>
) : key.includes("ola") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-black text-[#c6d928] select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-xs font-black leading-none">OLA</span>
  </div>
) : key.includes("blinkit") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#f8cb46] text-[#191f2e] select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-black leading-none">blink</span>
  </div>
) : key.includes("zepto") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#7b1fa2] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-bold leading-none">zepto</span>
  </div>
) : key.includes("bookmyshow") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#c4242d] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-[10px] font-black leading-none">BMS</span>
  </div>
) : key.includes("lenskart") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#000042] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-xs font-black leading-none">LK</span>
  </div>
) : key.includes("bigbasket") ? (
  <div
    class:list={[
      "flex items-center justify-center font-black bg-[#84c225] text-white select-none shadow-xs",
      sizeClasses,
    ]}
  >
    <span class="tracking-tight text-xs font-black leading-none">bb</span>
  </div>
) : (
  <div
    class:list={[
      "flex items-center justify-center font-black text-white select-none shadow-xs",
      getStoreColorClass(store.name),
      sizeClasses,
    ]}
  >
    {getStoreInitials(store.name)}
  </div>
)}
