---
import "../styles/global.css";

interface Props {
  title?: string;
  adminUser?: string;
}

const { title = "Admin Panel — Couponly", adminUser = "admin" } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/admin", label: "Coupons", exact: true },
  { href: "/admin/coupons/new", label: "+ Add Coupon", exact: false },
  { href: "/admin/stores", label: "Stores", exact: false },
  { href: "/admin/categories", label: "Categories", exact: false },
  { href: "/admin/import", label: "CSV Import", exact: false },
];

function isNavActive(href: string, exact: boolean): boolean {
  if (exact) return currentPath === href || currentPath === `${href}/`;
  return currentPath.startsWith(href);
}
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Force light mode only -->
    <script is:inline>
      (() => {
        document.documentElement.classList.remove("dark");
        try {
          localStorage.removeItem("couponhub-theme");
        } catch {}
      })();
    </script>
  </head>

  <body class="min-h-screen bg-[#F8FAFC] text-slate-900 antialiased selection:bg-[#0499FA]/20 selection:text-[#0499FA]">
    <header class="sticky top-0 z-40 border-b border-slate-200/80 bg-white/95 backdrop-blur-md shadow-xs">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <div class="flex items-center gap-3">
          <a href="/admin" class="group flex items-center gap-2.5">
            <!-- Interlocking Double Ring Logo Icon -->
            <div class="flex h-9 w-9 items-center justify-center rounded-xl bg-[#0499FA] text-white shadow-xs group-hover:scale-105 transition-transform">
              <div class="relative flex items-center justify-center">
                <span class="inline-block h-3.5 w-3.5 rounded-full border-2 border-white -mr-1"></span>
                <span class="inline-block h-3.5 w-3.5 rounded-full border-2 border-[#FF7A18] -ml-1 bg-white"></span>
              </div>
            </div>
            <div class="flex items-center gap-1.5">
              <span class="text-lg font-black tracking-tight text-[#081126]">
                Coupon<span class="text-[#0499FA]">ly</span>
              </span>
              <span class="rounded-md bg-[#0499FA] px-2 py-0.5 text-[10px] font-black text-white uppercase tracking-wider">
                Admin
              </span>
            </div>
          </a>
        </div>

        <nav class="flex flex-wrap items-center gap-1" aria-label="Admin Navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-xl px-3.5 py-1.5 text-xs font-bold transition sm:text-sm",
                isNavActive(item.href, item.exact)
                  ? "bg-[#0499FA] text-white shadow-2xs"
                  : "text-slate-600 hover:bg-[#EAF6FE] hover:text-[#0499FA]",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2.5">
          <a
            href="/"
            target="_blank"
            class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-bold text-slate-700 transition hover:border-[#0499FA] hover:text-[#0499FA] shadow-2xs"
          >
            Live Site ↗
          </a>
          <span class="hidden rounded-xl bg-[#EAF6FE] border border-[#0499FA]/20 px-2.5 py-1 text-xs font-bold text-[#0499FA] sm:inline">
            🛡️ @{adminUser}
          </span>
          <button
            type="button"
            id="admin-logout-btn"
            class="rounded-xl bg-rose-50 px-3 py-1.5 text-xs font-bold text-rose-700 transition hover:bg-rose-100 shadow-2xs"
          >
            Logout
          </button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <script>
      document.getElementById("admin-logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        window.location.href = "/admin/login";
      });
    </script>
  </body>
</html>
