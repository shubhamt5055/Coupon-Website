---
import "../styles/global.css";

interface Props {
  title?: string;
  adminUser?: string;
}

const { title = "Admin Panel — CouponHub", adminUser = "admin" } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: "/admin", label: "Coupons", exact: true },
  { href: "/admin/coupons/new", label: "+ Add Coupon", exact: false },
  { href: "/admin/stores", label: "Stores", exact: false },
  { href: "/admin/categories", label: "Categories", exact: false },
  { href: "/admin/import", label: "CSV Import", exact: false },
];

function isNavActive(href: string, exact: boolean): boolean {
  if (exact) return currentPath === href || currentPath === `${href}/`;
  return currentPath.startsWith(href);
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="min-h-screen bg-[#f4f7fb] text-slate-800 antialiased selection:bg-[#2491ef] selection:text-white">
    <header class="sticky top-0 z-40 bg-[#191f2e] text-white shadow-xs">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-3 px-4 py-3 sm:px-6 lg:px-8">
        <!-- Logo -->
        <a href="/admin" class="group flex items-center gap-2">
          <div class="flex items-center text-xl font-black tracking-tight text-white">
            <span>Coupon</span>
            <span class="text-[#2491ef]">Hub</span>
            <svg
              class="ml-1 h-3 w-5 text-[#60a600]"
              viewBox="0 0 24 12"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            >
              <path d="M2 2c5 8 15 8 20 0" />
            </svg>
          </div>
          <span class="rounded bg-[#60a600] px-1.5 py-0.5 text-[10px] font-extrabold uppercase text-white">
            &#x1F464;
          </span>
        </a>

        <!-- Nav -->
        <nav
          class="flex flex-wrap items-center gap-1.5"
          aria-label="Admin Navigation"
        >
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={[
                "rounded-lg px-3 py-1.5 text-xs font-bold transition",
                isNavActive(item.href, item.exact)
                  ? "bg-[#2491ef] text-white shadow-2xs"
                  : "text-slate-300 hover:bg-white/10 hover:text-white",
              ]}
            >
              {item.label}
            </a>
          ))}
        </nav>

        <!-- Right -->
        <div class="flex items-center gap-2.5">
          <a
            href="/"
            target="_blank"
            class="rounded-lg border border-slate-700 bg-slate-800 px-3 py-1.5 text-xs font-bold text-slate-200 transition hover:bg-slate-700"
          >
            Live Site ↗
          </a>
          <span class="hidden rounded-lg border border-slate-700 bg-slate-800 px-2.5 py-1.5 text-xs font-bold text-[#c2f03e] sm:inline">
            &#x1F464; @{adminUser}
          </span>
          <button
            type="button"
            id="admin-logout-btn"
            class="rounded-lg border border-rose-800/60 bg-rose-950/40 px-3 py-1.5 text-xs font-bold text-rose-300 transition hover:bg-rose-900 hover:text-white"
          >
            Logout
          </button>
        </div>
      </div>
    </header>

    <main class="relative mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <slot />
    </main>

    <script>
      document
        .getElementById("admin-logout-btn")
        ?.addEventListener("click", async () => {
          await fetch("/api/admin/logout", { method: "POST" });
          window.location.href = "/admin/login";
        });
    </script>
  </body>
</html>
