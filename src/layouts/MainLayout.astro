---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CouponRevealModal from "../components/CouponRevealModal.astro";

interface Props {
  title?: string;
  description?: string;
  compactFooter?: boolean;
}

const {
  title = "CouponHub — Verified Discount Coupons & Promo Codes",
  description = "Browse, search, and copy verified discount coupons and promo codes from top online stores across Food, Fashion, Electronics, and Travel.",
  compactFooter = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Force light mode only -->
    <script is:inline>
      (() => {
        document.documentElement.classList.remove("dark");
        try {
          localStorage.removeItem("couponhub-theme");
        } catch {}
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-[#FAFAF9] text-slate-900 antialiased">
    <Navbar currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    {compactFooter ? (
      <footer class="border-t border-slate-200/80 bg-white py-3 text-center text-xs font-semibold text-slate-400">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
          <p>© {year} CouponHub. All rights reserved.</p>
          <div class="flex items-center gap-3 text-slate-500">
            <span>🛡️ 100% Free &amp; Verified</span>
            <span>•</span>
            <a href="/" class="font-bold text-slate-700 hover:text-emerald-700">Back to Home</a>
          </div>
        </div>
      </footer>
    ) : (
      <Footer />
    )}

    <CouponRevealModal />
  </body>
</html>
