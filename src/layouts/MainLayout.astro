---
import "../styles/global.css";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import CouponRevealModal from "../components/CouponRevealModal.astro";

interface Props {
  title?: string;
  description?: string;
  compactFooter?: boolean;
}

const {
  title = "CouponHub — Verified Discount Coupons & Promo Codes",
  description = "Browse, search, and copy verified discount coupons and promo codes from top online stores across Food, Fashion, Electronics, and Travel.",
  compactFooter = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Force light mode only -->
    <script is:inline>
      (() => {
        document.documentElement.classList.remove("dark");
        try {
          localStorage.removeItem("couponhub-theme");
        } catch {}
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col bg-[#F8FDF9] text-slate-900 selection:bg-[#10B981] selection:text-white antialiased">
    <Navbar currentPath={currentPath} />

    <main class="flex-1">
      <slot />
    </main>

    {compactFooter ? (
      <footer class="border-t border-[#10B981]/20 bg-white py-3 text-center text-xs font-semibold text-slate-500">
        <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
          <p>© {year} CouponHub. All rights reserved.</p>
          <div class="flex items-center gap-3">
            <span class="inline-flex items-center gap-1 rounded-full bg-[#ECFDF5] px-2.5 py-0.5 text-[11px] font-black text-[#064E3B] border border-[#10B981]/30">
              <span class="h-1.5 w-1.5 rounded-full bg-[#10B981]"></span>
              100% Free &amp; Verified
            </span>
            <span>•</span>
            <a href="/" class="font-extrabold text-[#064E3B] hover:text-[#10B981] transition">
              Back to Home
            </a>
          </div>
        </div>
      </footer>
    ) : (
      <Footer />
    )}

    <!-- Global Coupon Code Reveal & Copy Modal -->
    <CouponRevealModal />
  </body>
</html>
