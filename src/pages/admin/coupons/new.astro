---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import AdminCouponForm from "../../../components/AdminCouponForm.astro";
import { getDb } from "../../../lib/cloudflare";
import { getCategoriesWithCounts, getStoresWithCounts } from "../../../lib/db";

const db = getDb();
const [stores, categories] = await Promise.all([
  getStoresWithCounts(db),
  getCategoriesWithCounts(db),
]);
const adminUser = Astro.locals.adminUser ?? "admin";
---

<AdminLayout title="Add New Coupon — Admin | CouponHub" adminUser={adminUser}>
  <div class="mx-auto max-w-3xl">
    <div class="mb-6">
      <a href="/admin" class="text-xs font-bold text-[#2491ef] hover:underline transition">
        ← Back to Coupons
      </a>
      <h1 class="mt-2 text-2xl font-extrabold text-[#191f2e]">
        Add New Coupon
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Create a new discount deal. It will go live on the public website right away.
      </p>
    </div>

    <AdminCouponForm mode="create" stores={stores} categories={categories} />
  </div>
</AdminLayout>
