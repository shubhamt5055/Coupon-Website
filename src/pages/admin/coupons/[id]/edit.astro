---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminCouponForm from "../../../../components/AdminCouponForm.astro";
import { getDb } from "../../../../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCouponById,
  getStoresWithCounts,
} from "../../../../lib/db";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin");
}

const db = getDb();
const [coupon, stores, categories] = await Promise.all([
  getCouponById(db, id),
  getStoresWithCounts(db),
  getCategoriesWithCounts(db),
]);

if (!coupon) {
  return Astro.redirect("/admin");
}

const adminUser = Astro.locals.adminUser ?? "admin";
---

<AdminLayout title={`Edit Coupon #${coupon.id} — Admin | CouponHub`} adminUser={adminUser}>
  <div class="mx-auto max-w-3xl">
    <div class="mb-6">
      <a href="/admin" class="text-xs font-bold text-[#9333EA] hover:text-[#EC4899] transition">
        ← Back to Coupons
      </a>
      <h1 class="mt-2 text-2xl font-black text-[#581C87]">
        Edit Coupon
      </h1>
      <p class="mt-1 text-sm text-slate-500">
        Updating <strong>{coupon.title}</strong> ({coupon.code})
      </p>
    </div>

    <AdminCouponForm mode="edit" coupon={coupon} stores={stores} categories={categories} />
  </div>
</AdminLayout>
