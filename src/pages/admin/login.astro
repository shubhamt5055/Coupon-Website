---
import "../../styles/global.css";
import { getAuthenticatedAdmin, getAuthConfig } from "../../lib/auth";

const session = await getAuthenticatedAdmin(Astro.request);
if (session.authenticated) {
  return Astro.redirect("/admin");
}

const authConfig = getAuthConfig();
const nextUrl = Astro.url.searchParams.get("next") || "/admin";
const safeNext = nextUrl.startsWith("/admin") ? nextUrl : "/admin";
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — CouponHub | Save On Everything</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="flex min-h-screen flex-col justify-between bg-[#f4f7fb] text-slate-800 antialiased selection:bg-[#2491ef] selection:text-white">
    <!-- Top Nav (GrabOn Style) -->
    <header class="border-b border-slate-200 bg-white px-4 py-3 shadow-xs">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <a href="/" class="group flex items-center gap-2">
          <div class="flex items-center text-xl font-black tracking-tight text-[#191f2e]">
            <span>Coupon</span>
            <span class="text-[#2491ef]">Hub</span>
            <svg
              class="ml-1 h-3 w-5 text-[#60a600]"
              viewBox="0 0 24 12"
              fill="none"
              stroke="currentColor"
              stroke-width="3"
              stroke-linecap="round"
            >
              <path d="M2 2c5 8 15 8 20 0" />
            </svg>
          </div>
          <span class="rounded bg-[#60a600] px-1.5 py-0.5 text-[9px] font-extrabold uppercase text-white">
            &#x1F464;
          </span>
        </a>
        <a
          href="/"
          class="text-xs font-bold text-[#2491ef] hover:underline transition"
        >
          Live Website
        </a>
      </div>
    </header>

    <!-- Compact Centered Card -->
    <main class="flex flex-1 items-center justify-center px-4 py-8">
      <div class="w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 sm:p-8 shadow-xs">
        <div class="text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-xl bg-[#eef5ff] text-[#2491ef]">
            <svg
              class="h-5 w-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
          </div>
          <h1 class="mt-3 text-xl font-extrabold tracking-tight text-[#191f2e]">
            Admin Portal Access
          </h1>
          <p class="mt-1 text-xs text-slate-500">
            Authorized team members only. Secured with WebCrypto signed
            sessions.
          </p>
        </div>

        {!authConfig.configured && (
          <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-2.5 text-[11px] font-semibold text-amber-900">
            <strong>Setup Notice:</strong> Set <code>ADMIN_USERNAME</code>,{" "}
            <code>ADMIN_PASSWORD</code> in <code>.dev.vars</code> or Cloudflare
            Secrets.
          </div>
        )}

        <div
          id="login-error"
          class="mt-3 hidden rounded-lg border border-rose-200 bg-rose-50 p-2.5 text-xs font-semibold text-rose-700"
        ></div>

        <form id="login-form" class="mt-5 space-y-3.5" data-next={safeNext}>
          <div>
            <label
              for="username"
              class="mb-1 block text-xs font-bold text-[#191f2e] uppercase"
            >
              Admin Username
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              placeholder="Enter admin username"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>

          <div>
            <label
              for="password"
              class="mb-1 block text-xs font-bold text-[#191f2e] uppercase"
            >
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>

          <button
            type="submit"
            id="login-submit"
            class="w-full rounded-lg bg-[#2491ef] py-2.5 text-xs font-extrabold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
          >
            Sign In to Dashboard
          </button>
        </form>

        <div class="mt-5 border-t border-slate-100 pt-3 text-center">
          <a
            href="/"
            class="text-xs font-semibold text-[#2491ef] hover:underline transition"
          >
            ← Return to Public Website
          </a>
        </div>
      </div>
    </main>

    <!-- Compact Footer Bar -->
    <footer class="border-t border-slate-200 bg-white py-3 text-center text-xs font-medium text-slate-400">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
        <p>© {year} CouponHub — Save On Everything</p>
        <span class="text-[#2491ef] font-bold"> Protected Gateway</span>
      </div>
    </footer>

    <script>
      const form = document.getElementById(
        "login-form",
      ) as HTMLFormElement | null;
      const errorBox = document.getElementById("login-error");
      const submitBtn = document.getElementById(
        "login-submit",
      ) as HTMLButtonElement | null;

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (errorBox) errorBox.classList.add("hidden");
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Verifying...";
        }

        const formData = new FormData(form);
        const payload = {
          username: String(formData.get("username") || ""),
          password: String(formData.get("password") || ""),
        };

        try {
          const res = await fetch("/api/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = (await res.json()) as { ok?: boolean; error?: string };

          if (!res.ok || !data.ok) {
            if (errorBox) {
              errorBox.textContent =
                data.error || "Invalid username or password.";
              errorBox.classList.remove("hidden");
            }
            return;
          }

          window.location.href = form.dataset.next || "/admin";
        } catch {
          if (errorBox) {
            errorBox.textContent = "Network error. Please try again.";
            errorBox.classList.remove("hidden");
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Sign In to Dashboard";
          }
        }
      });
    </script>
  </body>
</html>
