---
import "../../styles/global.css";
import { getAuthenticatedAdmin, getAuthConfig } from "../../lib/auth";

const session = await getAuthenticatedAdmin(Astro.request);
if (session.authenticated) {
  return Astro.redirect("/admin");
}

const authConfig = getAuthConfig();
const nextUrl = Astro.url.searchParams.get("next") || "/admin";
const safeNext = nextUrl.startsWith("/admin") ? nextUrl : "/admin";
const year = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login — Couponly</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Force light mode only -->
    <script is:inline>
      (() => {
        document.documentElement.classList.remove("dark");
        try {
          localStorage.removeItem("couponhub-theme");
        } catch {}
      })();
    </script>
  </head>

  <body class="flex min-h-screen flex-col justify-between bg-[#F8FAFC] text-slate-900 antialiased selection:bg-[#0499FA]/20 selection:text-[#0499FA]">
    <!-- Mini Top Nav -->
    <header class="border-b border-slate-200/80 bg-white/95 px-4 py-3 backdrop-blur-md">
      <div class="mx-auto flex max-w-7xl items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5">
          <!-- Interlocking Double Ring Logo Icon -->
          <div class="flex h-8 w-8 items-center justify-center rounded-xl bg-[#0499FA] text-white shadow-xs group-hover:scale-105 transition-transform">
            <div class="relative flex items-center justify-center">
              <span class="inline-block h-3.5 w-3.5 rounded-full border-2 border-white -mr-1"></span>
              <span class="inline-block h-3.5 w-3.5 rounded-full border-2 border-[#FF7A18] -ml-1 bg-white"></span>
            </div>
          </div>
          <span class="text-base font-black tracking-tight text-[#081126]">
            Coupon<span class="text-[#0499FA]">ly</span>
            <span class="ml-1 rounded-md bg-[#EAF6FE] border border-[#0499FA]/30 px-1.5 py-0.5 text-[10px] font-bold text-[#0499FA] uppercase">Admin</span>
          </span>
        </a>
        <a href="/" class="text-xs font-bold text-[#0499FA] hover:text-[#FF7A18] transition">
          Live Website ↗
        </a>
      </div>
    </header>

    <!-- Compact Centered Card -->
    <main class="flex flex-1 items-center justify-center px-4 py-4 sm:py-6">
      <div class="w-full max-w-md rounded-3xl border border-slate-200/90 bg-white p-6 sm:p-7 shadow-xl shadow-slate-200/50">
        <div class="text-center">
          <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-2xl bg-[#0499FA] text-white shadow-md shadow-[#0499FA]/20">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
          </div>
          <h1 class="mt-3 text-xl font-black tracking-tight text-[#081126] sm:text-2xl">
            Admin Portal Access
          </h1>
          <p class="mt-1 text-xs font-medium text-slate-500">
            Authorized team members only. Secured with signed sessions.
          </p>
        </div>

        {!authConfig.configured && (
          <div class="mt-4 rounded-xl border border-amber-300 bg-amber-50 p-2.5 text-[11px] font-semibold text-amber-900">
            <strong>Setup Notice:</strong> Set <code>ADMIN_USERNAME</code>, <code>ADMIN_PASSWORD</code> in <code>.dev.vars</code> or Cloudflare Secrets.
          </div>
        )}

        <div
          id="login-error"
          class="mt-3 hidden rounded-xl border border-rose-200 bg-rose-50 p-2.5 text-xs font-semibold text-rose-700"
        ></div>

        <form id="login-form" class="mt-4 space-y-3" data-next={safeNext}>
          <div>
            <label for="username" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
              Admin Username
            </label>
            <input
              id="username"
              name="username"
              type="text"
              required
              autocomplete="username"
              placeholder="Enter admin username"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:bg-white focus:ring-4 focus:ring-[#0499FA]/15"
            />
          </div>

          <div>
            <label for="password" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
              Password
            </label>
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              placeholder="••••••••"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:bg-white focus:ring-4 focus:ring-[#0499FA]/15"
            />
          </div>

          <button
            type="submit"
            id="login-submit"
            class="w-full rounded-xl bg-[#0499FA] py-2.5 text-sm font-black text-white shadow-md shadow-[#0499FA]/20 transition hover:bg-[#0377C4] active:scale-98 disabled:opacity-60"
          >
            Sign In to Dashboard
          </button>
        </form>

        <div class="mt-4 border-t border-slate-100 pt-3 text-center">
          <a href="/" class="text-xs font-semibold text-[#0499FA] hover:text-[#FF7A18] transition">
            ← Return to Public Website
          </a>
        </div>
      </div>
    </main>

    <!-- Compact Footer Bar -->
    <footer class="border-t border-slate-200/80 bg-white py-3 text-center text-xs font-medium text-slate-400">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 sm:px-6">
        <p>© {year} Couponly Security Gateway</p>
        <span class="text-[#0499FA] font-bold">🔒 Protected Area</span>
      </div>
    </footer>

    <script>
      const form = document.getElementById("login-form") as HTMLFormElement | null;
      const errorBox = document.getElementById("login-error");
      const submitBtn = document.getElementById("login-submit") as HTMLButtonElement | null;

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (errorBox) errorBox.classList.add("hidden");
        if (submitBtn) {
          submitBtn.disabled = true;
          submitBtn.textContent = "Verifying...";
        }

        const formData = new FormData(form);
        const payload = {
          username: String(formData.get("username") || ""),
          password: String(formData.get("password") || ""),
        };

        try {
          const res = await fetch("/api/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(payload),
          });
          const data = (await res.json()) as { ok?: boolean; error?: string };

          if (!res.ok || !data.ok) {
            if (errorBox) {
              errorBox.textContent = data.error || "Invalid username or password.";
              errorBox.classList.remove("hidden");
            }
            return;
          }

          window.location.href = form.dataset.next || "/admin";
        } catch {
          if (errorBox) {
            errorBox.textContent = "Network error. Please try again.";
            errorBox.classList.remove("hidden");
          }
        } finally {
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.textContent = "Sign In to Dashboard";
          }
        }
      });
    </script>
  </body>
</html>
