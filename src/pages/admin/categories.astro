---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoriesWithCounts } from "../../lib/db";

const categories = await getCategoriesWithCounts(getDb());
const adminUser = Astro.locals.adminUser ?? "admin";
---

<AdminLayout title="Manage Categories — Admin | CouponHub" adminUser={adminUser}>
  <div class="grid gap-8 lg:grid-cols-3">
    <div class="lg:col-span-1">
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs">
        <h1 class="text-lg font-black text-[#081126]">Add Category</h1>
        <div id="cat-error" class="mt-4 hidden rounded-xl bg-rose-50 p-3 text-xs font-semibold text-rose-700"></div>

        <form id="add-cat-form" class="mt-4 space-y-4">
          <div>
            <label for="cat-name" class="mb-1 block text-xs font-bold uppercase text-slate-600">Category Name *</label>
            <input id="cat-name" name="name" type="text" required placeholder="e.g., Gaming" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm outline-none transition focus:border-[#0499FA] focus:bg-white focus:ring-4 focus:ring-[#0499FA]/15" />
          </div>
          <div>
            <label for="cat-slug" class="mb-1 block text-xs font-bold uppercase text-slate-600">Slug (auto if blank)</label>
            <input id="cat-slug" name="slug" type="text" placeholder="gaming" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm outline-none transition focus:border-[#0499FA] focus:bg-white focus:ring-4 focus:ring-[#0499FA]/15" />
          </div>
          <div>
            <label for="cat-icon" class="mb-1 block text-xs font-bold uppercase text-slate-600">Icon Emoji</label>
            <input id="cat-icon" name="icon" type="text" value="🏷️" class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm outline-none transition focus:border-[#0499FA] focus:bg-white focus:ring-4 focus:ring-[#0499FA]/15" />
          </div>
          <button type="submit" class="w-full rounded-xl bg-[#0499FA] py-2.5 text-sm font-bold text-white shadow-xs transition hover:bg-[#0377C4]">
            Add Category
          </button>
        </form>
      </div>
    </div>

    <div class="lg:col-span-2">
      <h2 class="mb-4 text-lg font-black text-[#081126]">
        Existing Categories ({categories.length})
      </h2>
      <div class="grid gap-4 sm:grid-cols-2">
        {categories.map((cat) => (
          <div data-cat-card={cat.id} class="flex items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4">
            <div class="flex items-center gap-3">
              <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-[#EAF6FE] border border-[#0499FA]/20 text-xl text-[#0499FA]">
                {cat.icon || "🏷️"}
              </span>
              <div>
                <p class="font-bold text-[#081126]">{cat.name}</p>
                <p class="text-xs text-slate-500">
                  /{cat.slug} · {cat.total_coupon_count ?? 0} coupons
                </p>
              </div>
            </div>
            <button
              type="button"
              data-delete-cat={cat.id}
              data-cat-name={cat.name}
              class="rounded-lg border border-rose-200 px-2.5 py-1 text-xs font-semibold text-rose-600 hover:bg-rose-50"
            >
              Delete
            </button>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>

<script>
  const form = document.getElementById("add-cat-form") as HTMLFormElement | null;
  const errorBox = document.getElementById("cat-error");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    errorBox?.classList.add("hidden");
    const fd = new FormData(form);
    const res = await fetch("/api/admin/categories", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: String(fd.get("name") || ""),
        slug: String(fd.get("slug") || ""),
        icon: String(fd.get("icon") || "🏷️"),
      }),
    });
    const data = (await res.json()) as { ok?: boolean; error?: string };
    if (!res.ok || !data.ok) {
      if (errorBox) {
        errorBox.textContent = data.error || "Could not create category.";
        errorBox.classList.remove("hidden");
      }
      return;
    }
    window.location.reload();
  });

  document.querySelectorAll<HTMLButtonElement>("[data-delete-cat]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const id = btn.dataset.deleteCat;
      const name = btn.dataset.catName || "this category";
      if (!confirm(`Delete "${name}" AND all coupons under it?`)) return;
      btn.disabled = true;
      try {
        const res = await fetch(`/api/admin/categories/${id}`, { method: "DELETE" });
        if (res.ok) {
          document.querySelector(`[data-cat-card="${id}"]`)?.remove();
        } else {
          alert("Failed to delete category.");
        }
      } catch {
        alert("Network error. Please try again.");
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
