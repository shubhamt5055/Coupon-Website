---
import MainLayout from "../layouts/MainLayout.astro";

const user = Astro.locals.user;
const nextParam = Astro.url.searchParams.get("next");
const safeNext =
  nextParam && nextParam.startsWith("/") && !nextParam.startsWith("//") && nextParam !== "/"
    ? nextParam
    : "/my-coupons";

const reason = Astro.url.searchParams.get("reason");
const initialMode = Astro.url.searchParams.get("mode") === "register" ? "register" : "login";

if (user) {
  return Astro.redirect(safeNext);
}
---

<MainLayout
  title="Sign In / Create Account — Couponly"
  description="Sign in with your registered account, or create a new account to share coupons and deals."
  compactFooter={true}
>
  <div class="mx-auto flex min-h-[calc(100vh-105px)] max-w-md items-center justify-center px-4 py-3 sm:py-5">
    <div class="w-full rounded-3xl border border-slate-200 bg-white p-5 sm:p-6 shadow-xl shadow-slate-200/50">
      <!-- Brand Icon & Header -->
      <div class="text-center">
        <!-- Interlocking Double Ring Logo Icon -->
        <div class="mx-auto flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-tr from-[#0499FA] to-[#0377C4] text-white shadow-md shadow-[#0499FA]/25">
          <div class="relative flex items-center justify-center">
            <span class="inline-block h-4 w-4 rounded-full border-2 border-white -mr-1"></span>
            <span class="inline-block h-4 w-4 rounded-full border-2 border-[#FF7A18] -ml-1 bg-white"></span>
          </div>
        </div>
        <h1 id="auth-title" class="mt-2 text-xl font-black tracking-tight text-[#081126] sm:text-2xl">
          Sign In to Couponly
        </h1>
        <p id="auth-subtitle" class="mt-0.5 text-xs font-medium text-slate-500">
          Sign in is available for registered users only.
        </p>
      </div>

      <!-- Mode Toggle Switch (Sign In vs Create Account) -->
      <div class="mt-3.5 flex rounded-xl bg-slate-100 p-1 border border-slate-200">
        <button
          type="button"
          id="tab-login-btn"
          class="flex-1 rounded-lg py-1.5 text-xs font-bold transition shadow-xs bg-[#0499FA] text-white"
        >
          Sign In
        </button>
        <button
          type="button"
          id="tab-register-btn"
          class="flex-1 rounded-lg py-1.5 text-xs font-bold transition text-slate-700 hover:text-[#0499FA]"
        >
          Create Account
        </button>
      </div>

      <!-- Context Reason Banner (e.g. from middleware) -->
      {reason === "signin-required" && (
        <div class="mt-2.5 rounded-xl border border-amber-200 bg-amber-50 p-2.5 text-xs font-semibold text-amber-900">
          🔒 <strong>Sign-in required:</strong> Please sign in or create an account to submit coupons.
        </div>
      )}

      <!-- Alert / Notice Box (Account Not Found or Guidance) -->
      <div
        id="auth-alert"
        class="mt-2.5 hidden rounded-xl border border-amber-300 bg-[#FFF9F5] p-2.5 text-xs font-semibold text-amber-900"
      >
        <div class="flex items-start gap-2">
          <span class="text-sm">⚠️</span>
          <div id="auth-alert-text"></div>
        </div>
      </div>

      <!-- Error Box -->
      <div
        id="auth-error"
        class="mt-2.5 hidden rounded-xl border border-rose-200 bg-rose-50 p-2.5 text-xs font-semibold text-rose-700"
      ></div>

      <!-- ==================== SIGN IN FORM ==================== -->
      <form id="sign-in-form" class="mt-3 space-y-2.5" data-next={safeNext}>
        <div class="rounded-xl border border-[#0499FA]/20 bg-[#EAF6FE] p-2 text-[11px] text-[#0499FA]">
          🔑 <strong>Note:</strong> Enter your registered email &amp; password. If no account exists, we'll guide you to create one.
        </div>

        <div>
          <label for="login-email" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
            Email Address
          </label>
          <input
            id="login-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:ring-2 focus:ring-[#0499FA]/20 focus:bg-white"
          />
        </div>

        <div>
          <label for="login-password" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
            Password
          </label>
          <input
            id="login-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:ring-2 focus:ring-[#0499FA]/20 focus:bg-white"
          />
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full rounded-xl bg-[#0499FA] py-2.5 text-sm font-black text-white shadow-md shadow-[#0499FA]/20 transition hover:bg-[#0377C4] active:scale-98 disabled:opacity-60"
        >
          Sign In to Account
        </button>

        <div class="pt-1.5 text-center text-xs text-slate-500">
          Don't have an account?{" "}
          <button
            type="button"
            id="switch-to-register-link"
            class="font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline"
          >
            Create account →
          </button>
        </div>
      </form>

      <!-- ==================== CREATE ACCOUNT FORM ==================== -->
      <form id="create-account-form" class="mt-3 hidden space-y-2.5" data-next={safeNext}>
        <div class="rounded-xl border border-[#FF7A18]/30 bg-[#FFF9F5] p-2 text-[11px] text-[#FF7A18]">
          ✨ <strong>Free Account:</strong> Create your account to upload promo codes and track deals.
        </div>

        <!-- 2-Column Responsive Grid so it never overflows desktop screen -->
        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label for="reg-name" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
              Full Name *
            </label>
            <input
              id="reg-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="e.g. Rahul S."
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:ring-2 focus:ring-[#0499FA]/20 focus:bg-white"
            />
          </div>

          <div>
            <label for="reg-email" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
              Email Address *
            </label>
            <input
              id="reg-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:ring-2 focus:ring-[#0499FA]/20 focus:bg-white"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-2.5">
          <div>
            <label for="reg-password" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
              Password (min 6) *
            </label>
            <input
              id="reg-password"
              name="password"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:ring-2 focus:ring-[#0499FA]/20 focus:bg-white"
            />
          </div>

          <div>
            <label for="reg-confirm" class="mb-1 block text-[11px] font-bold text-slate-700 uppercase">
              Confirm Pass *
            </label>
            <input
              id="reg-confirm"
              name="confirmPassword"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2 text-sm text-slate-900 outline-none transition focus:border-[#0499FA] focus:ring-2 focus:ring-[#0499FA]/20 focus:bg-white"
            />
          </div>
        </div>

        <button
          type="submit"
          id="reg-btn"
          class="w-full rounded-xl bg-[#FF7A18] py-2.5 text-sm font-black text-white shadow-md shadow-[#FF7A18]/25 transition hover:bg-[#E6680C] active:scale-98 disabled:opacity-60"
        >
          Create Account &amp; Continue
        </button>

        <div class="pt-1.5 text-center text-xs text-slate-500">
          Already have an account?{" "}
          <button
            type="button"
            id="switch-to-login-link"
            class="font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline"
          >
            Sign In here →
          </button>
        </div>
      </form>

      <!-- Admin link -->
      <div class="mt-3 border-t border-slate-100 pt-2 text-center">
        <a href="/admin/login" class="text-[11px] font-medium text-slate-400 hover:text-slate-600">
          Team Member? Admin Login
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<script define:vars={{ initialMode }}>
  const tabLoginBtn = document.getElementById("tab-login-btn");
  const tabRegisterBtn = document.getElementById("tab-register-btn");
  const signInForm = document.getElementById("sign-in-form");
  const createAccountForm = document.getElementById("create-account-form");
  const authTitle = document.getElementById("auth-title");
  const authSubtitle = document.getElementById("auth-subtitle");
  const authAlert = document.getElementById("auth-alert");
  const authAlertText = document.getElementById("auth-alert-text");
  const authError = document.getElementById("auth-error");

  const loginEmailInput = document.getElementById("login-email");
  const regNameInput = document.getElementById("reg-name");
  const regEmailInput = document.getElementById("reg-email");

  const loginBtn = document.getElementById("login-btn");
  const regBtn = document.getElementById("reg-btn");

  function setMode(mode, prefillEmail = "", alertMessage = "") {
    if (authError) authError.classList.add("hidden");

    if (alertMessage && authAlert && authAlertText) {
      authAlertText.innerHTML = alertMessage;
      authAlert.classList.remove("hidden");
    } else if (!alertMessage && authAlert) {
      authAlert.classList.add("hidden");
    }

    if (mode === "register") {
      signInForm?.classList.add("hidden");
      createAccountForm?.classList.remove("hidden");

      tabLoginBtn?.classList.remove("bg-[#0499FA]", "text-white", "shadow-xs");
      tabLoginBtn?.classList.add("text-slate-700");

      tabRegisterBtn?.classList.remove("text-slate-700");
      tabRegisterBtn?.classList.add("bg-[#0499FA]", "text-white", "shadow-xs");

      if (authTitle) authTitle.textContent = "Create an Account";
      if (authSubtitle) authSubtitle.textContent = "Fill in your details below to create your free account.";

      if (prefillEmail && regEmailInput) {
        regEmailInput.value = prefillEmail;
        regNameInput?.focus();
      }
    } else {
      createAccountForm?.classList.add("hidden");
      signInForm?.classList.remove("hidden");

      tabRegisterBtn?.classList.remove("bg-[#0499FA]", "text-white", "shadow-xs");
      tabRegisterBtn?.classList.add("text-slate-700");

      tabLoginBtn?.classList.remove("text-slate-700");
      tabLoginBtn?.classList.add("bg-[#0499FA]", "text-white", "shadow-xs");

      if (authTitle) authTitle.textContent = "Sign In to Couponly";
      if (authSubtitle) authSubtitle.textContent = "Sign in is available for registered users only.";

      if (prefillEmail && loginEmailInput) {
        loginEmailInput.value = prefillEmail;
      }
    }
  }

  // Initialize mode
  if (initialMode === "register") {
    setMode("register");
  }

  tabLoginBtn?.addEventListener("click", () => setMode("login"));
  tabRegisterBtn?.addEventListener("click", () => setMode("register"));
  document.getElementById("switch-to-register-link")?.addEventListener("click", () => setMode("register"));
  document.getElementById("switch-to-login-link")?.addEventListener("click", () => setMode("login"));

  // Handle Sign In Submit
  signInForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (authError) authError.classList.add("hidden");
    if (authAlert) authAlert.classList.add("hidden");

    if (loginBtn) {
      loginBtn.disabled = true;
      loginBtn.textContent = "Checking credentials...";
    }

    const formData = new FormData(signInForm);
    const email = String(formData.get("email") || "").trim();
    const password = String(formData.get("password") || "");

    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (data.notFound) {
          setMode(
            "register",
            email,
            `No account found! <strong>${email}</strong> is not registered yet. Please enter your name and password below to create your account.`
          );
          return;
        }

        if (authError) {
          authError.textContent = data.error || "Incorrect password. Please verify your password and try again.";
          authError.classList.remove("hidden");
        }
        return;
      }

      window.location.href = signInForm.dataset.next || "/my-coupons";
    } catch {
      if (authError) {
        authError.textContent = "Network error. Please try again.";
        authError.classList.remove("hidden");
      }
    } finally {
      if (loginBtn) {
        loginBtn.disabled = false;
        loginBtn.textContent = "Sign In to Account";
      }
    }
  });

  // Handle Create Account Submit
  createAccountForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (authError) authError.classList.add("hidden");

    const formData = new FormData(createAccountForm);
    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const password = String(formData.get("password") || "");
    const confirmPassword = String(formData.get("confirmPassword") || "");

    if (password !== confirmPassword) {
      if (authError) {
        authError.textContent = "Passwords do not match. Please ensure both passwords match.";
        authError.classList.remove("hidden");
      }
      return;
    }

    if (regBtn) {
      regBtn.disabled = true;
      regBtn.textContent = "Creating your account...";
    }

    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password, confirmPassword }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (authError) {
          authError.textContent = data.error || "Failed to create account. Please try again.";
          authError.classList.remove("hidden");
        }
        return;
      }

      window.location.href = createAccountForm.dataset.next || "/my-coupons";
    } catch {
      if (authError) {
        authError.textContent = "Network error. Please try again.";
        authError.classList.remove("hidden");
      }
    } finally {
      if (regBtn) {
        regBtn.disabled = false;
        regBtn.textContent = "Create Account & Continue";
      }
    }
  });
</script>
