---
import MainLayout from "../layouts/MainLayout.astro";

const user = Astro.locals.user;
const nextParam = Astro.url.searchParams.get("next");
const safeNext =
  nextParam &&
  nextParam.startsWith("/") &&
  !nextParam.startsWith("//") &&
  nextParam !== "/"
    ? nextParam
    : "/my-coupons";

const reason = Astro.url.searchParams.get("reason");
const initialMode =
  Astro.url.searchParams.get("mode") === "register" ? "register" : "login";

if (user) {
  return Astro.redirect(safeNext);
}
---

<MainLayout
  title="Sign In / Create Account — CouponHub | Save On Everything"
  description="Sign in with your registered account, or create a free account to share and manage coupons on CouponHub."
  compactFooter={true}
>
  <div class="mx-auto grid min-h-[calc(100vh-140px)] max-w-5xl items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-2 lg:px-8">
    <!-- Left: Pitch (Desktop only, GrabOn Style) -->
    <div class="hidden lg:block text-[#191f2e]">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#2491ef]/20 bg-[#eef5ff] px-3.5 py-1 text-xs font-bold text-[#2491ef] shadow-2xs">
        <span class="h-2 w-2 rounded-full bg-[#60a600] animate-soft-pulse"></span>
        <span>100% Free For All Shoppers</span>
      </div>

      <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">
        Share Deals.
        <span class="block text-[#2491ef]">Save Together.</span>
      </h1>

      <p class="mt-3 max-w-md text-xs sm:text-sm font-medium leading-relaxed text-slate-600">
        Create an account to submit tested promo codes, track your deals, and help millions of smart shoppers save money at checkout.
      </p>

      <div class="mt-6 space-y-3.5 text-xs font-semibold text-slate-700">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#eef5ff] text-[#2491ef] font-bold">
            🎟️
          </span>
          <span>Submit your own discount vouchers &amp; codes</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#f0fdf4] text-[#60a600] font-bold">
            📊
          </span>
          <span>Track live redemptions and community votes</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-orange-50 text-[#ff5722] font-bold">
            ⚡
          </span>
          <span>Instant auto-approval upon editorial verification</span>
        </div>
      </div>
    </div>

    <!-- Right: Auth Card (GrabOn Style) -->
    <div class="mx-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <!-- Brand & Header -->
      <div class="text-center">
        <a href="/" class="inline-flex flex-col items-center">
          <div class="flex items-center text-2xl font-black tracking-tight text-[#191f2e]">
            <span>Coupon</span>
            <span class="text-[#2491ef]">Hub</span>
            <svg class="ml-1 h-3.5 w-6 text-[#60a600]" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
              <path d="M2 2c5 8 15 8 20 0" />
            </svg>
          </div>
          <span class="text-[9px] font-extrabold tracking-widest text-[#60a600] uppercase mt-0.5">
            SAVE ON EVERYTHING
          </span>
        </a>

        <h2 id="auth-title" class="mt-4 text-xl font-extrabold text-[#191f2e]">
          Sign In to CouponHub
        </h2>
        <p id="auth-subtitle" class="mt-0.5 text-xs text-slate-500">
          Enter your registered email and password to access your account.
        </p>
      </div>

      <!-- Mode Tabs (GrabOn Style) -->
      <div class="mt-5 flex rounded-lg border border-slate-200 bg-slate-100 p-1">
        <button
          type="button"
          id="tab-login-btn"
          class="flex-1 rounded-md bg-[#2491ef] py-2 text-xs font-bold text-white shadow-2xs transition"
        >
          Sign In
        </button>
        <button
          type="button"
          id="tab-register-btn"
          class="flex-1 rounded-md py-2 text-xs font-bold text-slate-600 transition hover:text-[#2491ef]"
        >
          Create Account
        </button>
      </div>

      {reason === "signin-required" && (
        <div class="mt-3.5 rounded-lg border border-amber-200 bg-amber-50 p-2.5 text-xs font-semibold text-amber-900">
          🔒 <strong>Sign-in required:</strong> Please sign in or create an account to submit coupons.
        </div>
      )}

      <div
        id="auth-alert"
        class="mt-3.5 hidden rounded-lg border border-amber-300 bg-amber-50 p-3 text-xs font-semibold text-amber-900"
      >
        <div class="flex items-start gap-2">
          <span class="text-sm">⚠️</span>
          <div id="auth-alert-text"></div>
        </div>
      </div>

      <div
        id="auth-error"
        class="mt-3.5 hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs font-semibold text-rose-700"
      ></div>

      <!-- SIGN IN FORM -->
      <form id="sign-in-form" class="mt-5 space-y-4" data-next={safeNext}>
        <div>
          <label for="login-email" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Email Address
          </label>
          <input
            id="login-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>
        <div>
          <label for="login-password" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Password
          </label>
          <input
            id="login-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full rounded-lg bg-[#2491ef] py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
        >
          Sign In to Account
        </button>

        <p class="text-center text-xs text-slate-500">
          Don’t have an account?
          <button
            type="button"
            id="switch-to-register-link"
            class="font-bold text-[#2491ef] hover:underline"
          >
            Create account →
          </button>
        </p>
      </form>

      <!-- CREATE ACCOUNT FORM -->
      <form
        id="create-account-form"
        class="mt-5 hidden space-y-4"
        data-next={safeNext}
      >
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-name" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Full Name *
            </label>
            <input
              id="reg-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="e.g. Rahul S."
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
          <div>
            <label for="reg-email" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Email *
            </label>
            <input
              id="reg-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-password" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Password *
            </label>
            <input
              id="reg-password"
              name="password"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
          <div>
            <label for="reg-confirm" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Confirm Password *
            </label>
            <input
              id="reg-confirm"
              name="confirmPassword"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
        </div>

        <button
          type="submit"
          id="reg-btn"
          class="w-full rounded-lg bg-[#2491ef] py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
        >
          Create Account &amp; Continue
        </button>

        <p class="text-center text-xs text-slate-500">
          Already have an account?
          <button
            type="button"
            id="switch-to-login-link"
            class="font-bold text-[#2491ef] hover:underline"
          >
            Sign in here →
          </button>
        </p>
      </form>

      <div class="mt-5 border-t border-slate-100 pt-3 text-center">
        <a
          href="/admin/login"
          class="text-[11px] font-medium text-slate-400 hover:text-slate-600"
        >
          Team member? Admin login
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<script define:vars={{ initialMode }}>
  const tabLoginBtn = document.getElementById("tab-login-btn");
  const tabRegisterBtn = document.getElementById("tab-register-btn");
  const signInForm = document.getElementById("sign-in-form");
  const createAccountForm = document.getElementById("create-account-form");
  const authTitle = document.getElementById("auth-title");
  const authSubtitle = document.getElementById("auth-subtitle");
  const authAlert = document.getElementById("auth-alert");
  const authAlertText = document.getElementById("auth-alert-text");
  const authError = document.getElementById("auth-error");

  const loginEmailInput = document.getElementById("login-email");
  const regNameInput = document.getElementById("reg-name");
  const regEmailInput = document.getElementById("reg-email");

  const loginBtn = document.getElementById("login-btn");
  const regBtn = document.getElementById("reg-btn");

  function setMode(mode, prefillEmail = "", alertMessage = "") {
    if (authError) authError.classList.add("hidden");

    if (alertMessage && authAlert && authAlertText) {
      authAlertText.innerHTML = alertMessage;
      authAlert.classList.remove("hidden");
    } else if (!alertMessage && authAlert) {
      authAlert.classList.add("hidden");
    }

    if (mode === "register") {
      signInForm?.classList.add("hidden");
      createAccountForm?.classList.remove("hidden");

      tabLoginBtn?.classList.remove("bg-[#2491ef]", "text-white", "shadow-2xs");
      tabLoginBtn?.classList.add("text-slate-600");

      tabRegisterBtn?.classList.remove("text-slate-600");
      tabRegisterBtn?.classList.add("bg-[#2491ef]", "text-white", "shadow-2xs");

      if (authTitle) authTitle.textContent = "Create an Account";
      if (authSubtitle)
        authSubtitle.textContent =
          "Fill in your details below to create your free account.";

      if (prefillEmail && regEmailInput) {
        regEmailInput.value = prefillEmail;
        regNameInput?.focus();
      }
    } else {
      createAccountForm?.classList.add("hidden");
      signInForm?.classList.remove("hidden");

      tabRegisterBtn?.classList.remove(
        "bg-[#2491ef]",
        "text-white",
        "shadow-2xs",
      );
      tabRegisterBtn?.classList.add("text-slate-600");

      tabLoginBtn?.classList.remove("text-slate-600");
      tabLoginBtn?.classList.add("bg-[#2491ef]", "text-white", "shadow-2xs");

      if (authTitle) authTitle.textContent = "Sign In to CouponHub";
      if (authSubtitle)
        authSubtitle.textContent =
          "Sign in is available for registered users only.";

      if (prefillEmail && loginEmailInput) {
        loginEmailInput.value = prefillEmail;
      }
    }
  }

  // Initialize mode
  if (initialMode === "register") {
    setMode("register");
  }

  tabLoginBtn?.addEventListener("click", () => setMode("login"));
  tabRegisterBtn?.addEventListener("click", () => setMode("register"));
  document
    .getElementById("switch-to-register-link")
    ?.addEventListener("click", () => setMode("register"));
  document
    .getElementById("switch-to-login-link")
    ?.addEventListener("click", () => setMode("login"));

  // Handle Sign In Submit
  signInForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (authError) authError.classList.add("hidden");
    if (authAlert) authAlert.classList.add("hidden");

    if (loginBtn) {
      loginBtn.disabled = true;
      loginBtn.textContent = "Checking credentials...";
    }

    const formData = new FormData(signInForm);
    const email = String(formData.get("email") || "").trim();
    const password = String(formData.get("password") || "");

    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (data.notFound) {
          setMode(
            "register",
            email,
            `No account found! <strong>${email}</strong> is not registered yet. Please enter your name and password below to create your account.`,
          );
          return;
        }

        if (authError) {
          authError.textContent =
            data.error ||
            "Incorrect password. Please verify your password and try again.";
          authError.classList.remove("hidden");
        }
        return;
      }

      window.location.href = signInForm.dataset.next || "/my-coupons";
    } catch {
      if (authError) {
        authError.textContent = "Network error. Please try again.";
        authError.classList.remove("hidden");
      }
    } finally {
      if (loginBtn) {
        loginBtn.disabled = false;
        loginBtn.textContent = "Sign In to Account";
      }
    }
  });

  // Handle Create Account Submit
  createAccountForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (authError) authError.classList.add("hidden");

    const formData = new FormData(createAccountForm);
    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const password = String(formData.get("password") || "");
    const confirmPassword = String(formData.get("confirmPassword") || "");

    if (password !== confirmPassword) {
      if (authError) {
        authError.textContent =
          "Passwords do not match. Please ensure both passwords match.";
        authError.classList.remove("hidden");
      }
      return;
    }

    if (regBtn) {
      regBtn.disabled = true;
      regBtn.textContent = "Creating your account...";
    }

    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password, confirmPassword }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (authError) {
          authError.textContent =
            data.error || "Failed to create account. Please try again.";
          authError.classList.remove("hidden");
        }
        return;
      }

      window.location.href = createAccountForm.dataset.next || "/my-coupons";
    } catch {
      if (authError) {
        authError.textContent = "Network error. Please try again.";
        authError.classList.remove("hidden");
      }
    } finally {
      if (regBtn) {
        regBtn.disabled = false;
        regBtn.textContent = "Create Account & Continue";
      }
    }
  });
</script>
