---
import MainLayout from "../layouts/MainLayout.astro";

const user = Astro.locals.user;
const nextParam = Astro.url.searchParams.get("next");
const safeNext =
  nextParam &&
  nextParam.startsWith("/") &&
  !nextParam.startsWith("//") &&
  nextParam !== "/"
    ? nextParam
    : "/my-coupons";

const reason = Astro.url.searchParams.get("reason");
const initialMode =
  Astro.url.searchParams.get("mode") === "register" ? "register" : "login";

if (user) {
  return Astro.redirect(safeNext);
}
---

<MainLayout
  title="Sign In / Create Account — CouponHub | Save On Everything"
  description="Sign in with your Google account or email to share and manage coupons on CouponHub."
  compactFooter={true}
>
  <div class="mx-auto grid min-h-[calc(100vh-140px)] max-w-5xl items-center gap-10 px-4 py-10 sm:px-6 lg:grid-cols-2 lg:px-8">
    <!-- Left: Pitch (Desktop only, GrabOn Style) -->
    <div class="hidden lg:block text-[#191f2e]">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#2491ef]/20 bg-[#eef5ff] px-3.5 py-1 text-xs font-bold text-[#2491ef] shadow-2xs">
        <span class="h-2 w-2 rounded-full bg-[#60a600] animate-soft-pulse"></span>
        <span>100% Free For All Shoppers</span>
      </div>

      <h1 class="mt-4 text-4xl font-extrabold tracking-tight sm:text-5xl">
        Share Deals.
        <span class="block text-[#2491ef]">Save Together.</span>
      </h1>

      <p class="mt-3 max-w-md text-xs sm:text-sm font-medium leading-relaxed text-slate-600">
        Sign in to view your submitted coupons, track real-time redemptions, and help millions of smart shoppers save money at checkout.
      </p>

      <div class="mt-6 space-y-3.5 text-xs font-semibold text-slate-700">
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#eef5ff] text-[#2491ef] font-bold">
            🎟️
          </span>
          <span>Submit promo codes without even signing in</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-[#f0fdf4] text-[#60a600] font-bold">
            ⚡
          </span>
          <span>Instant live publishing — zero admin waiting</span>
        </div>
        <div class="flex items-center gap-3">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-[#60a600] font-bold">
            📊
          </span>
          <span>One-click Google login to manage all your submitted deals</span>
        </div>
      </div>
    </div>

    <!-- Right: Auth Card (GrabOn Style) -->
    <div class="mx-auto w-full max-w-md rounded-xl border border-slate-200 bg-white p-6 shadow-xs sm:p-8">
      <!-- Brand & Header -->
      <div class="text-center">
        <a href="/" class="inline-flex flex-col items-center">
          <div class="flex items-center text-2xl font-black tracking-tight text-[#191f2e]">
            <span>Coupon</span>
            <span class="text-[#2491ef]">Hub</span>
            <svg class="ml-1 h-3.5 w-6 text-[#60a600]" viewBox="0 0 24 12" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round">
              <path d="M2 2c5 8 15 8 20 0" />
            </svg>
          </div>
          <span class="text-[9px] font-extrabold tracking-widest text-[#60a600] uppercase mt-0.5">
            SAVE ON EVERYTHING
          </span>
        </a>

        <h2 id="auth-title" class="mt-4 text-xl font-extrabold text-[#191f2e]">
          Sign In to CouponHub
        </h2>
        <p id="auth-subtitle" class="mt-0.5 text-xs text-slate-500">
          Sign in with your Google account or email to view your coupons.
        </p>
      </div>

      <!-- Prominent Google Sign-In Button -->
      <div class="mt-6">
        <button
          type="button"
          id="login-google-btn"
          class="w-full flex items-center justify-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-xs sm:text-sm font-bold text-slate-700 shadow-2xs transition hover:bg-slate-50 hover:border-slate-400 active:scale-98"
        >
          <!-- Multi-color Google SVG -->
          <svg class="h-4 w-4 sm:h-5 sm:w-5 shrink-0" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span>Continue with Google</span>
        </button>
      </div>

      <!-- Divider -->
      <div class="relative my-4">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
        <div class="relative flex justify-center text-[10px] uppercase tracking-wider"><span class="bg-white px-2 text-slate-400 font-bold">Or with email &amp; password</span></div>
      </div>

      <!-- Mode Tabs (GrabOn Style) -->
      <div class="flex rounded-lg border border-slate-200 bg-slate-100 p-1">
        <button
          type="button"
          id="tab-login-btn"
          class="flex-1 rounded-md bg-[#2491ef] py-2 text-xs font-bold text-white shadow-2xs transition"
        >
          Sign In
        </button>
        <button
          type="button"
          id="tab-register-btn"
          class="flex-1 rounded-md py-2 text-xs font-bold text-slate-600 transition hover:text-[#2491ef]"
        >
          Create Account
        </button>
      </div>

      {reason === "signin-required" && (
        <div class="mt-3.5 rounded-lg border border-amber-200 bg-amber-50 p-2.5 text-xs font-semibold text-amber-900">
          🔒 <strong>Sign-in required:</strong> Please sign in to view and manage your account.
        </div>
      )}

      <div
        id="auth-alert"
        class="mt-3.5 hidden rounded-lg border border-amber-300 bg-amber-50 p-3 text-xs font-semibold text-amber-900"
      >
        <div class="flex items-start gap-2">
          <span class="text-sm">⚠️</span>
          <div id="auth-alert-text"></div>
        </div>
      </div>

      <div
        id="auth-error"
        class="mt-3.5 hidden rounded-lg border border-rose-200 bg-rose-50 p-3 text-xs font-semibold text-rose-700"
      ></div>

      <!-- SIGN IN FORM -->
      <form id="sign-in-form" class="mt-5 space-y-4" data-next={safeNext}>
        <div>
          <label for="login-email" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Email Address
          </label>
          <input
            id="login-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            placeholder="you@example.com"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>
        <div>
          <label for="login-password" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Password
          </label>
          <input
            id="login-password"
            name="password"
            type="password"
            required
            autocomplete="current-password"
            placeholder="••••••••"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full rounded-lg bg-[#2491ef] py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
        >
          Sign In to Account
        </button>

        <p class="text-center text-xs text-slate-500">
          Don’t have an account?
          <button
            type="button"
            id="switch-to-register-link"
            class="font-bold text-[#2491ef] hover:underline"
          >
            Create account →
          </button>
        </p>
      </form>

      <!-- CREATE ACCOUNT FORM -->
      <form
        id="create-account-form"
        class="mt-5 hidden space-y-4"
        data-next={safeNext}
      >
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-name" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Full Name *
            </label>
            <input
              id="reg-name"
              name="name"
              type="text"
              required
              autocomplete="name"
              placeholder="e.g. Rahul S."
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
          <div>
            <label for="reg-email" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Email *
            </label>
            <input
              id="reg-email"
              name="email"
              type="email"
              required
              autocomplete="email"
              placeholder="you@example.com"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="reg-password" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Password *
            </label>
            <input
              id="reg-password"
              name="password"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
          <div>
            <label for="reg-confirm" class="mb-1 block text-xs font-bold text-[#191f2e]">
              Confirm Password *
            </label>
            <input
              id="reg-confirm"
              name="confirmPassword"
              type="password"
              required
              minlength="6"
              autocomplete="new-password"
              placeholder="••••••••"
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3 py-2.5 text-xs sm:text-sm text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
            />
          </div>
        </div>

        <button
          type="submit"
          id="reg-btn"
          class="w-full rounded-lg bg-[#2491ef] py-2.5 text-xs font-bold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
        >
          Create Account &amp; Continue
        </button>

        <p class="text-center text-xs text-slate-500">
          Already have an account?
          <button
            type="button"
            id="switch-to-login-link"
            class="font-bold text-[#2491ef] hover:underline"
          >
            Sign in here →
          </button>
        </p>
      </form>

      <div class="mt-5 border-t border-slate-100 pt-3 text-center">
        <a
          href="/admin/login"
          class="text-[11px] font-medium text-slate-400 hover:text-slate-600"
        >
          Team member? Admin login
        </a>
      </div>
    </div>
  </div>

  <!-- GOOGLE SIGN-IN INTERACTIVE MODAL -->
  <div id="login-google-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl transition">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <!-- Google Icon -->
          <svg class="h-5 w-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <h3 class="text-sm font-bold text-[#191f2e]">Continue with Google</h3>
        </div>
        <button type="button" id="close-login-google-modal" class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600">
          ✕
        </button>
      </div>

      <p class="mt-3 text-xs text-slate-500">
        Enter your Google account email to sign in instantly or access your submitted coupons.
      </p>

      <form id="login-google-form" class="mt-4 space-y-3.5" data-next={safeNext}>
        <div>
          <label for="modal-google-email" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Google Email Address *
          </label>
          <input
            id="modal-google-email"
            type="email"
            required
            placeholder="you@gmail.com"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>

        <div>
          <label for="modal-google-name" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Your Name (Optional)
          </label>
          <input
            id="modal-google-name"
            type="text"
            placeholder="e.g. Rahul S."
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>

        <div id="modal-google-error" class="hidden rounded-lg bg-rose-50 p-2.5 text-xs font-semibold text-rose-700"></div>

        <div class="mt-5 flex gap-2.5">
          <button
            type="button"
            id="cancel-login-google-btn"
            class="flex-1 rounded-lg border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="confirm-login-google-btn"
            class="flex-1 rounded-lg bg-[#2491ef] py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
          >
            Sign In with Google
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script define:vars={{ initialMode }}>
  const tabLoginBtn = document.getElementById("tab-login-btn");
  const tabRegisterBtn = document.getElementById("tab-register-btn");
  const signInForm = document.getElementById("sign-in-form");
  const createAccountForm = document.getElementById("create-account-form");
  const authTitle = document.getElementById("auth-title");
  const authSubtitle = document.getElementById("auth-subtitle");
  const authAlert = document.getElementById("auth-alert");
  const authAlertText = document.getElementById("auth-alert-text");
  const authError = document.getElementById("auth-error");

  const loginEmailInput = document.getElementById("login-email");
  const regNameInput = document.getElementById("reg-name");
  const regEmailInput = document.getElementById("reg-email");

  const loginBtn = document.getElementById("login-btn");
  const regBtn = document.getElementById("reg-btn");

  // Google Modal Controls
  const googleBtn = document.getElementById("login-google-btn");
  const googleModal = document.getElementById("login-google-modal");
  const closeModalBtn = document.getElementById("close-login-google-modal");
  const cancelModalBtn = document.getElementById("cancel-login-google-btn");
  const googleForm = document.getElementById("login-google-form");
  const googleEmailInput = document.getElementById("modal-google-email") as HTMLInputElement | null;
  const googleNameInput = document.getElementById("modal-google-name") as HTMLInputElement | null;
  const googleErrorMsg = document.getElementById("modal-google-error");
  const confirmGoogleBtn = document.getElementById("confirm-login-google-btn") as HTMLButtonElement | null;

  function openGoogleModal() {
    if (googleModal) {
      googleModal.classList.remove("hidden");
      googleModal.classList.add("flex");
      googleEmailInput?.focus();
    }
  }

  function closeGoogleModal() {
    if (googleModal) {
      googleModal.classList.add("hidden");
      googleModal.classList.remove("flex");
    }
    if (googleErrorMsg) googleErrorMsg.classList.add("hidden");
  }

  googleBtn?.addEventListener("click", openGoogleModal);
  closeModalBtn?.addEventListener("click", closeGoogleModal);
  cancelModalBtn?.addEventListener("click", closeGoogleModal);

  googleForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (googleErrorMsg) googleErrorMsg.classList.add("hidden");
    const email = googleEmailInput?.value.trim();
    const name = googleNameInput?.value.trim();

    if (!email || !email.includes("@")) {
      if (googleErrorMsg) {
        googleErrorMsg.textContent = "Please enter a valid Google email address.";
        googleErrorMsg.classList.remove("hidden");
      }
      return;
    }

    if (confirmGoogleBtn) {
      confirmGoogleBtn.disabled = true;
      confirmGoogleBtn.textContent = "Connecting Google...";
    }

    try {
      const res = await fetch("/api/auth/google", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, name }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (googleErrorMsg) {
          googleErrorMsg.textContent = data.error || "Google sign-in failed. Please try again.";
          googleErrorMsg.classList.remove("hidden");
        }
        return;
      }

      window.location.href = googleForm.dataset.next || "/my-coupons";
    } catch {
      if (googleErrorMsg) {
        googleErrorMsg.textContent = "Network error. Please try again.";
        googleErrorMsg.classList.remove("hidden");
      }
    } finally {
      if (confirmGoogleBtn) {
        confirmGoogleBtn.disabled = false;
        confirmGoogleBtn.textContent = "Sign In with Google";
      }
    }
  });

  function setMode(mode, prefillEmail = "", alertMessage = "") {
    if (authError) authError.classList.add("hidden");

    if (alertMessage && authAlert && authAlertText) {
      authAlertText.innerHTML = alertMessage;
      authAlert.classList.remove("hidden");
    } else if (!alertMessage && authAlert) {
      authAlert.classList.add("hidden");
    }

    if (mode === "register") {
      signInForm?.classList.add("hidden");
      createAccountForm?.classList.remove("hidden");

      tabLoginBtn?.classList.remove("bg-[#2491ef]", "text-white", "shadow-2xs");
      tabLoginBtn?.classList.add("text-slate-600");

      tabRegisterBtn?.classList.remove("text-slate-600");
      tabRegisterBtn?.classList.add("bg-[#2491ef]", "text-white", "shadow-2xs");

      if (authTitle) authTitle.textContent = "Create an Account";
      if (authSubtitle)
        authSubtitle.textContent =
          "Fill in your details below to create your free account.";

      if (prefillEmail && regEmailInput) {
        regEmailInput.value = prefillEmail;
        regNameInput?.focus();
      }
    } else {
      createAccountForm?.classList.add("hidden");
      signInForm?.classList.remove("hidden");

      tabRegisterBtn?.classList.remove(
        "bg-[#2491ef]",
        "text-white",
        "shadow-2xs",
      );
      tabRegisterBtn?.classList.add("text-slate-600");

      tabLoginBtn?.classList.remove("text-slate-600");
      tabLoginBtn?.classList.add("bg-[#2491ef]", "text-white", "shadow-2xs");

      if (authTitle) authTitle.textContent = "Sign In to CouponHub";
      if (authSubtitle)
        authSubtitle.textContent =
          "Sign in with your registered email and password.";

      if (prefillEmail && loginEmailInput) {
        loginEmailInput.value = prefillEmail;
      }
    }
  }

  // Initialize mode
  if (initialMode === "register") {
    setMode("register");
  }

  tabLoginBtn?.addEventListener("click", () => setMode("login"));
  tabRegisterBtn?.addEventListener("click", () => setMode("register"));
  document
    .getElementById("switch-to-register-link")
    ?.addEventListener("click", () => setMode("register"));
  document
    .getElementById("switch-to-login-link")
    ?.addEventListener("click", () => setMode("login"));

  // Handle Sign In Submit
  signInForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (authError) authError.classList.add("hidden");
    if (authAlert) authAlert.classList.add("hidden");

    if (loginBtn) {
      loginBtn.disabled = true;
      loginBtn.textContent = "Checking credentials...";
    }

    const formData = new FormData(signInForm);
    const email = String(formData.get("email") || "").trim();
    const password = String(formData.get("password") || "");

    try {
      const res = await fetch("/api/auth/login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, password }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (data.notFound) {
          setMode(
            "register",
            email,
            `No account found! <strong>${email}</strong> is not registered yet. Please enter your name and password below to create your account.`,
          );
          return;
        }

        if (authError) {
          authError.textContent =
            data.error ||
            "Incorrect password. Please verify your password and try again.";
          authError.classList.remove("hidden");
        }
        return;
      }

      window.location.href = signInForm.dataset.next || "/my-coupons";
    } catch {
      if (authError) {
        authError.textContent = "Network error. Please try again.";
        authError.classList.remove("hidden");
      }
    } finally {
      if (loginBtn) {
        loginBtn.disabled = false;
        loginBtn.textContent = "Sign In to Account";
      }
    }
  });

  // Handle Create Account Submit
  createAccountForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (authError) authError.classList.add("hidden");

    const formData = new FormData(createAccountForm);
    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const password = String(formData.get("password") || "");
    const confirmPassword = String(formData.get("confirmPassword") || "");

    if (password !== confirmPassword) {
      if (authError) {
        authError.textContent =
          "Passwords do not match. Please ensure both passwords match.";
        authError.classList.remove("hidden");
      }
      return;
    }

    if (regBtn) {
      regBtn.disabled = true;
      regBtn.textContent = "Creating your account...";
    }

    try {
      const res = await fetch("/api/auth/register", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ name, email, password, confirmPassword }),
      });
      const data = await res.json();

      if (!res.ok || !data.ok) {
        if (authError) {
          authError.textContent =
            data.error || "Failed to create account. Please try again.";
          authError.classList.remove("hidden");
        }
        return;
      }

      window.location.href = createAccountForm.dataset.next || "/my-coupons";
    } catch {
      if (authError) {
        authError.textContent = "Network error. Please try again.";
        authError.classList.remove("hidden");
      }
    } finally {
      if (regBtn) {
        regBtn.disabled = false;
        regBtn.textContent = "Create Account & Continue";
      }
    }
  });
</script>
