---
import MainLayout from "../layouts/MainLayout.astro";
import CouponCard from "../components/CouponCard.astro";
import { getDb } from "../lib/cloudflare";
import { getCoupons, getUserStats } from "../lib/db";
import { formatDisplayDate, isCouponExpired } from "../lib/format";

const user = Astro.locals.user;
const db = getDb();

let stats = { totalCoupons: 0, activeCoupons: 0, pendingCoupons: 0, totalClicks: 0 };
let coupons: any[] = [];

if (user) {
  const [userStats, userCoupons] = await Promise.all([
    getUserStats(db, user.id),
    getCoupons(db, {
      userId: user.id,
      includeExpired: true,
      includeInactive: true,
      sort: "newest",
    }),
  ]);
  stats = userStats;
  coupons = userCoupons;
}

const submittedParam = Astro.url.searchParams.get("submitted");
const justSubmitted = Boolean(submittedParam);
---

<MainLayout
  title="My Submitted Coupons — CouponHub | Save On Everything"
  description="Manage the coupons and promo codes you have shared on CouponHub."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    {user ? (
      <div>
        <!-- Header (GrabOn Style) -->
        <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#2491ef] text-base font-extrabold text-white shadow-2xs">
              {user.name.charAt(0).toUpperCase()}
            </span>
            <div>
              <h1 class="text-2xl font-extrabold tracking-tight text-[#191f2e] sm:text-3xl">
                My Submitted Coupons
              </h1>
              <p class="text-xs font-medium text-slate-500">
                Logged in as <strong class="text-[#191f2e]">{user.name}</strong> ({user.email})
              </p>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2.5">
            <a
              href="/submit-coupon"
              class="rounded-lg bg-[#2491ef] px-4 py-2 text-xs font-bold text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95"
            >
              + Share Another Coupon
            </a>
          </div>
        </div>

        <!-- Celebration Banner -->
        {justSubmitted && (
          <div class="mb-8 rounded-xl border border-emerald-200 bg-emerald-50 p-4 text-emerald-900 shadow-2xs">
            <div class="flex items-center gap-3">
              <span class="text-2xl">🎉</span>
              <div>
                <p class="text-xs sm:text-sm font-bold text-[#191f2e]">Your coupon is published live immediately!</p>
                <p class="mt-0.5 text-xs text-slate-600">
                  No waiting for admin verification. Shoppers across CouponHub can now discover and use your deal.
                </p>
              </div>
            </div>
          </div>
        )}

        <!-- Stats Grid (GrabOn Style) -->
        <div class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xs">
            <p class="text-xs font-bold text-slate-500 uppercase">Total Submitted</p>
            <p class="mt-1 text-2xl font-extrabold text-[#191f2e]">{stats.totalCoupons}</p>
          </div>

          <div class="rounded-xl border border-[#2491ef]/20 bg-[#eef5ff] p-4 sm:p-5 shadow-2xs">
            <p class="text-xs font-bold text-[#2491ef] uppercase">Live &amp; Active</p>
            <p class="mt-1 text-2xl font-extrabold text-[#2491ef]">{stats.activeCoupons}</p>
          </div>

          <div class="rounded-xl border border-emerald-200 bg-emerald-50/50 p-4 sm:p-5 shadow-2xs">
            <p class="text-xs font-bold text-emerald-800 uppercase">Instant Approved</p>
            <p class="mt-1 text-2xl font-extrabold text-emerald-700">{stats.activeCoupons}</p>
          </div>

          <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xs">
            <p class="text-xs font-bold text-slate-500 uppercase">Total Redemptions</p>
            <p class="mt-1 text-2xl font-extrabold text-[#191f2e]">{stats.totalClicks}</p>
          </div>
        </div>

        <!-- Coupons Section -->
        <div class="mb-6 flex items-center justify-between">
          <h2 id="coupon-count-header" class="text-lg font-extrabold text-[#191f2e]">
            Your Coupons ({coupons.length})
          </h2>
        </div>

        {coupons.length === 0 ? (
          <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
            <span class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-[#eef5ff] text-2xl border border-[#2491ef]/20 text-[#2491ef]">
              🏷️
            </span>
            <h3 class="mt-4 text-base font-bold text-[#191f2e]">
              You haven't submitted any coupons yet
            </h3>
            <p class="mx-auto mt-1 max-w-md text-xs text-slate-500">
              Found a promo code on food delivery, fashion, electronics, or travel? Share it with the community — it publishes live immediately!
            </p>
            <a
              href="/submit-coupon"
              class="mt-5 inline-block rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-bold text-white shadow-2xs transition hover:bg-[#129fea]"
            >
              + Share Your First Coupon
            </a>
          </div>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {coupons.map((coupon) => (
              <div id={`coupon-card-${coupon.id}`} class="flex flex-col justify-between transition duration-200">
                <CouponCard
                  coupon={coupon}
                  featuredBadge={
                    isCouponExpired(coupon.expiry_date)
                      ? "EXPIRED"
                      : "LIVE OFFER"
                  }
                >
                  <div class="mt-3.5 flex items-center justify-between border-t border-slate-100 pt-3">
                    <span class="text-[11px] font-semibold">
                      <span class="inline-flex items-center gap-1 text-[#60a600] font-bold">
                        <span class="h-1.5 w-1.5 rounded-full bg-[#60a600] animate-pulse"></span>
                        Published Live
                      </span>
                    </span>
                    <button
                      type="button"
                      data-delete-coupon-id={coupon.id}
                      data-coupon-title={coupon.title}
                      class="delete-coupon-btn inline-flex items-center gap-1 rounded-md border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-bold text-rose-700 transition hover:bg-rose-100 active:scale-95"
                      title="Delete this coupon"
                    >
                      <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                      <span>Delete</span>
                    </button>
                  </div>
                </CouponCard>
              </div>
            ))}
          </div>
        )}
      </div>
    ) : (
      <div class="mx-auto max-w-xl py-12 text-center">
        <div class="rounded-2xl border border-slate-200 bg-white p-8 sm:p-10 shadow-sm">
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-2xl bg-[#eef5ff] border border-[#2491ef]/20 text-3xl">
            🎟️
          </div>

          <h1 class="mt-5 text-2xl font-extrabold tracking-tight text-[#191f2e] sm:text-3xl">
            View Your Submitted Coupons
          </h1>
          <p class="mt-2 text-xs sm:text-sm text-slate-500 max-w-md mx-auto">
            Did you submit a coupon as a visitor? Sign in with your Google account to track your live deals, see redemption counts, and manage your coupons.
          </p>

          <!-- Notification if they just submitted -->
          {justSubmitted && (
            <div class="my-5 rounded-xl border border-emerald-200 bg-emerald-50 p-3.5 text-xs text-emerald-800 text-left flex items-center gap-2.5">
              <span class="text-lg">⚡</span>
              <span><strong>Coupon published live!</strong> Sign in with Google below to view and manage it.</span>
            </div>
          )}

          <!-- Google Sign-In Card / Button -->
          <div class="mt-8 space-y-4">
            <button
              type="button"
              id="google-login-btn"
              class="w-full flex items-center justify-center gap-3 rounded-xl border border-slate-300 bg-white px-5 py-3.5 text-sm font-bold text-slate-700 shadow-2xs transition hover:bg-slate-50 hover:border-slate-400 active:scale-98"
            >
              <!-- Multi-color Google SVG -->
              <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24">
                <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
              </svg>
              <span>Continue with Google Account</span>
            </button>

            <!-- Quick Email Login Modal Trigger -->
            <div class="relative my-4">
              <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-slate-200"></div></div>
              <div class="relative flex justify-center text-xs uppercase"><span class="bg-white px-2 text-slate-400 font-bold">Or</span></div>
            </div>

            <div class="flex items-center justify-center gap-4 text-xs font-semibold text-slate-600">
              <a href="/login?next=/my-coupons" class="text-[#2491ef] hover:underline font-bold">
                Sign in with Password →
              </a>
              <span class="text-slate-300">•</span>
              <a href="/submit-coupon" class="text-slate-600 hover:text-[#2491ef]">
                Submit another coupon
              </a>
            </div>
          </div>
        </div>
      </div>
    )}
  </div>

  <!-- GOOGLE SIGN-IN INTERACTIVE MODAL (For Visitors) -->
  <div id="google-modal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4 backdrop-blur-xs">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl transition">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <div class="flex items-center gap-2">
          <!-- Google Icon -->
          <svg class="h-5 w-5" viewBox="0 0 24 24">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <h3 class="text-sm font-bold text-[#191f2e]">Sign in with Google</h3>
        </div>
        <button type="button" id="close-google-modal" class="rounded-lg p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600">
          ✕
        </button>
      </div>

      <p class="mt-3 text-xs text-slate-500">
        Enter your Google account email to view all coupons you have submitted to CouponHub.
      </p>

      <form id="google-quick-form" class="mt-4 space-y-3.5">
        <div>
          <label for="google-email-input" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Google Email Address *
          </label>
          <input
            id="google-email-input"
            type="email"
            required
            placeholder="you@gmail.com"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>

        <div>
          <label for="google-name-input" class="mb-1 block text-xs font-bold text-[#191f2e]">
            Your Name (Optional)
          </label>
          <input
            id="google-name-input"
            type="text"
            placeholder="e.g. John Doe"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
          />
        </div>

        <div id="google-error-msg" class="hidden rounded-lg bg-rose-50 p-2.5 text-xs font-semibold text-rose-700"></div>

        <div class="mt-5 flex gap-2.5">
          <button
            type="button"
            id="cancel-google-btn"
            class="flex-1 rounded-lg border border-slate-200 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-50"
          >
            Cancel
          </button>
          <button
            type="submit"
            id="confirm-google-btn"
            class="flex-1 rounded-lg bg-[#2491ef] py-2.5 text-xs font-bold text-white shadow-xs hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
          >
            Sign In with Google
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  // Google Sign-In Modal Controls
  const googleBtn = document.getElementById("google-login-btn");
  const googleModal = document.getElementById("google-modal");
  const closeModalBtn = document.getElementById("close-google-modal");
  const cancelModalBtn = document.getElementById("cancel-google-btn");
  const googleForm = document.getElementById("google-quick-form");
  const googleEmailInput = document.getElementById("google-email-input") as HTMLInputElement | null;
  const googleNameInput = document.getElementById("google-name-input") as HTMLInputElement | null;
  const googleErrorMsg = document.getElementById("google-error-msg");
  const confirmGoogleBtn = document.getElementById("confirm-google-btn") as HTMLButtonElement | null;

  function openGoogleModal() {
    if (googleModal) {
      googleModal.classList.remove("hidden");
      googleModal.classList.add("flex");
      googleEmailInput?.focus();
    }
  }

  function closeGoogleModal() {
    if (googleModal) {
      googleModal.classList.add("hidden");
      googleModal.classList.remove("flex");
    }
    if (googleErrorMsg) googleErrorMsg.classList.add("hidden");
  }

  googleBtn?.addEventListener("click", openGoogleModal);
  closeModalBtn?.addEventListener("click", closeGoogleModal);
  cancelModalBtn?.addEventListener("click", closeGoogleModal);

  googleForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (googleErrorMsg) googleErrorMsg.classList.add("hidden");
    const email = googleEmailInput?.value.trim();
    const name = googleNameInput?.value.trim();

    if (!email || !email.includes("@")) {
      if (googleErrorMsg) {
        googleErrorMsg.textContent = "Please enter a valid Google email address.";
        googleErrorMsg.classList.remove("hidden");
      }
      return;
    }

    if (confirmGoogleBtn) {
      confirmGoogleBtn.disabled = true;
      confirmGoogleBtn.textContent = "Connecting Google...";
    }

    try {
      const res = await fetch("/api/auth/google", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email, name }),
      });
      const data = (await res.json()) as { ok?: boolean; error?: string };

      if (!res.ok || !data.ok) {
        if (googleErrorMsg) {
          googleErrorMsg.textContent = data.error || "Google sign-in failed. Please try again.";
          googleErrorMsg.classList.remove("hidden");
        }
        return;
      }

      // Successfully signed in! Reload /my-coupons to show their coupons
      window.location.reload();
    } catch {
      if (googleErrorMsg) {
        googleErrorMsg.textContent = "Network error. Please try again.";
        googleErrorMsg.classList.remove("hidden");
      }
    } finally {
      if (confirmGoogleBtn) {
        confirmGoogleBtn.disabled = false;
        confirmGoogleBtn.textContent = "Sign In with Google";
      }
    }
  });

  // Delete coupon handler
  document.querySelectorAll(".delete-coupon-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const targetBtn = btn as HTMLButtonElement;
      const id = targetBtn.getAttribute("data-delete-coupon-id");
      const title = targetBtn.getAttribute("data-coupon-title") || "this coupon";
      if (!id) return;

      const confirmed = window.confirm(`Are you sure you want to delete "${title}"? This action cannot be undone.`);
      if (!confirmed) return;

      const originalHtml = targetBtn.innerHTML;
      targetBtn.disabled = true;
      targetBtn.innerHTML = `<span>⏳ Deleting...</span>`;

      try {
        const res = await fetch(`/api/coupons/${id}`, {
          method: "DELETE",
        });
        const data = (await res.json()) as { ok?: boolean; error?: string };

        if (!res.ok || !data.ok) {
          alert(data.error || "Failed to delete coupon. Please try again.");
          targetBtn.disabled = false;
          targetBtn.innerHTML = originalHtml;
          return;
        }

        // Animate card removal from DOM
        const cardElem = document.getElementById(`coupon-card-${id}`);
        if (cardElem) {
          cardElem.style.transition = "opacity 0.25s ease, transform 0.25s ease";
          cardElem.style.opacity = "0";
          cardElem.style.transform = "scale(0.95)";
          setTimeout(() => {
            cardElem.remove();
            const remaining = document.querySelectorAll(".delete-coupon-btn").length;
            const countHeader = document.getElementById("coupon-count-header");
            if (countHeader) countHeader.textContent = `Your Coupons (${remaining})`;
            if (remaining === 0) {
              window.location.reload();
            }
          }, 250);
        }
      } catch {
        alert("Network error. Please try again.");
        targetBtn.disabled = false;
        targetBtn.innerHTML = originalHtml;
      }
    });
  });
</script>
