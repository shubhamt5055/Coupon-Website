---
import MainLayout from "../layouts/MainLayout.astro";
import CouponCard from "../components/CouponCard.astro";
import { getDb } from "../lib/cloudflare";
import { getCoupons, getUserStats } from "../lib/db";
import { formatDisplayDate, isCouponExpired } from "../lib/format";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/my-coupons&reason=signin-required");
}

const db = getDb();
const [stats, coupons] = await Promise.all([
  getUserStats(db, user.id),
  getCoupons(db, {
    userId: user.id,
    includeExpired: true,
    includeInactive: true,
    sort: "newest",
  }),
]);

const submittedParam = Astro.url.searchParams.get("submitted");
const justSubmitted = Boolean(submittedParam);
---

<MainLayout
  title="My Submitted Coupons — CouponHub"
  description="Manage the coupons and promo codes you have shared on CouponHub."
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-3">
          <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-gradient-to-br from-[#581C87] to-[#9333EA] text-lg font-black text-[#FACC15] shadow-xs">
            {user.name.charAt(0).toUpperCase()}
          </span>
          <div>
            <h1 class="text-2xl font-black tracking-tight text-[#581C87] sm:text-3xl">
              My Submitted Coupons
            </h1>
            <p class="text-xs font-medium text-slate-500">
              Logged in as <strong class="text-slate-800">{user.name}</strong> ({user.email})
            </p>
          </div>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/submit-coupon"
          class="rounded-xl bg-gradient-to-r from-[#581C87] via-[#9333EA] to-[#EC4899] px-5 py-2.5 text-xs font-black text-white shadow-xs transition hover:opacity-95 active:scale-95"
        >
          + Share Another Coupon
        </a>
      </div>
    </div>

    <!-- Celebration Banner -->
    {justSubmitted && (
      <div class="mb-8 rounded-2xl border border-[#9333EA]/30 bg-gradient-to-r from-purple-50 via-pink-50/40 to-white p-5 text-[#581C87] shadow-xs">
        <div class="flex items-center gap-3">
          <span class="text-3xl">⏳</span>
          <div>
            <p class="text-sm font-bold">Coupon submitted for admin verification!</p>
            <p class="mt-0.5 text-xs text-[#581C87]/80">
              Your deal has been sent to the Admin Panel for review. Once verified and approved by the team, it will appear publicly on the live site!
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- Stats Grid -->
    <div class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-xs">
        <p class="text-xs font-bold text-slate-500 uppercase">Total Submitted</p>
        <p class="mt-1 text-2xl font-black text-slate-900">{stats.totalCoupons}</p>
      </div>

      <div class="rounded-2xl border border-amber-200 bg-amber-50/70 p-5 shadow-xs">
        <p class="text-xs font-bold text-amber-700 uppercase">Pending Review</p>
        <p class="mt-1 text-2xl font-black text-amber-800">{stats.pendingCoupons}</p>
      </div>

      <div class="rounded-2xl border border-[#14B8A6]/30 bg-teal-50/60 p-5 shadow-xs">
        <p class="text-xs font-bold text-[#0f766e] uppercase">Live &amp; Verified</p>
        <p class="mt-1 text-2xl font-black text-[#0f766e]">{stats.activeCoupons}</p>
      </div>

      <div class="rounded-2xl border border-[#9333EA]/30 bg-purple-50/60 p-5 shadow-xs">
        <p class="text-xs font-bold text-[#581C87] uppercase">Total Clicks</p>
        <p class="mt-1 text-2xl font-black text-[#9333EA]">{stats.totalClicks}</p>
      </div>
    </div>

    <!-- Coupons Section -->
    <div class="mb-6 flex items-center justify-between">
      <h2 id="coupon-count-header" class="text-xl font-black text-[#581C87]">
        Your Coupons ({coupons.length})
      </h2>
    </div>

    {coupons.length === 0 ? (
      <div class="rounded-3xl border border-dashed border-[#9333EA]/30 bg-white p-12 text-center">
        <span class="inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-purple-50 text-3xl border border-[#9333EA]/20">
          🏷️
        </span>
        <h3 class="mt-4 text-lg font-bold text-slate-900">
          You haven't submitted any coupons yet
        </h3>
        <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">
          Found a promo code on food delivery, fashion, electronics, or travel? Share it with the community!
        </p>
        <a
          href="/submit-coupon"
          class="mt-6 inline-block rounded-xl bg-gradient-to-r from-[#581C87] via-[#9333EA] to-[#EC4899] px-6 py-3 text-sm font-bold text-white shadow-xs transition hover:opacity-95"
        >
          + Share Your First Coupon
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {coupons.map((coupon) => (
          <div id={`coupon-card-${coupon.id}`} class="flex flex-col justify-between transition duration-200">
            <CouponCard
              coupon={coupon}
              featuredBadge={
                coupon.is_active === 0
                  ? "⏳ Pending Review"
                  : isCouponExpired(coupon.expiry_date)
                  ? "Expired"
                  : "✓ Live & Verified"
              }
            >
              <div class="mt-3.5 flex items-center justify-between border-t border-slate-100 pt-3">
                <span class="text-[11px] font-semibold">
                  {coupon.is_active === 0 ? (
                    <span class="inline-flex items-center gap-1 text-amber-700">
                      ⏳ Pending Admin Review
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-[#0f766e] font-bold">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#14B8A6]"></span>
                      Published Live
                    </span>
                  )}
                </span>
                <button
                  type="button"
                  data-delete-coupon-id={coupon.id}
                  data-coupon-title={coupon.title}
                  class="delete-coupon-btn inline-flex items-center gap-1 rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-bold text-rose-700 transition hover:bg-rose-100 active:scale-95"
                  title="Delete this coupon"
                >
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  <span>Delete</span>
                </button>
              </div>
            </CouponCard>
          </div>
        ))}
      </div>
    )}
  </div>
</MainLayout>

<script>
  // Delete coupon handler
  document.querySelectorAll(".delete-coupon-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const targetBtn = btn as HTMLButtonElement;
      const id = targetBtn.getAttribute("data-delete-coupon-id");
      const title = targetBtn.getAttribute("data-coupon-title") || "this coupon";
      if (!id) return;

      const confirmed = window.confirm(`Are you sure you want to delete "${title}"? This action cannot be undone.`);
      if (!confirmed) return;

      const originalHtml = targetBtn.innerHTML;
      targetBtn.disabled = true;
      targetBtn.innerHTML = `<span>⏳ Deleting...</span>`;

      try {
        const res = await fetch(`/api/coupons/${id}`, {
          method: "DELETE",
        });
        const data = (await res.json()) as { ok?: boolean; error?: string };

        if (!res.ok || !data.ok) {
          alert(data.error || "Failed to delete coupon. Please try again.");
          targetBtn.disabled = false;
          targetBtn.innerHTML = originalHtml;
          return;
        }

        // Animate card removal from DOM
        const cardElem = document.getElementById(`coupon-card-${id}`);
        if (cardElem) {
          cardElem.style.transition = "opacity 0.25s ease, transform 0.25s ease";
          cardElem.style.opacity = "0";
          cardElem.style.transform = "scale(0.95)";
          setTimeout(() => {
            cardElem.remove();
            const remaining = document.querySelectorAll(".delete-coupon-btn").length;
            const countHeader = document.getElementById("coupon-count-header");
            if (countHeader) countHeader.textContent = `Your Coupons (${remaining})`;
            if (remaining === 0) {
              window.location.reload();
            }
          }, 250);
        }
      } catch {
        alert("Network error. Please try again.");
        targetBtn.disabled = false;
        targetBtn.innerHTML = originalHtml;
      }
    });
  });
</script>
