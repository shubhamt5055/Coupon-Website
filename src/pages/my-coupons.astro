---
import MainLayout from "../layouts/MainLayout.astro";
import CouponCard from "../components/CouponCard.astro";
import { getDb } from "../lib/cloudflare";
import { getCoupons, getUserStats } from "../lib/db";
import { formatDisplayDate, isCouponExpired } from "../lib/format";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/my-coupons&reason=signin-required");
}

const db = getDb();
const [stats, coupons] = await Promise.all([
  getUserStats(db, user.id),
  getCoupons(db, {
    userId: user.id,
    includeExpired: true,
    includeInactive: true,
    sort: "newest",
  }),
]);

const submittedParam = Astro.url.searchParams.get("submitted");
const justSubmitted = Boolean(submittedParam);
---

<MainLayout
  title="My Submitted Coupons — CouponHub | Save On Everything"
  description="Manage the coupons and promo codes you have shared on CouponHub."
>
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Header (GrabOn Style) -->
    <div class="mb-8 flex flex-wrap items-center justify-between gap-4">
      <div class="flex items-center gap-3.5">
        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-[#2491ef] text-base font-extrabold text-white shadow-2xs">
          {user.name.charAt(0).toUpperCase()}
        </span>
        <div>
          <h1 class="text-2xl font-extrabold tracking-tight text-[#191f2e] sm:text-3xl">
            My Submitted Coupons
          </h1>
          <p class="text-xs font-medium text-slate-500">
            Logged in as <strong class="text-[#191f2e]">{user.name}</strong> ({user.email})
          </p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/submit-coupon"
          class="rounded-lg bg-[#2491ef] px-4 py-2 text-xs font-bold text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95"
        >
          + Share Another Coupon
        </a>
      </div>
    </div>

    <!-- Celebration Banner -->
    {justSubmitted && (
      <div class="mb-8 rounded-xl border border-amber-200 bg-amber-50 p-4 text-amber-900 shadow-2xs">
        <div class="flex items-center gap-3">
          <span class="text-2xl">⏳</span>
          <div>
            <p class="text-xs sm:text-sm font-bold text-[#191f2e]">Coupon submitted for admin verification!</p>
            <p class="mt-0.5 text-xs text-slate-600">
              Your deal has been sent to our team for testing. Once verified and approved, it will be published live on CouponHub.
            </p>
          </div>
        </div>
      </div>
    )}

    <!-- Stats Grid (GrabOn Style) -->
    <div class="mb-10 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xs">
        <p class="text-xs font-bold text-slate-500 uppercase">Total Submitted</p>
        <p class="mt-1 text-2xl font-extrabold text-[#191f2e]">{stats.totalCoupons}</p>
      </div>

      <div class="rounded-xl border border-amber-200 bg-amber-50/50 p-4 sm:p-5 shadow-2xs">
        <p class="text-xs font-bold text-amber-800 uppercase">Pending Review</p>
        <p class="mt-1 text-2xl font-extrabold text-amber-700">{stats.pendingCoupons}</p>
      </div>

      <div class="rounded-xl border border-[#2491ef]/20 bg-[#eef5ff] p-4 sm:p-5 shadow-2xs">
        <p class="text-xs font-bold text-[#2491ef] uppercase">Live &amp; Verified</p>
        <p class="mt-1 text-2xl font-extrabold text-[#2491ef]">{stats.activeCoupons}</p>
      </div>

      <div class="rounded-xl border border-slate-200 bg-white p-4 sm:p-5 shadow-2xs">
        <p class="text-xs font-bold text-slate-500 uppercase">Total Redemptions</p>
        <p class="mt-1 text-2xl font-extrabold text-[#191f2e]">{stats.totalClicks}</p>
      </div>
    </div>

    <!-- Coupons Section -->
    <div class="mb-6 flex items-center justify-between">
      <h2 id="coupon-count-header" class="text-lg font-extrabold text-[#191f2e]">
        Your Coupons ({coupons.length})
      </h2>
    </div>

    {coupons.length === 0 ? (
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-[#eef5ff] text-2xl border border-[#2491ef]/20 text-[#2491ef]">
          🏷️
        </span>
        <h3 class="mt-4 text-base font-bold text-[#191f2e]">
          You haven't submitted any coupons yet
        </h3>
        <p class="mx-auto mt-1 max-w-md text-xs text-slate-500">
          Found a promo code on food delivery, fashion, electronics, or travel? Share it with the community!
        </p>
        <a
          href="/submit-coupon"
          class="mt-5 inline-block rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-bold text-white shadow-2xs transition hover:bg-[#129fea]"
        >
          + Share Your First Coupon
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {coupons.map((coupon) => (
          <div id={`coupon-card-${coupon.id}`} class="flex flex-col justify-between transition duration-200">
            <CouponCard
              coupon={coupon}
              featuredBadge={
                coupon.is_active === 0
                  ? "⏳ PENDING REVIEW"
                  : isCouponExpired(coupon.expiry_date)
                  ? "EXPIRED"
                  : "RECOMMENDED"
              }
            >
              <div class="mt-3.5 flex items-center justify-between border-t border-slate-100 pt-3">
                <span class="text-[11px] font-semibold">
                  {coupon.is_active === 0 ? (
                    <span class="inline-flex items-center gap-1 text-amber-700 font-bold">
                      ⏳ Pending Admin Review
                    </span>
                  ) : (
                    <span class="inline-flex items-center gap-1 text-[#60a600] font-bold">
                      <span class="h-1.5 w-1.5 rounded-full bg-[#60a600]"></span>
                      Published Live
                    </span>
                  )}
                </span>
                <button
                  type="button"
                  data-delete-coupon-id={coupon.id}
                  data-coupon-title={coupon.title}
                  class="delete-coupon-btn inline-flex items-center gap-1 rounded-md border border-rose-200 bg-rose-50 px-2.5 py-1 text-xs font-bold text-rose-700 transition hover:bg-rose-100 active:scale-95"
                  title="Delete this coupon"
                >
                  <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                  </svg>
                  <span>Delete</span>
                </button>
              </div>
            </CouponCard>
          </div>
        ))}
      </div>
    )}
  </div>
</MainLayout>

<script>
  // Delete coupon handler
  document.querySelectorAll(".delete-coupon-btn").forEach((btn) => {
    btn.addEventListener("click", async (e) => {
      e.preventDefault();
      const targetBtn = btn as HTMLButtonElement;
      const id = targetBtn.getAttribute("data-delete-coupon-id");
      const title = targetBtn.getAttribute("data-coupon-title") || "this coupon";
      if (!id) return;

      const confirmed = window.confirm(`Are you sure you want to delete "${title}"? This action cannot be undone.`);
      if (!confirmed) return;

      const originalHtml = targetBtn.innerHTML;
      targetBtn.disabled = true;
      targetBtn.innerHTML = `<span>⏳ Deleting...</span>`;

      try {
        const res = await fetch(`/api/coupons/${id}`, {
          method: "DELETE",
        });
        const data = (await res.json()) as { ok?: boolean; error?: string };

        if (!res.ok || !data.ok) {
          alert(data.error || "Failed to delete coupon. Please try again.");
          targetBtn.disabled = false;
          targetBtn.innerHTML = originalHtml;
          return;
        }

        // Animate card removal from DOM
        const cardElem = document.getElementById(`coupon-card-${id}`);
        if (cardElem) {
          cardElem.style.transition = "opacity 0.25s ease, transform 0.25s ease";
          cardElem.style.opacity = "0";
          cardElem.style.transform = "scale(0.95)";
          setTimeout(() => {
            cardElem.remove();
            const remaining = document.querySelectorAll(".delete-coupon-btn").length;
            const countHeader = document.getElementById("coupon-count-header");
            if (countHeader) countHeader.textContent = `Your Coupons (${remaining})`;
            if (remaining === 0) {
              window.location.reload();
            }
          }, 250);
        }
      } catch {
        alert("Network error. Please try again.");
        targetBtn.disabled = false;
        targetBtn.innerHTML = originalHtml;
      }
    });
  });
</script>
