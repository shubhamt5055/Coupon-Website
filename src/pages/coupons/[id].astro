---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import StoreLogo from "../../components/StoreLogo.astro";
import { getDb } from "../../lib/cloudflare";
import { getCouponById, getRelatedCoupons } from "../../lib/db";
import {
  formatDisplayDate,
  getDaysUntilExpiry,
  isCouponExpired,
  safeExternalUrl,
} from "../../lib/format";

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/coupons");
}

const db = getDb();
const coupon = await getCouponById(db, id);

if (!coupon || coupon.is_active !== 1) {
  Astro.response.status = 404;
}

const related = coupon
  ? await getRelatedCoupons(db, coupon.id, coupon.category_id, coupon.store_id, 3)
  : [];

const expired = coupon ? isCouponExpired(coupon.expiry_date) : false;
const daysLeft = coupon ? getDaysUntilExpiry(coupon.expiry_date) : null;
const storeUrl = coupon ? safeExternalUrl(coupon.affiliate_or_store_url) : "#";
const totalVotes = coupon ? coupon.worked_count + coupon.didnt_work_count : 0;
const successRate =
  coupon && totalVotes > 0 ? Math.round((coupon.worked_count / totalVotes) * 100) : null;
---

<MainLayout
  title={coupon ? `${coupon.title} (${coupon.store_name}) | CouponHub` : "Coupon Not Found | CouponHub"}
  description={coupon ? `${coupon.discount_text} at ${coupon.store_name} with code ${coupon.code}. ${coupon.description}` : "Coupon not found."}
>
  {!coupon || coupon.is_active !== 1 ? (
    <section class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-black text-[#081126]">Coupon Not Found</h1>
      <p class="mt-3 text-slate-600">
        This coupon may have been removed or deactivated.
      </p>
      <a
        href="/coupons"
        class="mt-6 inline-block rounded-full bg-[#0499FA] px-7 py-3 text-sm font-black text-white shadow-md shadow-[#0499FA]/20 transition hover:bg-[#0377C4]"
      >
        Browse Active Coupons
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-5xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="mb-6 flex flex-wrap items-center gap-2 text-xs font-semibold text-slate-500" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#0499FA] transition">Home</a>
        <span>/</span>
        <a href={`/categories/${coupon.category_slug}`} class="hover:text-[#0499FA] transition">{coupon.category_name}</a>
        <span>/</span>
        <a href={`/stores/${coupon.store_slug}`} class="hover:text-[#0499FA] transition">{coupon.store_name}</a>
        <span>/</span>
        <span class="truncate text-[#081126] font-bold">{coupon.title}</span>
      </nav>

      <!-- Main Detail Card -->
      <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xs">
        {expired && (
          <div class="bg-rose-600 px-6 py-2.5 text-center text-xs font-bold tracking-wide text-white uppercase">
            This coupon expired on {formatDisplayDate(coupon.expiry_date)} — browse active {coupon.store_name} deals below.
          </div>
        )}

        <div class="p-6 sm:p-8">
          <div class="flex flex-col gap-6 md:flex-row md:items-start md:justify-between">
            <!-- Left Info -->
            <div class="flex-1">
              <div class="mb-4 flex flex-wrap items-center gap-3">
                <a href={`/stores/${coupon.store_slug}`} class="flex items-center gap-3">
                  <div class="h-12 w-12 rounded-xl border border-slate-200 bg-white p-1.5 flex items-center justify-center overflow-hidden">
                    <StoreLogo store={{ name: coupon.store_name, slug: coupon.store_slug, logo_url: coupon.store_logo_url }} size="md" />
                  </div>
                  <div>
                    <p class="text-sm font-black text-[#081126]">{coupon.store_name}</p>
                    <p class="text-xs text-slate-500 font-medium">
                      {coupon.category_icon} {coupon.category_name}
                    </p>
                  </div>
                </a>

                <span
                  class:list={[
                    "rounded-full px-3.5 py-1 text-xs font-black uppercase tracking-wider",
                    expired
                      ? "bg-rose-100 text-rose-700 border border-rose-200"
                      : "bg-[#EAF6FE] text-[#0499FA] border border-[#0499FA]/20",
                  ]}
                >
                  {expired ? "EXPIRED" : coupon.discount_text}
                </span>
              </div>

              <h1 class="text-2xl leading-tight font-black text-[#081126] sm:text-3xl">
                {coupon.title}
              </h1>

              {coupon.description && (
                <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-base">
                  {coupon.description}
                </p>
              )}

              <!-- Quick Facts -->
              <div class="mt-5 flex flex-wrap gap-2.5 text-xs font-medium text-slate-600">
                <span class="rounded-xl bg-[#F8FAFC] px-3 py-1.5 border border-slate-200">
                  📅 Expires: <strong class="text-[#081126] font-bold">{formatDisplayDate(coupon.expiry_date)}</strong>
                  {!expired && daysLeft !== null && daysLeft <= 7 && (
                    <span class="ml-1 text-[#FF7A18] font-bold">({daysLeft === 0 ? "Ends today" : `${daysLeft}d left`})</span>
                  )}
                </span>
                <span class="rounded-xl bg-[#F8FAFC] px-3 py-1.5 border border-slate-200">
                  ⚡ Used <strong data-coupon-clicks={coupon.id} class="text-[#081126] font-bold">{coupon.click_count} uses</strong>
                </span>
                {successRate !== null && (
                  <span class="rounded-xl bg-emerald-50 px-3 py-1.5 text-emerald-700 font-bold border border-emerald-200">
                    ✓ {successRate}% reported working
                  </span>
                )}
              </div>
            </div>

            <!-- Right Action Box (Couponly Ticket Style) -->
            <div class="w-full shrink-0 rounded-2xl border-2 border-dashed border-[#FF7A18]/40 bg-[#FFF9F5] p-5 md:w-80 shadow-2xs">
              <p class="text-xs font-black tracking-wider text-[#FF7A18] uppercase">
                Coupon Code
              </p>

              <div class="mt-2.5 flex items-center justify-center rounded-xl border-2 border-dashed border-[#FF7A18] bg-white px-4 py-3.5 shadow-2xs">
                <span
                  data-coupon-code-text={coupon.id}
                  class:list={[
                    "font-mono text-xl font-black tracking-widest",
                    expired
                      ? "text-slate-400 line-through"
                      : "text-[#081126]",
                  ]}
                >
                  {coupon.code}
                </span>
              </div>

              {!expired ? (
                <button
                  type="button"
                  class="reveal-coupon-btn mt-4 w-full rounded-xl bg-[#FF7A18] px-4 py-3 text-sm font-black text-white shadow-md shadow-[#FF7A18]/25 transition hover:bg-[#E6680C] active:scale-95"
                  data-coupon-id={coupon.id}
                  data-coupon-code={coupon.code}
                  data-coupon-title={coupon.title}
                  data-coupon-store={coupon.store_name}
                  data-coupon-discount={coupon.discount_text}
                  data-coupon-url={storeUrl}
                >
                  Copy Code &amp; Visit {coupon.store_name} →
                </button>
              ) : (
                <a
                  href={`/stores/${coupon.store_slug}`}
                  class="mt-4 block w-full rounded-xl bg-slate-800 px-4 py-3 text-center text-sm font-bold text-white hover:bg-slate-700"
                >
                  See Active {coupon.store_name} Deals
                </a>
              )}

              <a
                href={storeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="mt-2.5 block w-full rounded-xl border border-slate-200 bg-white py-2.5 text-center text-xs font-bold text-slate-700 transition hover:border-[#0499FA] hover:text-[#0499FA]"
              >
                Open Store Website Only ↗
              </a>
            </div>
          </div>

          <!-- Terms & Conditions -->
          <div class="mt-8 border-t border-slate-200 pt-6">
            <h2 class="text-xs font-black tracking-wider text-[#081126] uppercase">
              Terms &amp; Conditions
            </h2>
            <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-600">
              {coupon.terms || "Standard merchant terms apply. Enter the promo code at checkout before completing payment. Cannot usually be combined with other offers."}
            </p>
          </div>

          <!-- Coupon Worked / Didn't Work Voting Widget -->
          <div
            id="vote-widget"
            data-coupon-id={coupon.id}
            class="mt-8 rounded-2xl border border-slate-200 bg-[#F8FAFC] p-5"
          >
            <div class="flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center">
              <div>
                <h2 class="text-base font-black text-[#081126]">
                  Did this coupon work for you?
                </h2>
                <p class="text-xs text-slate-500 font-medium">
                  Community verification keeps expired or broken codes out.
                </p>
              </div>
              <div class="flex items-center gap-3">
                <button
                  type="button"
                  data-vote-btn="worked"
                  class="inline-flex items-center gap-2 rounded-xl border border-[#0499FA]/30 bg-[#EAF6FE] px-4 py-2 text-xs font-black text-[#0499FA] transition hover:bg-[#0499FA] hover:text-white shadow-2xs"
                >
                  👍 Worked (<span id="worked-count">{coupon.worked_count}</span>)
                </button>
                <button
                  type="button"
                  data-vote-btn="didnt_work"
                  class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-600 transition hover:bg-slate-100"
                >
                  👎 Didn't Work (<span id="didnt-work-count">{coupon.didnt_work_count}</span>)
                </button>
              </div>
            </div>
            <p id="vote-status-msg" class="mt-3 hidden text-xs font-black text-[#0499FA]"></p>
          </div>
        </div>
      </div>

      <!-- Related Coupons -->
      {related.length > 0 && (
        <div class="mt-12">
          <h2 class="mb-5 text-2xl font-black text-[#081126]">
            More Deals You May Like
          </h2>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((item) => (
              <CouponCard coupon={item} />
            ))}
          </div>
        </div>
      )}
    </section>
  )}
</MainLayout>

<script>
  const widget = document.getElementById("vote-widget");
  const couponId = widget?.dataset.couponId;
  const workedEl = document.getElementById("worked-count");
  const didntWorkEl = document.getElementById("didnt-work-count");
  const statusMsg = document.getElementById("vote-status-msg");

  if (widget && couponId) {
    const storageKey = `couponhub-voted-${couponId}`;
    widget.querySelectorAll<HTMLButtonElement>("[data-vote-btn]").forEach((btn) => {
      btn.addEventListener("click", async () => {
        if (localStorage.getItem(storageKey)) {
          if (statusMsg) {
            statusMsg.textContent = "You already voted on this coupon. Thank you!";
            statusMsg.classList.remove("hidden");
          }
          return;
        }
        const vote = btn.dataset.voteBtn;
        btn.disabled = true;
        try {
          const res = await fetch(`/api/coupons/${couponId}/vote`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ vote }),
          });
          if (res.ok) {
            const data = (await res.json()) as {
              worked_count: number;
              didnt_work_count: number;
            };
            if (workedEl) workedEl.textContent = String(data.worked_count);
            if (didntWorkEl) didntWorkEl.textContent = String(data.didnt_work_count);
            localStorage.setItem(storageKey, vote || "1");
            if (statusMsg) {
              statusMsg.textContent = "Thanks for voting! Your feedback has been saved.";
              statusMsg.classList.remove("hidden");
            }
          }
        } catch {
          if (statusMsg) {
            statusMsg.textContent = "Network error. Please try again.";
            statusMsg.classList.remove("hidden");
          }
        } finally {
          btn.disabled = false;
        }
      });
    });
  }
</script>
