---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getDb } from "../../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
} from "../../lib/db";

const url = Astro.url;
const q = url.searchParams.get("q")?.trim() ?? "";
const categorySlug = url.searchParams.get("category")?.trim() ?? "";
const storeSlug = url.searchParams.get("store")?.trim() ?? "";
const includeExpired = url.searchParams.get("includeExpired") === "1";
const sortParam = url.searchParams.get("sort");
const sort =
  sortParam === "popular" || sortParam === "expiring" ? sortParam : "newest";

const db = getDb();
const [coupons, categories, stores] = await Promise.all([
  getCoupons(db, {
    search: q || undefined,
    categorySlug: categorySlug || undefined,
    storeSlug: storeSlug || undefined,
    includeExpired,
    includeInactive: false,
    sort,
  }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const hasFilters = Boolean(
  q || categorySlug || storeSlug || includeExpired || sort !== "newest",
);
---

<MainLayout
  title={
    q
      ? `Search "${q}" — Discount Coupons | CouponHub`
      : "Explore All Verified Coupons & Promo Codes | CouponHub"
  }
  description="Search and filter verified discount promo codes by store, category, or discount type on CouponHub."
>
  <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Header (GrabOn Style) -->
    <div class="mb-8 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-[#191f2e] sm:text-4xl">
          {q ? `Search results for "${q}"` : "All Verified Coupons & Deals"}
        </h1>
        <p class="mt-1 text-xs sm:text-sm font-medium text-slate-500">
          Filter by your favorite store, product category, or discount value to
          get the best deal.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5">
        <a
          href="/submit-coupon"
          class="inline-flex items-center gap-1.5 rounded-lg bg-[#60a600] px-4 py-2 text-xs font-bold text-white shadow-2xs hover:bg-[#528f00] active:scale-95 transition"
        >
          <span>Add Coupon</span>
        </a>
        <div class="rounded-lg bg-white border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 shadow-2xs">
          Showing{" "}
          <strong class="text-[#2491ef] font-extrabold">
            {coupons.length}
          </strong>{" "}
          {coupons.length === 1 ? "coupon" : "coupons"}
        </div>
      </div>
    </div>

    <!-- Filter Bar Card (GrabOn Style) -->
    <form
      method="GET"
      action="/coupons"
      class="mb-9 rounded-xl border border-slate-200 bg-white p-5 shadow-2xs sm:p-6"
    >
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <label
            for="filter-q"
            class="mb-1.5 block text-xs font-bold uppercase text-[#191f2e]"
          >
            Keyword Search
          </label>
          <div class="relative flex items-center">
            <svg
              class="pointer-events-none absolute left-3.5 h-4 w-4 text-slate-400"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
              />
            </svg>
            <input
              id="filter-q"
              type="search"
              name="q"
              value={q}
              placeholder="Store name, title, or code (e.g. Swiggy, Amazon, 50% OFF)..."
              class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] py-2.5 pr-4 pl-10 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:ring-2 focus:ring-[#2491ef]/20 focus:bg-white"
            />
          </div>
        </div>

        <div>
          <label
            for="filter-category"
            class="mb-1.5 block text-xs font-bold uppercase text-[#191f2e]"
          >
            Category
          </label>
          <select
            id="filter-category"
            name="category"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:ring-2 focus:ring-[#2491ef]/20 focus:bg-white"
          >
            <option value="">All Categories</option>
            {categories.map((cat) => (
              <option value={cat.slug} selected={cat.slug === categorySlug}>
                {cat.icon} {cat.name}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="filter-store"
            class="mb-1.5 block text-xs font-bold uppercase text-[#191f2e]"
          >
            Store
          </label>
          <select
            id="filter-store"
            name="store"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:ring-2 focus:ring-[#2491ef]/20 focus:bg-white"
          >
            <option value="">All Stores</option>
            {stores.map((s) => (
              <option value={s.slug} selected={s.slug === storeSlug}>
                {s.name}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label
            for="filter-sort"
            class="mb-1.5 block text-xs font-bold uppercase text-[#191f2e]"
          >
            Sort Order
          </label>
          <select
            id="filter-sort"
            name="sort"
            class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:ring-2 focus:ring-[#2491ef]/20 focus:bg-white"
          >
            <option value="newest" selected={sort === "newest"}>
              Newest First
            </option>
            <option value="popular" selected={sort === "popular"}>
              Most Popular
            </option>
            <option value="expiring" selected={sort === "expiring"}>
              Expiring Soon
            </option>
          </select>
        </div>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4">
        <label class="inline-flex cursor-pointer items-center gap-2 text-xs font-semibold text-slate-700">
          <input
            type="checkbox"
            name="includeExpired"
            value="1"
            checked={includeExpired}
            class="h-4 w-4 rounded border-slate-300 text-[#2491ef] focus:ring-[#2491ef]"
          />
          <span>Include Expired Deals Archive</span>
        </label>

        <div class="flex items-center gap-2.5">
          {hasFilters && (
            <a
              href="/coupons"
              class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 transition hover:bg-slate-100 hover:text-[#191f2e]"
            >
              Reset Filters
            </a>
          )}
          <button
            type="submit"
            class="rounded-lg bg-[#2491ef] px-6 py-2 text-xs font-bold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95"
          >
            Apply Filters
          </button>
        </div>
      </div>
    </form>

    <!-- Coupons Grid -->
    {coupons.length === 0 ? (
      <div class="rounded-xl border border-dashed border-slate-300 bg-white p-14 text-center shadow-2xs">
        <span class="text-4xl">🔍</span>
        <h3 class="mt-4 text-lg font-bold text-[#191f2e]">
          No coupons matched your search
        </h3>
        <p class="mx-auto mt-2 max-w-md text-xs text-slate-500">
          Try adjusting your keywords, clearing selected category/store, or
          enabling expired coupons.
        </p>
        <a
          href="/coupons"
          class="mt-6 inline-block rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-bold text-white shadow-2xs hover:bg-[#129fea]"
        >
          View All Active Deals
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {coupons.map((coupon) => (
          <CouponCard coupon={coupon} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
