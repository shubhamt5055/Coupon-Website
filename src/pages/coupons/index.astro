---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getDb } from "../../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
} from "../../lib/db";

const url = Astro.url;
const q = url.searchParams.get("q")?.trim() ?? "";
const categorySlug = url.searchParams.get("category")?.trim() ?? "";
const storeSlug = url.searchParams.get("store")?.trim() ?? "";
const includeExpired = url.searchParams.get("includeExpired") === "1";
const sortParam = url.searchParams.get("sort");
const sort =
  sortParam === "popular" || sortParam === "expiring" ? sortParam : "newest";

const db = getDb();
const [coupons, categories, stores] = await Promise.all([
  getCoupons(db, {
    search: q || undefined,
    categorySlug: categorySlug || undefined,
    storeSlug: storeSlug || undefined,
    includeExpired,
    includeInactive: false,
    sort,
  }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const hasFilters = Boolean(q || categorySlug || storeSlug || includeExpired || sort !== "newest");
---

<MainLayout
  title={q ? `Search "${q}" — Coupons | CouponHub` : "Browse All Coupons | CouponHub"}
  description="Search and filter verified discount coupons by store, category, code, or popularity."
>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">
        {q ? `Search results for "${q}"` : "Browse All Coupons"}
      </h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Filter by store, category, or sort order to find the best deal instantly.
      </p>
    </div>

    <!-- Filter Controls -->
    <form
      method="GET"
      action="/coupons"
      class="mb-8 rounded-2xl border border-slate-200 bg-white p-4 shadow-xs sm:p-5 dark:border-slate-800 dark:bg-slate-900"
    >
      <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
        <div class="lg:col-span-2">
          <label for="filter-q" class="mb-1 block text-xs font-bold text-slate-600 uppercase dark:text-slate-400">
            Search
          </label>
          <input
            id="filter-q"
            type="search"
            name="q"
            value={q}
            placeholder="Store name, title, or coupon code..."
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 focus:bg-white dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          />
        </div>

        <div>
          <label for="filter-category" class="mb-1 block text-xs font-bold text-slate-600 uppercase dark:text-slate-400">
            Category
          </label>
          <select
            id="filter-category"
            name="category"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          >
            <option value="">All Categories</option>
            {categories.map((cat) => (
              <option value={cat.slug} selected={cat.slug === categorySlug}>
                {cat.icon} {cat.name}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="filter-store" class="mb-1 block text-xs font-bold text-slate-600 uppercase dark:text-slate-400">
            Store
          </label>
          <select
            id="filter-store"
            name="store"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          >
            <option value="">All Stores</option>
            {stores.map((s) => (
              <option value={s.slug} selected={s.slug === storeSlug}>
                {s.name}
              </option>
            ))}
          </select>
        </div>

        <div>
          <label for="filter-sort" class="mb-1 block text-xs font-bold text-slate-600 uppercase dark:text-slate-400">
            Sort By
          </label>
          <select
            id="filter-sort"
            name="sort"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3 py-2.5 text-sm text-slate-900 outline-none focus:border-indigo-500 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
          >
            <option value="newest" selected={sort === "newest"}>Newest First</option>
            <option value="popular" selected={sort === "popular"}>Most Popular</option>
            <option value="expiring" selected={sort === "expiring"}>Expiring Soon</option>
          </select>
        </div>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-4 dark:border-slate-800">
        <label class="inline-flex cursor-pointer items-center gap-2 text-sm text-slate-700 dark:text-slate-300">
          <input
            type="checkbox"
            name="includeExpired"
            value="1"
            checked={includeExpired}
            class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500"
          />
          <span>Show expired coupons</span>
        </label>

        <div class="flex items-center gap-2">
          {hasFilters && (
            <a
              href="/coupons"
              class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-300 dark:hover:bg-slate-800"
            >
              Reset
            </a>
          )}
          <button
            type="submit"
            class="rounded-xl bg-indigo-600 px-5 py-2 text-sm font-bold text-white shadow-xs transition hover:bg-indigo-700"
          >
            Apply Filters
          </button>
        </div>
      </div>
    </form>

    <!-- Result Count -->
    <p class="mb-5 text-sm font-medium text-slate-500 dark:text-slate-400">
      Showing <strong class="text-slate-900 dark:text-white">{coupons.length}</strong> {coupons.length === 1 ? "coupon" : "coupons"}
    </p>

    {coupons.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900">
        <p class="text-lg font-bold text-slate-800 dark:text-slate-200">No coupons match your filters</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          Try a different keyword, clear a filter, or include expired deals.
        </p>
        <a
          href="/coupons"
          class="mt-5 inline-block rounded-xl bg-indigo-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-indigo-700"
        >
          View All Active Coupons
        </a>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {coupons.map((coupon) => (
          <CouponCard coupon={coupon} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
