---
import MainLayout from "../layouts/MainLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import StoreCard from "../components/StoreCard.astro";
import CouponCard from "../components/CouponCard.astro";
import StoreLogo from "../components/StoreLogo.astro";
import { getDb } from "../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
  getTopCouponsToday,
} from "../lib/db";

const db = getDb();
const [topCoupons, activeCoupons, categories, stores] = await Promise.all([
  getTopCouponsToday(db, 3),
  getCoupons(db, {
    includeExpired: false,
    includeInactive: false,
    sort: "newest",
  }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const totalStores = stores.length;
---

<MainLayout
  title="CouponHub — Save on Everything | India's Verified Coupons & Promo Codes"
  description="Save money online with verified promo codes, discount coupons, and daily deals for Amazon, Flipkart, Swiggy, Myntra, and 50+ top brands."
>
  <!-- GrabOn Hero Section -->
  <section class="border-b border-slate-200/80 bg-gradient-to-b from-[#eef5ff] via-[#f4f7fb] to-[#f4f7fb] pb-14 pt-10 sm:pb-16 sm:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-3xl text-center">


        <!-- Headline -->
        <h1 class="mt-5 text-4xl font-extrabold tracking-tight text-[#191f2e] sm:text-6xl sm:leading-tight">
          Save On Everything.
          <span class="block text-[#2491ef]">
            Verified Coupons &amp; Daily Deals.
          </span>
        </h1>

        <p class="mx-auto mt-4 max-w-2xl text-sm font-medium leading-relaxed text-slate-600 sm:text-base">
          Never pay full price again. Copy hand-tested promo codes for Amazon,
          Flipkart, Swiggy, Myntra, and 50+ favorite shopping sites.
        </p>

        <!-- Big GrabOn Search Box -->
        <div class="mt-8">
          <SearchBar variant="hero" />
        </div>

        <!-- Popular Store Quick Pills (GrabOn Style) -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-xs">
          <span class="font-bold text-slate-500">Popular Stores:</span>
          {stores.slice(0, 6).map((s) => (
            <a
              href={`/stores/${s.slug}`}
              class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 font-semibold text-slate-700 shadow-2xs transition hover:border-[#2491ef] hover:text-[#2491ef] hover:scale-105"
            >
              <span class="flex h-4 w-4 items-center justify-center overflow-hidden rounded-full">
                <StoreLogo store={s} size="sm" />
              </span>
              <span>{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- GrabOn 3 Trust Value Cards -->
      <div class="mx-auto mt-12 grid max-w-4xl grid-cols-1 gap-4 sm:grid-cols-3">
        <div class="flex items-center gap-3.5 rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#eef5ff] text-[#2491ef]">
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
              />
            </svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-[#191f2e]">100% Hand-Verified</h4>
            <p class="text-[11px] text-slate-500">
              Tested daily by real shoppers
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-[#f0fdf4] text-[#60a600]">
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
              />
            </svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-[#191f2e]">Maximum Savings</h4>
            <p class="text-[11px] text-slate-500">
              Up to 80% off on top brands
            </p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 rounded-xl border border-slate-200 bg-white p-4 shadow-2xs">
          <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-orange-50 text-[#ff5722]">
            <svg
              class="h-5 w-5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13 10V3L4 14h7v7l9-11h-7z"
              />
            </svg>
          </div>
          <div>
            <h4 class="text-xs font-bold text-[#191f2e]">Instant Auto-Copy</h4>
            <p class="text-[11px] text-slate-500">One click copy and apply</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Main Content Grid -->
  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8 space-y-14">
    <!-- TOP STORES SECTION (GrabOn Style) -->
    <section>
      <div class="mb-6 flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2">
            <h2 class="text-xl font-extrabold tracking-tight text-[#191f2e] sm:text-2xl">
              Top Stores Of The Day
            </h2>
            <span class="rounded-full bg-[#eef5ff] px-2.5 py-0.5 text-[11px] font-bold text-[#2491ef]">
              {totalStores} Brands
            </span>
          </div>
          <p class="mt-0.5 text-xs text-slate-500">
            Browse trending coupons and exclusive merchant deals
          </p>
        </div>
        <a
          href="/stores"
          class="inline-flex items-center gap-1 text-xs font-bold text-[#2491ef] hover:underline"
        >
          <span>View All Stores</span>
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {stores.slice(0, 8).map((store) => (
          <StoreCard store={store} />
        ))}
      </div>
    </section>

    <!-- POPULAR CATEGORIES (GrabOn Style) -->
    <section>
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-extrabold tracking-tight text-[#191f2e] sm:text-2xl">
            Browse By Category
          </h2>
          <p class="mt-0.5 text-xs text-slate-500">
            Explore coupons tailored to your favorite shopping interests
          </p>
        </div>
        <a
          href="/categories"
          class="inline-flex items-center gap-1 text-xs font-bold text-[#2491ef] hover:underline"
        >
          <span>All Categories</span>
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {categories.map((category) => (
          <CategoryCard category={category} />
        ))}
      </div>
    </section>

    <!-- TOP CODES TODAY (GrabOn Recommended & Flash Deals) -->
    {topCoupons.length > 0 && (
      <section>
        <div class="mb-6 flex items-center justify-between">
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-xl font-extrabold tracking-tight text-[#191f2e] sm:text-2xl">
                Trending Coupons &amp; Flash Deals
              </h2>
              <span class="rounded-full bg-orange-100 px-2.5 py-0.5 text-[11px] font-bold text-[#e65100]">
                Most Popular
              </span>
            </div>
            <p class="mt-0.5 text-xs text-slate-500">
              Highest rated and most redeemed discount codes today
            </p>
          </div>
          <a
            href="/coupons?sort=popular"
            class="inline-flex items-center gap-1 text-xs font-bold text-[#2491ef] hover:underline"
          >
            <span>See All Trending</span>
            <svg
              class="h-3.5 w-3.5"
              fill="none"
              stroke="currentColor"
              stroke-width="2.5"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 5l7 7-7 7"
              />
            </svg>
          </a>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {topCoupons.slice(0, 3).map((coupon, idx) => (
            <CouponCard
              coupon={coupon}
              featuredBadge={idx === 0 ? "RECOMMENDED" : "FLASH DEAL"}
            />
          ))}
        </div>
      </section>
    )}

    <!-- FRESH ACTIVE DEALS FEED -->
    <section id="active-coupons">
      <div class="mb-6 flex items-center justify-between">
        <div>
          <h2 class="text-xl font-extrabold tracking-tight text-[#191f2e] sm:text-2xl">
            Latest Verified Promo Codes
          </h2>
          <p class="mt-0.5 text-xs text-slate-500">
            Freshly updated discounts ready to use at checkout
          </p>
        </div>
        <a
          href="/coupons"
          class="inline-flex items-center gap-1 text-xs font-bold text-[#2491ef] hover:underline"
        >
          <span>Search All ({activeCoupons.length})</span>
          <svg
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </a>
      </div>

      {activeCoupons.length === 0 ? (
        <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
          <p class="font-bold text-slate-700">No active coupons right now.</p>
          <p class="mt-1 text-xs text-slate-500">
            Check back soon for fresh deals.
          </p>
        </div>
      ) : (
        <>
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {activeCoupons.slice(0, 6).map((coupon) => (
              <CouponCard coupon={coupon} />
            ))}
          </div>

          <div class="mt-8 text-center">
            <a
              href="/coupons"
              class="inline-flex items-center gap-2 rounded-lg bg-[#2491ef] px-8 py-3 text-xs font-bold text-white uppercase tracking-wider shadow-sm transition hover:bg-[#129fea] active:scale-95"
            >
              <span>Explore All {activeCoupons.length} Coupons</span>
              <svg
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </a>
          </div>
        </>
      )}
    </section>

    <!-- GrabOn Style FAQ / Content Guide -->
    <section class="rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
      <h3 class="text-lg font-extrabold text-[#191f2e]">
        Frequently Asked Questions About Saving on CouponHub
      </h3>
      <div class="mt-6 grid gap-6 md:grid-cols-2 text-xs leading-relaxed text-slate-600">
        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-800 text-sm">
            How do I use promo codes on CouponHub?
          </h4>
          <p>
            Simply browse your favorite store or coupon offer, click on{" "}
            <strong>SHOW CODE</strong>, and CouponHub will automatically copy
            the promo code to your clipboard and open the merchant's official
            checkout page in a new tab. Paste the code at checkout to apply your
            discount instantly.
          </p>
        </div>
        <div class="space-y-1.5">
          <h4 class="font-bold text-slate-800 text-sm">
            Are all coupons on CouponHub free to use?
          </h4>
          <p>
            Yes, 100%! All promo codes, discount vouchers, and shopping deals
            published on CouponHub are completely free for all shoppers without
            any membership or hidden charges.
          </p>
        </div>
      </div>
    </section>
  </div>
</MainLayout>
