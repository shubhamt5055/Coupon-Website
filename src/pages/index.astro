---
import MainLayout from "../layouts/MainLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import StoreCard from "../components/StoreCard.astro";
import CouponCard from "../components/CouponCard.astro";
import { getDb } from "../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
  getTopCouponsToday,
} from "../lib/db";

const db = getDb();
const [topCoupons, activeCoupons, categories, stores] = await Promise.all([
  getTopCouponsToday(db, 3),
  getCoupons(db, { includeExpired: false, includeInactive: false, sort: "newest" }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const totalActiveDeals = activeCoupons.length;
const totalStores = stores.length;
---

<MainLayout
  title="CouponHub — Best Verified Discount Coupons & Promo Codes"
  description="Save money every day with verified coupon codes and deals from Amazon, Flipkart, Zomato, Swiggy, Myntra, MakeMyTrip, and more."
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gradient-to-br from-indigo-700 via-blue-700 to-indigo-900 px-4 py-16 text-white sm:py-20">
    <div class="pointer-events-none absolute -top-24 -right-24 h-80 w-80 rounded-full bg-white/10 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-80 w-80 rounded-full bg-orange-400/15 blur-3xl"></div>

    <div class="relative mx-auto max-w-4xl text-center">
      <span class="inline-flex items-center gap-2 rounded-full bg-white/15 px-3.5 py-1 text-xs font-semibold tracking-wide text-indigo-100 backdrop-blur-xs">
        <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
        {totalActiveDeals} Verified Active Deals Across {totalStores} Top Stores
      </span>

      <h1 class="mt-5 text-3xl leading-tight font-extrabold tracking-tight sm:text-5xl">
        Save More on Every Order with
        <span class="text-amber-300">Verified Coupons</span>
      </h1>

      <p class="mx-auto mt-4 max-w-2xl text-base text-indigo-100 sm:text-lg">
        Browse active promo codes by store or category, copy in one click, and never miss a real discount.
      </p>

      <div class="mt-8">
        <SearchBar variant="hero" />
      </div>

      <!-- Quick Category Shortcuts -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="text-indigo-200">Popular:</span>
        {categories.slice(0, 5).map((cat) => (
          <a
            href={`/categories/${cat.slug}`}
            class="rounded-full bg-white/10 px-3 py-1 font-medium text-white transition hover:bg-white/20"
          >
            {cat.icon} {cat.name}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bonus: Top Coupons Today (Based on Click Count) -->
  {topCoupons.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-12 sm:px-6 lg:px-8">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div>
          <span class="text-xs font-bold tracking-wider text-orange-600 uppercase dark:text-orange-400">
            Most Redeemed
          </span>
          <h2 class="mt-1 text-2xl font-extrabold text-slate-900 sm:text-3xl dark:text-white">
            🔥 Top Coupons Today
          </h2>
        </div>
        <a
          href="/coupons?sort=popular"
          class="text-sm font-bold text-indigo-600 hover:underline dark:text-indigo-400"
        >
          View Most Popular →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topCoupons.map((coupon, idx) => (
          <CouponCard
            coupon={coupon}
            featuredBadge={idx === 0 ? "#1 Trending" : "Top Pick"}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Browse by Category -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-end justify-between gap-3">
      <div>
        <span class="text-xs font-bold tracking-wider text-indigo-600 uppercase dark:text-indigo-400">
          Shop by Interest
        </span>
        <h2 class="mt-1 text-2xl font-extrabold text-slate-900 sm:text-3xl dark:text-white">
          Browse Categories
        </h2>
      </div>
      <a
        href="/categories"
        class="text-sm font-bold text-indigo-600 hover:underline dark:text-indigo-400"
      >
        All Categories →
      </a>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {categories.slice(0, 6).map((category) => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <!-- All Active Coupons -->
  <section id="active-coupons" class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
      <div>
        <span class="text-xs font-bold tracking-wider text-emerald-600 uppercase dark:text-emerald-400">
          Freshly Updated
        </span>
        <h2 class="mt-1 text-2xl font-extrabold text-slate-900 sm:text-3xl dark:text-white">
          All Active Coupons
        </h2>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <a
          href="/coupons?includeExpired=1"
          class="font-medium text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white"
        >
          View Expired
        </a>
        <a
          href="/coupons"
          class="font-bold text-indigo-600 hover:underline dark:text-indigo-400"
        >
          Filter &amp; Search All →
        </a>
      </div>
    </div>

    {activeCoupons.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900">
        <p class="text-lg font-bold text-slate-800 dark:text-slate-200">No active coupons right now.</p>
        <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">
          Check back soon or add coupons from the Admin Panel.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {activeCoupons.map((coupon) => (
          <CouponCard coupon={coupon} />
        ))}
      </div>
    )}
  </section>

  <!-- Popular Stores -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
    <div class="mb-6 flex items-end justify-between gap-3">
      <div>
        <span class="text-xs font-bold tracking-wider text-indigo-600 uppercase dark:text-indigo-400">
          Trusted Brands
        </span>
        <h2 class="mt-1 text-2xl font-extrabold text-slate-900 sm:text-3xl dark:text-white">
          Popular Stores
        </h2>
      </div>
      <a
        href="/stores"
        class="text-sm font-bold text-indigo-600 hover:underline dark:text-indigo-400"
      >
        All Stores →
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {stores.slice(0, 8).map((store) => (
        <StoreCard store={store} />
      ))}
    </div>
  </section>
</MainLayout>
