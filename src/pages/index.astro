---
import MainLayout from "../layouts/MainLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import StoreCard from "../components/StoreCard.astro";
import CouponCard from "../components/CouponCard.astro";
import { getDb } from "../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
  getTopCouponsToday,
} from "../lib/db";

const db = getDb();
const [topCoupons, activeCoupons, categories, stores] = await Promise.all([
  getTopCouponsToday(db, 3),
  getCoupons(db, { includeExpired: false, includeInactive: false, sort: "newest" }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const totalActiveDeals = activeCoupons.length;
const totalStores = stores.length;
---

<MainLayout
  title="CouponHub — Hand-Verified Discount Coupons & Promo Codes That Work"
  description="Stop overpaying online. Find 100% verified coupons, promo codes, and discount deals for Amazon, Swiggy, Nike, Myntra, Domino's, and 15+ top stores."
>
  <!-- Hero Section: Human, Warm, High-Trust Savings Canvas -->
  <section class="relative overflow-hidden border-b border-slate-200/70 bg-gradient-to-b from-emerald-50/60 via-slate-50/40 to-white pt-14 pb-16 sm:pt-20 sm:pb-24">
    <!-- Subtle ambient background gradients -->
    <div class="pointer-events-none absolute -top-20 left-1/2 h-96 w-[700px] -translate-x-1/2 rounded-full bg-emerald-200/20 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute top-1/3 -right-24 h-72 w-72 rounded-full bg-teal-200/20 blur-2xl" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-4xl px-4 text-center sm:px-6">
      <!-- Human Trust Pill -->
      <div class="inline-flex items-center gap-2 rounded-full border border-emerald-200/80 bg-white/90 px-4 py-1.5 text-xs font-bold text-emerald-900 shadow-2xs backdrop-blur-md">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500 animate-soft-pulse"></span>
        <span>{totalActiveDeals} Verified Working Deals Today Across {totalStores} Top Stores</span>
      </div>

      <!-- Main Headline with Human Copywriting -->
      <h1 class="mt-6 text-3xl font-black tracking-tight text-slate-900 sm:text-5xl sm:leading-[1.15] lg:text-6xl">
        Never Pay Full Price Online.
        <span class="block bg-gradient-to-r from-emerald-600 via-teal-600 to-indigo-600 bg-clip-text text-transparent">
          Working Promo Codes in 1 Click.
        </span>
      </h1>

      <p class="mx-auto mt-5 max-w-2xl text-base font-medium leading-relaxed text-slate-600 sm:text-lg">
        Stop testing expired codes that waste your time. Our deal community hand-tests coupons daily so you always save at checkout.
      </p>

      <!-- Search Bar -->
      <div class="mt-8">
        <SearchBar variant="hero" />
      </div>

      <!-- Quick Store Chips (Human touch) -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="font-bold text-slate-400">Popular Stores:</span>
        {stores.slice(0, 6).map((store) => (
          <a
            href={`/stores/${store.slug}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 font-bold text-slate-700 shadow-2xs transition hover:border-emerald-300 hover:bg-emerald-50/50 hover:text-emerald-800"
          >
            <span>{store.name}</span>
            <span class="text-[10px] text-slate-400">({store.active_coupon_count ?? 0})</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Live Value Proposition / Trust Bar -->
  <section class="border-b border-slate-200/80 bg-white py-6">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3 sm:gap-6">
        <div class="flex items-center gap-3.5 rounded-2xl bg-slate-50/80 p-4 border border-slate-200/60 shadow-2xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-100 text-xl font-bold text-emerald-800">
            🛡️
          </div>
          <div>
            <h4 class="text-sm font-black text-slate-900">100% Hand-Tested Codes</h4>
            <p class="text-xs font-medium text-slate-500">Every deal is verified on real store checkouts.</p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 rounded-2xl bg-slate-50/80 p-4 border border-slate-200/60 shadow-2xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-xl font-bold text-indigo-800">
            ✂️
          </div>
          <div>
            <h4 class="text-sm font-black text-slate-900">Instant 1-Click Copy</h4>
            <p class="text-xs font-medium text-slate-500">Code is copied to your clipboard &amp; store opens.</p>
          </div>
        </div>

        <div class="flex items-center gap-3.5 rounded-2xl bg-slate-50/80 p-4 border border-slate-200/60 shadow-2xs">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-xl font-bold text-amber-800">
            💰
          </div>
          <div>
            <h4 class="text-sm font-black text-slate-900">Free Community Savings</h4>
            <p class="text-xs font-medium text-slate-500">Join thousands of smart shoppers saving daily.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 1: Most Redeemed Deals Today -->
  {topCoupons.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
        <div>
          <div class="inline-flex items-center gap-1.5 text-xs font-black tracking-wider text-orange-600 uppercase">
            <span>🔥</span>
            <span>Trending Right Now</span>
          </div>
          <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
            Today's Hottest Deals
          </h2>
          <p class="mt-1 text-xs font-medium text-slate-500">
            The most used promo codes by shoppers in the last 24 hours.
          </p>
        </div>
        <a
          href="/coupons?sort=popular"
          class="inline-flex items-center gap-1 text-sm font-bold text-emerald-700 hover:text-emerald-800 hover:underline"
        >
          <span>View All Trending Deals</span>
          <span>→</span>
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topCoupons.map((coupon, idx) => (
          <CouponCard
            coupon={coupon}
            featuredBadge={idx === 0 ? "🔥 #1 Most Used" : "⚡ Editor's Pick"}
          />
        ))}
      </div>
    </section>
  )}

  <!-- Section 2: Browse by Category -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div>
        <span class="text-xs font-black tracking-wider text-emerald-700 uppercase">
          Curated Collections
        </span>
        <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          Browse by Category
        </h2>
        <p class="mt-1 text-xs font-medium text-slate-500">
          Find coupons for food delivery, fashion apparel, electronics, and travel.
        </p>
      </div>
      <a
        href="/categories"
        class="text-sm font-bold text-emerald-700 hover:text-emerald-800 hover:underline"
      >
        All Categories →
      </a>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {categories.slice(0, 6).map((category) => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <!-- Section 3: All Active Coupons -->
  <section id="active-coupons" class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4">
      <div>
        <span class="text-xs font-black tracking-wider text-emerald-700 uppercase">
          Fresh Discount Vouchers
        </span>
        <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          Latest Verified Coupons
        </h2>
        <p class="mt-1 text-xs font-medium text-slate-500">
          Recently tested promo codes ready to copy and apply.
        </p>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <a
          href="/coupons?includeExpired=1"
          class="font-semibold text-slate-400 hover:text-slate-600"
        >
          Expired Archive
        </a>
        <a
          href="/coupons"
          class="inline-flex items-center gap-1 font-bold text-emerald-700 hover:text-emerald-800 hover:underline"
        >
          <span>Explore All ({totalActiveDeals})</span>
          <span>→</span>
        </a>
      </div>
    </div>

    {activeCoupons.length === 0 ? (
      <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-xs">
        <p class="text-lg font-bold text-slate-800">No active coupons available right now.</p>
        <p class="mt-2 text-sm text-slate-500">
          Please check back shortly or submit a working deal.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {activeCoupons.map((coupon) => (
          <CouponCard coupon={coupon} />
        ))}
      </div>
    )}
  </section>

  <!-- Section 4: Popular Stores -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex items-end justify-between gap-4">
      <div>
        <span class="text-xs font-black tracking-wider text-indigo-600 uppercase">
          Top Retailers
        </span>
        <h2 class="mt-1 text-2xl font-black tracking-tight text-slate-900 sm:text-3xl">
          Shop by Store
        </h2>
        <p class="mt-1 text-xs font-medium text-slate-500">
          Browse dedicated discount hub pages for your favorite brands.
        </p>
      </div>
      <a
        href="/stores"
        class="text-sm font-bold text-emerald-700 hover:text-emerald-800 hover:underline"
      >
        All Stores ({totalStores}) →
      </a>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {stores.slice(0, 8).map((store) => (
        <StoreCard store={store} />
      ))}
    </div>
  </section>

  <!-- Section 5: Community Callout (Human, Warm & Engaging) -->
  <section class="mx-auto max-w-7xl px-4 pt-16 pb-8 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl border border-emerald-900/10 bg-gradient-to-br from-slate-900 via-slate-800 to-emerald-950 p-8 text-white shadow-xl sm:p-12">
      <div class="relative z-10 flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 rounded-full bg-emerald-500/20 px-3.5 py-1 text-xs font-black text-emerald-300 ring-1 ring-emerald-500/30">
            <span>🤝</span>
            <span>Join Our Deal Community</span>
          </div>
          <h2 class="mt-4 text-2xl font-black tracking-tight sm:text-3xl">
            Found a discount code that worked for you?
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-slate-300 sm:text-base">
            Help thousands of shoppers save money. Sign in with a free account, submit working promo codes, and get verified deals published live!
          </p>
        </div>
        <a
          href="/login"
          class="shrink-0 inline-flex items-center gap-2 rounded-2xl bg-emerald-500 px-7 py-4 text-sm font-black text-slate-950 shadow-md transition hover:bg-emerald-400 active:scale-95 focus:outline-none"
        >
          <span>Get Started Free →</span>
        </a>
      </div>
    </div>
  </section>
</MainLayout>
