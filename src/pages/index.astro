---
import MainLayout from "../layouts/MainLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import StoreCard from "../components/StoreCard.astro";
import CouponCard from "../components/CouponCard.astro";
import StoreLogo from "../components/StoreLogo.astro";
import { getDb } from "../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
  getTopCouponsToday,
} from "../lib/db";

const db = getDb();
const [topCoupons, activeCoupons, categories, stores] = await Promise.all([
  getTopCouponsToday(db, 3),
  getCoupons(db, { includeExpired: false, includeInactive: false, sort: "newest" }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const totalActiveDeals = activeCoupons.length;
const totalStores = stores.length;
---

<MainLayout
  title="CouponHub — Best Verified Discount Coupons & Promo Codes"
  description="Save money every day with verified coupon codes and deals from Amazon, Flipkart, Zomato, Swiggy, Myntra, MakeMyTrip, and more."
>
  <!-- Hero Section in Vibrant Modern Palette (#581C87, #9333EA, #EC4899, #FACC15, #14B8A6, #38BDF8, #F8FAFC) -->
  <section class="relative overflow-hidden border-b border-purple-100/80 bg-gradient-to-b from-purple-100/70 via-pink-50/30 to-[#F8FAFC] px-4 py-14 sm:py-20">
    <div class="pointer-events-none absolute -top-24 -right-24 h-96 w-96 rounded-full bg-[#EC4899]/15 blur-3xl"></div>
    <div class="pointer-events-none absolute -bottom-24 -left-24 h-96 w-96 rounded-full bg-[#9333EA]/15 blur-3xl"></div>
    <div class="pointer-events-none absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 h-64 w-64 rounded-full bg-[#FACC15]/10 blur-3xl"></div>

    <div class="relative mx-auto max-w-4xl text-center">
      <!-- Human Trust Pill -->
      <span class="inline-flex items-center gap-2 rounded-full border border-[#EC4899]/30 bg-gradient-to-r from-purple-50 via-pink-50 to-amber-50 px-4 py-1 text-xs font-black tracking-wide text-[#581C87] shadow-2xs">
        <span class="h-2 w-2 rounded-full bg-[#14B8A6] animate-soft-pulse"></span>
        <span>{totalActiveDeals} Working Deals Across {totalStores} Top Stores Today</span>
      </span>

      <!-- Main Headline -->
      <h1 class="mt-4 text-3xl font-black leading-tight tracking-tight text-[#581C87] sm:text-5xl">
        Save More on Every Order with <br class="hidden sm:inline" />
        <span class="bg-gradient-to-r from-[#9333EA] via-[#EC4899] to-[#eab308] bg-clip-text text-transparent">
          100% Verified Coupons
        </span>
      </h1>

      <p class="mx-auto mt-3.5 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
        Tested and hand-verified promo codes for India's biggest brands. Copy discount codes in one click and never pay full price again.
      </p>

      <!-- Search Bar -->
      <div class="mx-auto mt-7 max-w-2xl">
        <SearchBar variant="hero" />
      </div>

      <!-- Quick Store Chips with authentic mini logos -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-xs">
        <span class="font-bold text-slate-400">Popular Stores:</span>
        {stores.slice(0, 6).map((s) => (
          <a
            href={`/stores/${s.slug}`}
            class="group inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 font-bold text-slate-700 shadow-2xs transition hover:border-[#9333EA] hover:bg-purple-50 hover:text-[#581C87] hover:shadow-xs"
          >
            <div class="h-4 w-4 shrink-0 overflow-hidden rounded-full flex items-center justify-center">
              <StoreLogo store={s} size="sm" />
            </div>
            <span>{s.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Top Stores Showcase (High Priority Section) -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-gradient-to-r from-purple-50 to-pink-50 border border-[#9333EA]/30 px-2 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#581C87]">
            Top Partners
          </span>
          <span class="text-xs font-semibold text-slate-400">Verified Stores</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#581C87] sm:text-3xl">
          Popular Partner Stores
        </h2>
        <p class="mt-1 text-xs text-slate-500 sm:text-sm">
          Browse exclusive discounts, coupon codes, and seasonal savings from India's favorite shopping platforms.
        </p>
      </div>
      <a
        href="/stores"
        class="inline-flex items-center gap-1 text-sm font-black text-[#9333EA] hover:text-[#EC4899] hover:underline transition"
      >
        <span>All {stores.length} Stores</span>
        <span>→</span>
      </a>
    </div>

    <!-- Store Cards Grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {stores.slice(0, 8).map((store) => (
        <StoreCard store={store} />
      ))}
    </div>
  </section>

  <!-- Browse by Category Section -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-gradient-to-r from-pink-50 to-purple-50 border border-[#EC4899]/30 px-2 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#EC4899]">
            Explore Deals
          </span>
          <span class="text-xs font-semibold text-slate-400">Organized by Interest</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#581C87] sm:text-3xl">
          Browse Categories
        </h2>
        <p class="mt-1 text-xs text-slate-500 sm:text-sm">
          Select a category to find active discount codes across Food, Fashion, Electronics, Travel, and more.
        </p>
      </div>
      <a
        href="/categories"
        class="inline-flex items-center gap-1 text-sm font-black text-[#9333EA] hover:text-[#EC4899] hover:underline transition"
      >
        <span>All Categories</span>
        <span>→</span>
      </a>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {categories.map((category) => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <!-- Trending / Top Coupons Today -->
  {topCoupons.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-md bg-gradient-to-r from-amber-50 to-pink-50 border border-[#FACC15]/60 px-2 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#581C87]">
              🔥 Trending Today
            </span>
            <span class="text-xs font-semibold text-slate-400">Most Redeemed Offers</span>
          </div>
          <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#581C87] sm:text-3xl">
            Today's Top Discount Codes
          </h2>
        </div>
        <a
          href="/coupons?sort=popular"
          class="text-sm font-black text-[#9333EA] hover:text-[#EC4899] hover:underline transition"
        >
          View Most Popular Deals →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topCoupons.map((coupon, idx) => (
          <CouponCard
            coupon={coupon}
            featuredBadge={idx === 0 ? "#1 Trending" : "Top Pick"}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All Active Coupons Grid -->
  <section id="active-coupons" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-gradient-to-r from-teal-50 to-sky-50 border border-[#14B8A6]/30 px-2 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#14B8A6]">
            Fresh Codes
          </span>
          <span class="text-xs font-semibold text-slate-400">Verified &amp; Working</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#581C87] sm:text-3xl">
          All Active Coupons
        </h2>
      </div>
      <div class="flex items-center gap-3 text-xs font-bold sm:text-sm">
        <a
          href="/coupons?includeExpired=1"
          class="font-semibold text-slate-400 hover:text-[#581C87] transition"
        >
          View Expired
        </a>
        <span>•</span>
        <a
          href="/coupons"
          class="font-black text-[#9333EA] hover:text-[#EC4899] hover:underline transition"
        >
          Filter &amp; Search All ({activeCoupons.length}) →
        </a>
      </div>
    </div>

    {activeCoupons.length === 0 ? (
      <div class="rounded-3xl border border-dashed border-[#9333EA]/30 bg-white p-12 text-center shadow-xs">
        <p class="text-base font-extrabold text-[#581C87]">No active coupons right now.</p>
        <p class="mt-1 text-xs text-slate-500">
          Check back soon or share a coupon from your account.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {activeCoupons.map((coupon) => (
          <CouponCard coupon={coupon} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
