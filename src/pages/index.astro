---
import MainLayout from "../layouts/MainLayout.astro";
import SearchBar from "../components/SearchBar.astro";
import CategoryCard from "../components/CategoryCard.astro";
import StoreCard from "../components/StoreCard.astro";
import CouponCard from "../components/CouponCard.astro";
import StoreLogo from "../components/StoreLogo.astro";
import { getDb } from "../lib/cloudflare";
import {
  getCategoriesWithCounts,
  getCoupons,
  getStoresWithCounts,
  getTopCouponsToday,
} from "../lib/db";

const db = getDb();
const [topCoupons, activeCoupons, categories, stores] = await Promise.all([
  getTopCouponsToday(db, 3),
  getCoupons(db, { includeExpired: false, includeInactive: false, sort: "newest" }),
  getCategoriesWithCounts(db),
  getStoresWithCounts(db),
]);

const totalActiveDeals = activeCoupons.length;
const totalStores = stores.length;
---

<MainLayout
  title="Couponly — Best Verified Promo Codes & Discount Coupons"
  description="Save money every day with 100% verified coupon codes and deals from top online stores."
>
  <!-- Hero Section (Couponly Index-3 Style) -->
  <section class="relative bg-gradient-to-b from-[#FFF9F5] via-[#F8FAFC] to-[#F8FAFC] px-4 pt-10 pb-16 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <!-- Hero Top Heading & Search Bar -->
      <div class="mx-auto max-w-3xl text-center">
        <!-- Live Trust Badge -->
        <span class="inline-flex items-center gap-2 rounded-full border border-[#FF7A18]/25 bg-[#FFF2E8] px-4 py-1 text-xs font-black text-[#FF7A18] shadow-2xs">
          <span class="h-2 w-2 rounded-full bg-[#FF7A18] animate-soft-pulse"></span>
          <span>{totalActiveDeals} Verified Working Deals Across {totalStores} Stores</span>
        </span>

        <!-- Main Title -->
        <h1 class="mt-4 text-3xl font-black leading-tight tracking-tight text-[#081126] sm:text-5xl">
          Get The Best <span class="text-[#0499FA]">Discounts &amp; Vouchers</span> <br class="hidden sm:inline" />
          For Your Favorite Stores
        </h1>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
          Tested daily by deal hunters. Click to copy exclusive discount codes and save instantly at checkout.
        </p>

        <!-- Search Bar -->
        <div class="mx-auto mt-7 max-w-2xl">
          <SearchBar variant="hero" />
        </div>

        <!-- Quick Store Chips with Mini Logos -->
        <div class="mt-5 flex flex-wrap items-center justify-center gap-2 text-xs">
          <span class="font-bold text-slate-400">Popular:</span>
          {stores.slice(0, 6).map((s) => (
            <a
              href={`/stores/${s.slug}`}
              class="group inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-3 py-1 font-bold text-[#081126] shadow-2xs transition hover:border-[#0499FA] hover:bg-[#EAF6FE] hover:text-[#0499FA]"
            >
              <div class="h-4 w-4 shrink-0 overflow-hidden rounded-full flex items-center justify-center">
                <StoreLogo store={s} size="sm" />
              </div>
              <span>{s.name}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Couponly Index-3: 3-Banner Promotional Showcase -->
      <div class="mt-12 grid gap-6 md:grid-cols-3">
        <!-- Banner 1: Left Special Offer -->
        <div class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#EAF6FE] to-white border border-[#0499FA]/20 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <span class="inline-block rounded-full bg-[#0499FA] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-white">
            Daily Flash Deal
          </span>
          <h3 class="mt-3 text-xl font-black text-[#081126]">
            Up to 50% Off Top Brands
          </h3>
          <p class="mt-1 text-xs text-slate-600">
            Exclusive verified vouchers on electronics &amp; fashion.
          </p>
          <div class="mt-5 flex items-center justify-between">
            <span class="text-xs font-bold text-[#0499FA]">Updated 10m ago</span>
            <a
              href="/coupons"
              class="inline-flex items-center gap-1 text-xs font-black text-[#081126] hover:text-[#0499FA] transition"
            >
              <span>Explore</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Banner 2: Center Super Sale (Accent Sunset Orange) -->
        <div class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#FF7A18] to-[#E6680C] p-6 text-white shadow-lg shadow-[#FF7A18]/25 transition hover:-translate-y-1">
          <span class="inline-block rounded-full bg-white/20 backdrop-blur-xs px-3 py-1 text-[11px] font-black uppercase tracking-wider text-white">
            Super Sale Week
          </span>
          <h3 class="mt-3 text-2xl font-black text-white">
            Flat 60% OFF Today
          </h3>
          <p class="mt-1 text-xs text-orange-100">
            Special coupon codes for online food orders &amp; flights.
          </p>
          <div class="mt-5 flex items-center justify-between">
            <span class="rounded-lg bg-white/20 px-2.5 py-1 font-mono text-xs font-black tracking-widest text-white">
              SAVEBIG60
            </span>
            <a
              href="/coupons?sort=popular"
              class="inline-flex items-center gap-1 rounded-full bg-white px-3.5 py-1.5 text-xs font-black text-[#FF7A18] shadow-xs hover:bg-orange-50 transition"
            >
              <span>Claim Deals</span>
              <span>→</span>
            </a>
          </div>
        </div>

        <!-- Banner 3: Right Cashback & Rewards -->
        <div class="group relative overflow-hidden rounded-2xl bg-gradient-to-br from-[#FFF9F5] to-white border border-[#FF7A18]/25 p-6 shadow-sm transition hover:-translate-y-1 hover:shadow-md">
          <span class="inline-block rounded-full bg-[#FF7A18] px-3 py-1 text-[11px] font-black uppercase tracking-wider text-white">
            Verified Codes
          </span>
          <h3 class="mt-3 text-xl font-black text-[#081126]">
            100% Guaranteed To Work
          </h3>
          <p class="mt-1 text-xs text-slate-600">
            Every coupon is human-checked to guarantee real savings.
          </p>
          <div class="mt-5 flex items-center justify-between">
            <span class="text-xs font-bold text-emerald-600">✓ Tested Today</span>
            <a
              href="/coupons"
              class="inline-flex items-center gap-1 text-xs font-black text-[#081126] hover:text-[#FF7A18] transition"
            >
              <span>View Codes</span>
              <span>→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Couponly 3-Step "How It Works" Section -->
  <section class="border-y border-slate-200/80 bg-white py-12 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="text-center mb-9">
        <span class="text-xs font-black uppercase tracking-wider text-[#0499FA]">Easy Savings</span>
        <h2 class="mt-1 text-2xl font-black text-[#081126] sm:text-3xl">How Couponly Works</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-3">
        <!-- Step 1 -->
        <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-[#F8FAFC] p-5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#EAF6FE] text-lg font-black text-[#0499FA]">
            1
          </div>
          <div>
            <h3 class="text-base font-black text-[#081126]">Find Your Store</h3>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">
              Search Amazon, Flipkart, Swiggy or pick from our trending partner stores.
            </p>
          </div>
        </div>

        <!-- Step 2 -->
        <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-[#F8FAFC] p-5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-[#FFF2E8] text-lg font-black text-[#FF7A18]">
            2
          </div>
          <div>
            <h3 class="text-base font-black text-[#081126]">Reveal &amp; Copy Code</h3>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">
              Click "Show Coupon" — the promo code copies automatically to your clipboard.
            </p>
          </div>
        </div>

        <!-- Step 3 -->
        <div class="flex items-start gap-4 rounded-2xl border border-slate-100 bg-[#F8FAFC] p-5">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-lg font-black text-emerald-600">
            3
          </div>
          <div>
            <h3 class="text-base font-black text-[#081126]">Paste &amp; Save Money</h3>
            <p class="mt-1 text-xs text-slate-600 leading-relaxed">
              Apply code at checkout on the store site and enjoy instant discount!
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular Partner Stores (Couponly Style) -->
  <section class="mx-auto max-w-7xl px-4 pt-14 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-[#EAF6FE] px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#0499FA]">
            Top Partners
          </span>
          <span class="text-xs font-semibold text-slate-400">Verified Stores</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#081126] sm:text-3xl">
          Popular Partner Stores
        </h2>
        <p class="mt-1 text-xs text-slate-500 sm:text-sm">
          Browse exclusive discounts, coupon codes, and seasonal savings from India's favorite shopping platforms.
        </p>
      </div>
      <a
        href="/stores"
        class="inline-flex items-center gap-1 text-sm font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline transition"
      >
        <span>All {stores.length} Stores</span>
        <span>→</span>
      </a>
    </div>

    <!-- Store Cards Grid -->
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {stores.slice(0, 8).map((store) => (
        <StoreCard store={store} />
      ))}
    </div>
  </section>

  <!-- Browse by Category Section -->
  <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-[#FFF2E8] px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#FF7A18]">
            Explore Deals
          </span>
          <span class="text-xs font-semibold text-slate-400">Organized by Interest</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#081126] sm:text-3xl">
          Browse Categories
        </h2>
        <p class="mt-1 text-xs text-slate-500 sm:text-sm">
          Select a category to find active discount codes across Food, Fashion, Electronics, Travel, and more.
        </p>
      </div>
      <a
        href="/categories"
        class="inline-flex items-center gap-1 text-sm font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline transition"
      >
        <span>All Categories</span>
        <span>→</span>
      </a>
    </div>

    <!-- Category Cards Grid -->
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
      {categories.map((category) => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>

  <!-- Trending / Top Coupons Today -->
  {topCoupons.length > 0 && (
    <section class="mx-auto max-w-7xl px-4 pt-16 sm:px-6 lg:px-8">
      <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-flex items-center rounded-md bg-[#FFF2E8] px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider text-[#FF7A18]">
              🔥 Trending Today
            </span>
            <span class="text-xs font-semibold text-slate-400">Most Redeemed Offers</span>
          </div>
          <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#081126] sm:text-3xl">
            Today's Top Discount Codes
          </h2>
        </div>
        <a
          href="/coupons?sort=popular"
          class="text-sm font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline transition"
        >
          View Most Popular Deals →
        </a>
      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {topCoupons.map((coupon, idx) => (
          <CouponCard
            coupon={coupon}
            featuredBadge={idx === 0 ? "#1 Trending" : "Top Pick"}
          />
        ))}
      </div>
    </section>
  )}

  <!-- All Active Coupons Grid -->
  <section id="active-coupons" class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-3">
      <div>
        <div class="flex items-center gap-2">
          <span class="inline-flex items-center rounded-md bg-emerald-50 px-2.5 py-0.5 text-[11px] font-black uppercase tracking-wider text-emerald-600">
            Fresh Codes
          </span>
          <span class="text-xs font-semibold text-slate-400">Verified &amp; Working</span>
        </div>
        <h2 class="mt-1.5 text-2xl font-black tracking-tight text-[#081126] sm:text-3xl">
          All Active Coupons
        </h2>
      </div>
      <div class="flex items-center gap-3 text-xs font-bold sm:text-sm">
        <a
          href="/coupons?includeExpired=1"
          class="font-semibold text-slate-400 hover:text-[#081126] transition"
        >
          View Expired
        </a>
        <span>•</span>
        <a
          href="/coupons"
          class="font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline transition"
        >
          Filter &amp; Search All ({activeCoupons.length}) →
        </a>
      </div>
    </div>

    {activeCoupons.length === 0 ? (
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center shadow-xs">
        <p class="text-base font-extrabold text-[#081126]">No active coupons right now.</p>
        <p class="mt-1 text-xs text-slate-500">
          Check back soon or share a coupon from your account.
        </p>
      </div>
    ) : (
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {activeCoupons.map((coupon) => (
          <CouponCard coupon={coupon} />
        ))}
      </div>
    )}
  </section>
</MainLayout>
