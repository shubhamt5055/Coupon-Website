---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="CouponHub | Best Deals & Coupons">

  <main class="min-h-screen">

    <!-- Navbar -->
    <header class="bg-white shadow-sm">
      <nav class="mx-auto flex max-w-7xl items-center justify-between px-4 py-4">

        <a href="/" class="text-2xl font-bold text-blue-600">
          CouponHub
        </a>

        <div class="hidden gap-6 md:flex">
          <a href="/" class="text-gray-700 hover:text-blue-600">
            Home
          </a>

          <a href="/coupons" class="text-gray-700 hover:text-blue-600">
            Coupons
          </a>

          <a href="/categories" class="text-gray-700 hover:text-blue-600">
            Categories
          </a>

          <a href="/stores" class="text-gray-700 hover:text-blue-600">
            Stores
          </a>
        </div>

        <button class="rounded-lg bg-blue-600 px-4 py-2 text-white">
          Explore Deals
        </button>

      </nav>
    </header>


    <!-- Hero Section -->
    <section class="bg-gradient-to-r from-blue-600 to-indigo-700 px-4 py-20 text-center text-white">

      <div class="mx-auto max-w-4xl">

        <h1 class="mb-4 text-4xl font-bold md:text-6xl">
          Save More with
          <span class="text-yellow-300">Best Coupons</span>
        </h1>

        <p class="mb-8 text-lg text-blue-100">
          Discover the best deals, discounts and coupon codes
          from your favorite stores.
        </p>

        <!-- Search -->
        <div class="mx-auto flex max-w-2xl flex-col gap-3 rounded-xl bg-white p-3 sm:flex-row">

          <input
            type="text"
            placeholder="Search store or coupon..."
            class="flex-1 rounded-lg px-4 py-3 text-gray-800 outline-none"
          />

          <button class="rounded-lg bg-orange-500 px-6 py-3 font-semibold text-white hover:bg-orange-600">
            Search
          </button>

        </div>

      </div>

    </section>


    <!-- Categories -->
    <section class="mx-auto max-w-7xl px-4 py-12">

      <h2 class="mb-6 text-3xl font-bold">
        Browse Categories
      </h2>

      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">

        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mb-3 text-4xl">🛍️</div>
          <h3 class="font-semibold">Shopping</h3>
        </div>

        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mb-3 text-4xl">🍔</div>
          <h3 class="font-semibold">Food</h3>
        </div>

        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mb-3 text-4xl">📱</div>
          <h3 class="font-semibold">Electronics</h3>
        </div>

        <div class="rounded-xl bg-white p-6 text-center shadow-sm">
          <div class="mb-3 text-4xl">✈️</div>
          <h3 class="font-semibold">Travel</h3>
        </div>

      </div>

    </section>


    <!-- Featured Coupons -->
    <section class="mx-auto max-w-7xl px-4 py-12">

      <div class="mb-6 flex items-center justify-between">

        <h2 class="text-3xl font-bold">
          Featured Coupons
        </h2>

        <a href="/coupons" class="font-semibold text-blue-600">
          View All →
        </a>

      </div>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <!-- Coupon 1 -->
        <div class="rounded-xl bg-white p-6 shadow-md">

          <div class="mb-4 flex items-center justify-between">
            <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-700">
              20% OFF
            </span>

            <span class="text-sm text-gray-500">
              Amazon
            </span>
          </div>

          <h3 class="mb-2 text-xl font-bold">
            20% Off Electronics
          </h3>

          <p class="mb-4 text-gray-600">
            Get amazing discounts on selected electronics.
          </p>

          <div class="flex items-center justify-between rounded-lg border border-dashed border-blue-500 p-3">

            <span class="font-bold text-blue-600">
              SAVE20
            </span>

            <button class="rounded-md bg-blue-600 px-3 py-2 text-white">
              Copy Code
            </button>

          </div>

        </div>


        <!-- Coupon 2 -->
        <div class="rounded-xl bg-white p-6 shadow-md">

          <div class="mb-4 flex items-center justify-between">
            <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-700">
              ₹500 OFF
            </span>

            <span class="text-sm text-gray-500">
              Flipkart
            </span>
          </div>

          <h3 class="mb-2 text-xl font-bold">
            Flat ₹500 Discount
          </h3>

          <p class="mb-4 text-gray-600">
            Save ₹500 on your next shopping order.
          </p>

          <div class="flex items-center justify-between rounded-lg border border-dashed border-blue-500 p-3">

            <span class="font-bold text-blue-600">
              FLAT500
            </span>

            <button class="rounded-md bg-blue-600 px-3 py-2 text-white">
              Copy Code
            </button>

          </div>

        </div>


        <!-- Coupon 3 -->
        <div class="rounded-xl bg-white p-6 shadow-md">

          <div class="mb-4 flex items-center justify-between">
            <span class="rounded-full bg-green-100 px-3 py-1 text-sm text-green-700">
              30% OFF
            </span>

            <span class="text-sm text-gray-500">
              Myntra
            </span>
          </div>

          <h3 class="mb-2 text-xl font-bold">
            Fashion Discount
          </h3>

          <p class="mb-4 text-gray-600">
            Get discounts on your favorite fashion products.
          </p>

          <div class="flex items-center justify-between rounded-lg border border-dashed border-blue-500 p-3">

            <span class="font-bold text-blue-600">
              FASHION30
            </span>

            <button class="rounded-md bg-blue-600 px-3 py-2 text-white">
              Copy Code
            </button>

          </div>

        </div>

      </div>

    </section>


    <!-- Footer -->
    <footer class="bg-gray-900 px-4 py-8 text-center text-white">

      <h2 class="mb-2 text-xl font-bold">
        CouponHub
      </h2>

      <p class="text-gray-400">
        Find the best coupons and save money.
      </p>

      <p class="mt-4 text-sm text-gray-500">
        © 2026 CouponHub. All rights reserved.
      </p>

    </footer>

  </main>

</MainLayout>