---
import MainLayout from "../../layouts/MainLayout.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoriesWithCounts } from "../../lib/db";

const categories = await getCategoriesWithCounts(getDb());
---

<MainLayout
  title="All Coupon Categories | CouponHub"
  description="Browse discount coupons by category: Food, Fashion, Electronics, Travel, Shopping, Beauty and more."
>
  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">
        Browse by Category
      </h1>
      <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
        Explore verified coupons organized across {categories.length} shopping categories.
      </p>
    </div>

    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {categories.map((category) => (
        <CategoryCard category={category} />
      ))}
    </div>
  </section>
</MainLayout>
