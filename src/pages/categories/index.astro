---
import MainLayout from "../../layouts/MainLayout.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoriesWithCounts } from "../../lib/db";

const categories = await getCategoriesWithCounts(getDb());
const totalDeals = categories.reduce((sum, c) => sum + (c.active_coupon_count ?? 0), 0);
---

<MainLayout
  title="All Coupon Categories — CouponHub"
  description="Browse discount coupons by category: Food, Fashion, Electronics, Travel, Shopping, Beauty and more."
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Header Banner -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#0499FA]/20 bg-[#EAF6FE] px-3.5 py-1 text-xs font-black text-[#0499FA] shadow-2xs">
        <span class="h-2 w-2 rounded-full bg-[#0499FA] animate-soft-pulse"></span>
        <span>{categories.length} Categories · {totalDeals} Working Deals Live</span>
      </div>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-[#081126] sm:text-4xl">
        Explore Deals by Category
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500">
        Choose your category below to unlock instant discounts, exclusive promo codes, and verified deals for your next purchase.
      </p>

      <!-- Instant Filter Input -->
      <div class="mt-6 max-w-md">
        <div class="relative">
          <input
            type="text"
            id="category-search-input"
            placeholder="Search categories (e.g., Food, Electronics, Fashion)..."
            class="w-full rounded-full border border-slate-200 bg-white py-3 pr-4 pl-11 text-sm font-semibold text-[#081126] shadow-xs outline-none transition placeholder:text-slate-400 focus:border-[#0499FA] focus:ring-4 focus:ring-[#0499FA]/15"
          />
          <svg class="absolute top-3.5 left-4 h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Category Grid -->
    <div id="category-grid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
      {categories.map((category) => (
        <div data-category-name={category.name.toLowerCase()}>
          <CategoryCard category={category} />
        </div>
      ))}
    </div>

    <div id="no-category-found" class="hidden rounded-2xl border border-dashed border-slate-200 bg-white p-12 text-center">
      <p class="text-base font-extrabold text-[#081126]">No matching categories found</p>
      <p class="mt-1 text-xs text-slate-400">Try searching for Food, Fashion, Travel, or Electronics.</p>
    </div>
  </section>
</MainLayout>

<script>
  const searchInput = document.getElementById("category-search-input") as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>("[data-category-name]");
  const noResult = document.getElementById("no-category-found");

  searchInput?.addEventListener("input", (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    let visibleCount = 0;
    cards.forEach((card) => {
      const name = card.dataset.categoryName || "";
      if (!q || name.includes(q)) {
        card.style.display = "";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });
    if (noResult) {
      noResult.classList.toggle("hidden", visibleCount > 0);
    }
  });
</script>
