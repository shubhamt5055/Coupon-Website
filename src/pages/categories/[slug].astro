---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoryBySlug, getCoupons } from "../../lib/db";
import { getCategoryTheme } from "../../lib/format";

const slug = Astro.params.slug ?? "";
const includeExpired = Astro.url.searchParams.get("includeExpired") === "1";

const db = getDb();
const category = await getCategoryBySlug(db, slug);

if (!category) {
  Astro.response.status = 404;
}

const coupons = category
  ? await getCoupons(db, {
      categorySlug: category.slug,
      includeExpired,
      includeInactive: false,
      sort: "popular",
    })
  : [];

const theme = category ? getCategoryTheme(category.slug || category.name) : null;
---

<MainLayout
  title={category ? `${category.name} Coupons & Promo Codes — CouponHub` : "Category Not Found | CouponHub"}
  description={category ? `Best active discount coupons and deals in ${category.name}.` : "Category not found."}
>
  {!category ? (
    <section class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-extrabold text-[#581C87]">Category Not Found</h1>
      <p class="mt-2 text-sm text-slate-500">The category you are looking for does not exist or has been moved.</p>
      <a href="/categories" class="mt-6 inline-block rounded-2xl bg-gradient-to-r from-[#581C87] to-[#9333EA] px-6 py-3 text-sm font-bold text-white shadow-md shadow-[#9333EA]/20 transition hover:opacity-95">
        Browse All Categories
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="mb-5 flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-[#9333EA]">Home</a>
        <span>/</span>
        <a href="/categories" class="hover:text-[#9333EA]">Categories</a>
        <span>/</span>
        <span class="text-slate-800 font-bold">{category.name}</span>
      </nav>

      <!-- Category Hero Banner -->
      <div class="relative mb-10 overflow-hidden rounded-3xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8">
        <div
          class:list={[
            "pointer-events-none absolute inset-0 bg-gradient-to-r opacity-40",
            theme?.bgGradient,
          ]}
        ></div>

        <div class="relative z-10 flex flex-wrap items-center justify-between gap-6">
          <div class="flex items-center gap-4 sm:gap-5">
            <div
              class:list={[
                "flex h-16 w-16 items-center justify-center rounded-2xl text-3xl shadow-xs sm:h-20 sm:w-20 sm:text-4xl",
                theme?.iconBg,
              ]}
            >
              {category.icon || "🏷️"}
            </div>
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-[#EC4899]/30 bg-gradient-to-r from-purple-50 to-pink-50 px-2.5 py-0.5 text-[11px] font-black uppercase text-[#581C87]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#14B8A6] animate-soft-pulse"></span>
                <span>Category Hub</span>
              </span>
              <h1 class="mt-1 text-2xl font-black tracking-tight text-[#581C87] sm:text-4xl">
                {category.name} Coupons
              </h1>
              <p class="mt-1 text-xs font-medium text-slate-500 sm:text-sm">
                Showing {coupons.length} {coupons.length === 1 ? "verified deal" : "verified deals"} for {category.name}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a
              href={includeExpired ? `/categories/${category.slug}` : `/categories/${category.slug}?includeExpired=1`}
              class="rounded-xl border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 shadow-2xs transition hover:border-[#9333EA] hover:text-[#581C87]"
            >
              {includeExpired ? "Hide Expired Coupons" : "Include Expired Coupons"}
            </a>
          </div>
        </div>
      </div>

      <!-- Coupon Grid -->
      {coupons.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-slate-300 bg-white p-14 text-center shadow-xs">
          <p class="text-lg font-extrabold text-slate-800">
            No active coupons in {category.name} right now.
          </p>
          <p class="mt-1 text-xs text-slate-500">
            Check back soon or explore other categories.
          </p>
          <a href="/coupons" class="mt-4 inline-block text-xs font-black text-[#9333EA] hover:text-[#EC4899] hover:underline">
            Browse all active deals →
          </a>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {coupons.map((coupon) => (
            <CouponCard coupon={coupon} />
          ))}
        </div>
      )}
    </section>
  )}
</MainLayout>
