---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoryBySlug, getCoupons } from "../../lib/db";

const slug = Astro.params.slug ?? "";
const includeExpired = Astro.url.searchParams.get("includeExpired") === "1";

const db = getDb();
const category = await getCategoryBySlug(db, slug);

if (!category) {
  Astro.response.status = 404;
}

const coupons = category
  ? await getCoupons(db, {
      categorySlug: category.slug,
      includeExpired,
      includeInactive: false,
      sort: "popular",
    })
  : [];
---

<MainLayout
  title={category ? `${category.name} Coupons & Promo Codes — CouponHub` : "Category Not Found | CouponHub"}
  description={category ? `Best active discount coupons and deals in ${category.name}.` : "Category not found."}
>
  {!category ? (
    <section class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-black text-[#081126]">Category Not Found</h1>
      <p class="mt-2 text-sm text-slate-500">The category you are looking for does not exist or has been moved.</p>
      <a href="/categories" class="mt-6 inline-block rounded-full bg-[#0499FA] px-7 py-3 text-sm font-black text-white shadow-md shadow-[#0499FA]/20 transition hover:bg-[#0377C4]">
        Browse All Categories
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="mb-5 flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-[#0499FA] transition">Home</a>
        <span>/</span>
        <a href="/categories" class="hover:text-[#0499FA] transition">Categories</a>
        <span>/</span>
        <span class="text-[#081126] font-bold">{category.name}</span>
      </nav>

      <!-- Category Hero Banner -->
      <div class="relative mb-10 overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8">
        <div class="relative z-10 flex flex-wrap items-center justify-between gap-6">
          <div class="flex items-center gap-4 sm:gap-5">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-[#EAF6FE] text-3xl text-[#0499FA] shadow-xs sm:h-20 sm:w-20 sm:text-4xl border border-[#0499FA]/15">
              {category.icon || "🏷️"}
            </div>
            <div>
              <span class="inline-flex items-center gap-1.5 rounded-full border border-[#0499FA]/20 bg-[#EAF6FE] px-2.5 py-0.5 text-[11px] font-black uppercase text-[#0499FA]">
                <span class="h-1.5 w-1.5 rounded-full bg-[#0499FA] animate-soft-pulse"></span>
                <span>Category Hub</span>
              </span>
              <h1 class="mt-1 text-2xl font-black tracking-tight text-[#081126] sm:text-4xl">
                {category.name} Coupons &amp; Deals
              </h1>
              <p class="mt-1 text-xs font-medium text-slate-500 sm:text-sm">
                Showing {coupons.length} {coupons.length === 1 ? "verified deal" : "verified deals"} for {category.name}
              </p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <a
              href={includeExpired ? `/categories/${category.slug}` : `/categories/${category.slug}?includeExpired=1`}
              class="rounded-full border border-slate-200 bg-white px-4 py-2 text-xs font-bold text-slate-700 shadow-2xs transition hover:border-[#0499FA] hover:text-[#0499FA]"
            >
              {includeExpired ? "Hide Expired Deals" : "Include Expired Deals"}
            </a>
          </div>
        </div>
      </div>

      <!-- Coupon Grid -->
      {coupons.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-14 text-center shadow-xs">
          <p class="text-lg font-black text-[#081126]">
            No active coupons in {category.name} right now.
          </p>
          <p class="mt-1 text-xs text-slate-500">
            Check back soon or explore other categories.
          </p>
          <a href="/coupons" class="mt-4 inline-block text-xs font-black text-[#0499FA] hover:text-[#FF7A18] hover:underline">
            Browse all active deals →
          </a>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {coupons.map((coupon) => (
            <CouponCard coupon={coupon} />
          ))}
        </div>
      )}
    </section>
  )}
</MainLayout>
