---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoryBySlug, getCoupons } from "../../lib/db";

const slug = Astro.params.slug ?? "";
const includeExpired = Astro.url.searchParams.get("includeExpired") === "1";

const db = getDb();
const category = await getCategoryBySlug(db, slug);

if (!category) {
  Astro.response.status = 404;
}

const coupons = category
  ? await getCoupons(db, {
      categorySlug: category.slug,
      includeExpired,
      includeInactive: false,
      sort: "popular",
    })
  : [];
---

<MainLayout
  title={
    category
      ? `${category.name} Coupons & Promo Codes — CouponHub`
      : "Category Not Found | CouponHub"
  }
  description={
    category
      ? `Best active discount coupons and deals in ${category.name} on CouponHub.`
      : "Category not found."
  }
>
  {!category ? (
    <section class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-extrabold text-[#191f2e]">Category Not Found</h1>
      <p class="mt-2 text-xs sm:text-sm text-slate-500">
        The category you are looking for does not exist or has been moved.
      </p>
      <a
        href="/categories"
        class="mt-6 inline-block rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-bold text-white shadow-2xs hover:bg-[#129fea]"
      >
        Browse All Categories
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
      <!-- Breadcrumbs (GrabOn Style) -->
      <nav class="mb-5 flex items-center gap-2 text-xs font-medium text-slate-400">
        <a href="/" class="hover:text-[#2491ef] transition">
          Home
        </a>
        <span>/</span>
        <a href="/categories" class="hover:text-[#2491ef] transition">
          Categories
        </a>
        <span>/</span>
        <span class="text-[#191f2e] font-bold">{category.name}</span>
      </nav>

      <!-- Category Hero Banner (GrabOn Style) -->
      <div class="relative mb-8 overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-2xs">
        <div class="relative z-10 flex flex-col justify-between gap-6 sm:flex-row sm:items-center">
          <div class="flex items-center gap-4">
            <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-[#eef5ff] text-3xl text-[#2491ef] shadow-2xs">
              <span>{category.icon || "🏷️"}</span>
            </div>

            <div>
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2491ef]/20 bg-[#eef5ff] px-2.5 py-0.5 text-[11px] font-bold text-[#2491ef]">
                  <span>Verified Category Deals</span>
                </span>
                <span class="text-xs font-semibold text-slate-400">
                  {coupons.length}{" "}
                  {coupons.length === 1 ? "Offer Live" : "Offers Live"}
                </span>
              </div>

              <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-[#191f2e] sm:text-3xl">
                {category.name} Coupons &amp; Offers
              </h1>

              <p class="mt-1 text-xs sm:text-sm font-medium text-slate-500">
                Explore hand-tested discount coupons, promotional codes, and
                online shopping vouchers for {category.name}.
              </p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex items-center gap-3">
            <a
              href={
                includeExpired
                  ? `/categories/${category.slug}`
                  : `/categories/${category.slug}?includeExpired=1`
              }
              class="rounded-lg border border-slate-200 bg-white px-3.5 py-2 text-xs font-bold text-slate-600 shadow-2xs transition hover:border-[#2491ef] hover:text-[#2491ef]"
            >
              {includeExpired ? "Hide Expired Deals" : "Include Expired Deals"}
            </a>
          </div>
        </div>
      </div>

      <!-- Coupons Listing Grid -->
      <div class="space-y-6">
        <div class="flex items-center justify-between border-b border-slate-200 pb-3">
          <h2 class="text-base font-bold text-[#191f2e]">
            All {category.name} Offers ({coupons.length})
          </h2>
          <span class="text-xs font-semibold text-slate-500">
            Updated Daily
          </span>
        </div>

        {coupons.length === 0 ? (
          <div class="rounded-xl border border-dashed border-slate-300 bg-white p-12 text-center">
            <p class="font-bold text-slate-700">
              No active coupons in this category right now.
            </p>
            <p class="mt-1 text-xs text-slate-400">
              Check back soon or try enabling expired deals to browse previous
              promotions.
            </p>
          </div>
        ) : (
          <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {coupons.map((coupon) => (
              <CouponCard coupon={coupon} />
            ))}
          </div>
        )}
      </div>
    </section>
  )}
</MainLayout>
