---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import { getDb } from "../../lib/cloudflare";
import { getCategoryBySlug, getCoupons } from "../../lib/db";

const slug = Astro.params.slug ?? "";
const includeExpired = Astro.url.searchParams.get("includeExpired") === "1";

const db = getDb();
const category = await getCategoryBySlug(db, slug);

if (!category) {
  Astro.response.status = 404;
}

const coupons = category
  ? await getCoupons(db, {
      categorySlug: category.slug,
      includeExpired,
      includeInactive: false,
      sort: "popular",
    })
  : [];
---

<MainLayout
  title={category ? `${category.name} Coupons & Promo Codes | CouponHub` : "Category Not Found | CouponHub"}
  description={category ? `Best active discount coupons and deals in ${category.name}.` : "Category not found."}
>
  {!category ? (
    <section class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white">Category Not Found</h1>
      <a href="/categories" class="mt-6 inline-block rounded-xl bg-indigo-600 px-6 py-3 text-sm font-bold text-white">
        View All Categories
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <div class="mb-8 flex flex-wrap items-center justify-between gap-4 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900">
        <div class="flex items-center gap-4">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-indigo-50 text-3xl dark:bg-indigo-950/60">
            {category.icon || "🏷️"}
          </div>
          <div>
            <p class="text-xs font-bold text-indigo-600 uppercase dark:text-indigo-400">Category</p>
            <h1 class="text-2xl font-extrabold text-slate-900 sm:text-3xl dark:text-white">
              {category.name} Coupons
            </h1>
            <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
              {coupons.length} {coupons.length === 1 ? "deal" : "deals"} available
            </p>
          </div>
        </div>

        <a
          href={includeExpired ? `/categories/${category.slug}` : `/categories/${category.slug}?includeExpired=1`}
          class="rounded-xl border border-slate-200 px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-100 dark:border-slate-700 dark:text-slate-200 dark:hover:bg-slate-800"
        >
          {includeExpired ? "Hide Expired Coupons" : "Include Expired Coupons"}
        </a>
      </div>

      {coupons.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-12 text-center dark:border-slate-700 dark:bg-slate-900">
          <p class="text-lg font-bold text-slate-700 dark:text-slate-200">
            No active coupons in {category.name} right now.
          </p>
          <a href="/coupons" class="mt-4 inline-block text-sm font-bold text-indigo-600 hover:underline">
            Browse all active deals →
          </a>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {coupons.map((coupon) => (
            <CouponCard coupon={coupon} />
          ))}
        </div>
      )}
    </section>
  )}
</MainLayout>
