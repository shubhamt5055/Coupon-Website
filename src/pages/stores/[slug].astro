---
import MainLayout from "../../layouts/MainLayout.astro";
import CouponCard from "../../components/CouponCard.astro";
import StoreLogo from "../../components/StoreLogo.astro";
import { getDb } from "../../lib/cloudflare";
import { getCoupons, getStoreBySlug } from "../../lib/db";
import {
  getStoreBrandTheme,
  safeExternalUrl,
} from "../../lib/format";

const slug = Astro.params.slug ?? "";
const includeExpired = Astro.url.searchParams.get("includeExpired") === "1";

const db = getDb();
const store = await getStoreBySlug(db, slug);

if (!store) {
  Astro.response.status = 404;
}

const coupons = store
  ? await getCoupons(db, {
      storeSlug: store.slug,
      includeExpired,
      includeInactive: false,
      sort: "popular",
    })
  : [];

const websiteUrl = store ? safeExternalUrl(store.website_url) : "#";
const theme = store ? getStoreBrandTheme(store.slug || store.name) : null;
---

<MainLayout
  title={store ? `${store.name} Coupon Codes & Verified Promo Codes — Couponly` : "Store Not Found | Couponly"}
  description={store ? `Verified ${store.name} promo codes and discount offers.` : "Store not found."}
>
  {!store ? (
    <section class="mx-auto max-w-2xl px-4 py-20 text-center">
      <h1 class="text-3xl font-black text-[#081126]">Store Not Found</h1>
      <p class="mt-2 text-sm text-slate-500">The store you are looking for does not exist or has been removed.</p>
      <a href="/stores" class="mt-6 inline-block rounded-full bg-[#0499FA] px-7 py-3 text-sm font-black text-white shadow-md shadow-[#0499FA]/20 transition hover:bg-[#0377C4]">
        Browse All Stores
      </a>
    </section>
  ) : (
    <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
      <!-- Breadcrumbs -->
      <nav class="mb-5 flex items-center gap-2 text-xs font-semibold text-slate-400">
        <a href="/" class="hover:text-[#0499FA] transition">Home</a>
        <span>/</span>
        <a href="/stores" class="hover:text-[#0499FA] transition">Stores</a>
        <span>/</span>
        <span class="text-[#081126] font-bold">{store.name}</span>
      </nav>

      <!-- Store Hero Banner -->
      <div class="relative mb-10 overflow-hidden rounded-2xl border border-slate-200/90 bg-white p-6 shadow-xs sm:p-8">
        <div class="relative z-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
          <div class="flex items-start gap-4 sm:gap-5">
            <div class="h-18 w-18 shrink-0 rounded-2xl border border-slate-200/90 bg-white p-2 shadow-xs flex items-center justify-center overflow-hidden">
              <StoreLogo store={store} size="lg" />
            </div>

            <div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-full border border-[#0499FA]/20 bg-[#EAF6FE] px-2.5 py-0.5 text-[11px] font-black text-[#0499FA]">
                  <span class="h-1.5 w-1.5 rounded-full bg-[#0499FA] animate-soft-pulse"></span>
                  <span>Verified Partner</span>
                </span>
                <span class="text-xs font-semibold text-slate-400">
                  {coupons.length} {coupons.length === 1 ? "Offer Live" : "Offers Live"}
                </span>
              </div>

              <h1 class="mt-1.5 text-2xl font-black tracking-tight text-[#081126] sm:text-4xl">
                {store.name} Coupons &amp; Promo Codes
              </h1>

              <p class="mt-1.5 max-w-2xl text-xs font-medium leading-relaxed text-slate-600 sm:text-sm">
                {store.description || theme?.brandTagline}
              </p>
            </div>
          </div>

          <!-- Actions -->
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={includeExpired ? `/stores/${store.slug}` : `/stores/${store.slug}?includeExpired=1`}
              class="rounded-full border border-slate-200 bg-white px-4 py-2.5 text-xs font-bold text-slate-700 shadow-2xs transition hover:border-[#0499FA] hover:text-[#0499FA]"
            >
              {includeExpired ? "Hide Expired Deals" : "Include Expired Deals"}
            </a>
            {websiteUrl !== "#" && (
              <a
                href={websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 rounded-full bg-[#FF7A18] px-5 py-2.5 text-xs font-black text-white shadow-md shadow-[#FF7A18]/25 transition hover:bg-[#E6680C] active:scale-95"
              >
                <span>Visit {store.name}</span>
                <span>↗</span>
              </a>
            )}
          </div>
        </div>
      </div>

      <!-- Coupon Grid -->
      {coupons.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-14 text-center shadow-xs">
          <p class="text-lg font-black text-[#081126]">
            No active coupons for {store.name} right now.
          </p>
          <p class="mt-1 text-xs text-slate-500">
            Check back soon or explore other partner stores.
          </p>
          <a href="/stores" class="mt-4 inline-block text-xs font-black text-[#0499FA] hover:underline">
            Explore other partner stores →
          </a>
        </div>
      ) : (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {coupons.map((coupon) => (
            <CouponCard coupon={coupon} />
          ))}
        </div>
      )}
    </section>
  )}
</MainLayout>
