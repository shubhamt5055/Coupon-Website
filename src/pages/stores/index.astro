---
import MainLayout from "../../layouts/MainLayout.astro";
import StoreCard from "../../components/StoreCard.astro";
import StoreLogo from "../../components/StoreLogo.astro";
import { getDb } from "../../lib/cloudflare";
import { getStoresWithCounts } from "../../lib/db";

const stores = await getStoresWithCounts(getDb());
const totalDeals = stores.reduce((sum, s) => sum + (s.active_coupon_count ?? 0), 0);
---

<MainLayout
  title="All Partner Stores & Brands — CouponHub"
  description="Find promo codes and verified discounts for top online stores including Amazon, Flipkart, Zomato, Swiggy, Myntra, MakeMyTrip, and more."
>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <!-- Header Banner -->
    <div class="mb-10 text-center sm:text-left">
      <div class="inline-flex items-center gap-2 rounded-full border border-[#EC4899]/30 bg-gradient-to-r from-purple-50 via-pink-50 to-amber-50 px-3.5 py-1 text-xs font-bold text-[#581C87] shadow-2xs">
        <span class="h-2 w-2 rounded-full bg-[#14B8A6] animate-soft-pulse"></span>
        <span>{stores.length} Partner Stores · {totalDeals} Verified Deals Active</span>
      </div>
      <h1 class="mt-3 text-3xl font-black tracking-tight text-[#581C87] sm:text-4xl">
        All Partner Stores &amp; Brands
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-slate-500">
        Choose your favorite store to access tested discount coupons, exclusive promo codes, and special seasonal sales.
      </p>

      <!-- Instant Filter Input -->
      <div class="mt-6 max-w-md">
        <div class="relative">
          <input
            type="text"
            id="store-search-input"
            placeholder="Search stores (e.g., Amazon, Swiggy, Myntra)..."
            class="w-full rounded-2xl border border-slate-200 bg-white py-3 pr-4 pl-11 text-sm font-semibold text-slate-800 shadow-xs outline-none transition placeholder:text-slate-400 focus:border-[#9333EA] focus:ring-4 focus:ring-[#9333EA]/15"
          />
          <svg class="absolute top-3.5 left-4 h-4 w-4 text-slate-400" viewBox="0 0 20 20" fill="currentColor">
            <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>
    </div>

    <!-- Store Cards Grid -->
    <div id="store-grid" class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {stores.map((store) => (
        <div data-store-name={store.name.toLowerCase()}>
          <StoreCard store={store} />
        </div>
      ))}
    </div>

    <div id="no-store-found" class="hidden rounded-3xl border border-dashed border-slate-200 bg-white p-12 text-center">
      <p class="text-base font-extrabold text-slate-700">No matching stores found</p>
      <p class="mt-1 text-xs text-slate-400">Try searching for Amazon, Flipkart, Zomato, or Swiggy.</p>
    </div>
  </section>
</MainLayout>

<script>
  const searchInput = document.getElementById("store-search-input") as HTMLInputElement | null;
  const cards = document.querySelectorAll<HTMLElement>("[data-store-name]");
  const noResult = document.getElementById("no-store-found");

  searchInput?.addEventListener("input", (e) => {
    const q = (e.target as HTMLInputElement).value.trim().toLowerCase();
    let visibleCount = 0;
    cards.forEach((card) => {
      const name = card.dataset.storeName || "";
      if (!q || name.includes(q)) {
        card.style.display = "";
        visibleCount++;
      } else {
        card.style.display = "none";
      }
    });
    if (noResult) {
      noResult.classList.toggle("hidden", visibleCount > 0);
    }
  });
</script>
