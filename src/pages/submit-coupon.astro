---
import MainLayout from "../layouts/MainLayout.astro";
import { getDb } from "../lib/cloudflare";
import { getCategoriesWithCounts, getStoresWithCounts } from "../lib/db";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/submit-coupon&reason=signin-required");
}

const db = getDb();
const [stores, categories] = await Promise.all([
  getStoresWithCounts(db),
  getCategoriesWithCounts(db),
]);

const defaultExpiry = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
---

<MainLayout
  title="Submit a Coupon — CouponHub"
  description="Share a discount coupon or promo code with the CouponHub community."
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="mb-8">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-purple-50 border border-[#9333EA]/25 px-3 py-1 text-xs font-black text-[#581C87]">
            <span class="h-2 w-2 rounded-full bg-[#14B8A6] animate-pulse"></span>
            Signed in as {user.name} ({user.email})
          </span>
          <h1 class="mt-3 text-3xl font-black tracking-tight text-[#581C87]">
            Share a Working Coupon
          </h1>
          <p class="mt-1 text-sm text-slate-600">
            Found a discount code? Submit it below. It will be sent to the Admin Panel for verification before appearing live on the public website.
          </p>
        </div>

        <a
          href="/my-coupons"
          class="rounded-xl border border-[#9333EA]/20 bg-white px-4 py-2 text-xs font-bold text-[#581C87] shadow-2xs transition hover:bg-purple-50 hover:border-[#9333EA]/40"
        >
          My Coupons →
        </a>
      </div>

      <div class="mt-4 flex items-center gap-2.5 rounded-2xl border border-[#9333EA]/20 bg-gradient-to-r from-purple-50/70 via-pink-50/40 to-white p-3.5 text-xs text-[#581C87]">
        <span class="text-base">🛡️</span>
        <p><strong>Admin Verification:</strong> To ensure high coupon quality and avoid broken codes, coupons submitted by visitors are verified by our team before publishing.</p>
      </div>
    </div>

    <!-- Alert Box -->
    <div
      id="submit-alert"
      class="mb-6 hidden rounded-2xl border border-rose-200 bg-rose-50 p-4 text-sm font-semibold text-rose-700"
    ></div>

    <!-- Form -->
    <form
      id="user-coupon-form"
      class="space-y-6 rounded-3xl border border-[#9333EA]/20 bg-white p-6 shadow-sm sm:p-8"
    >
      <div class="grid gap-5 sm:grid-cols-2">
        <!-- Title -->
        <div class="sm:col-span-2">
          <label for="coupon-title" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Coupon Title *
          </label>
          <input
            id="coupon-title"
            name="title"
            type="text"
            required
            maxlength="140"
            placeholder="e.g. Flat 25% Off on Footwear & Sneakers"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          />
        </div>

        <!-- Code -->
        <div>
          <label for="coupon-code" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Promo / Coupon Code *
          </label>
          <input
            id="coupon-code"
            name="code"
            type="text"
            required
            maxlength="40"
            placeholder="e.g. SAVE25"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 font-mono text-sm uppercase outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          />
        </div>

        <!-- Discount Badge -->
        <div>
          <label for="coupon-discount" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Discount Badge *
          </label>
          <input
            id="coupon-discount"
            name="discount_text"
            type="text"
            required
            maxlength="40"
            placeholder="e.g. 25% OFF or ₹150 OFF"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          />
        </div>

        <!-- Store Selection -->
        <div>
          <label for="coupon-store" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Store / Brand *
          </label>
          <select
            id="coupon-store"
            name="store_id"
            required
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 transition"
          >
            <option value="">Select Store</option>
            {stores.map((s) => (
              <option value={s.id}>{s.name}</option>
            ))}
          </select>
        </div>

        <!-- Category Selection -->
        <div>
          <label for="coupon-category" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Category *
          </label>
          <select
            id="coupon-category"
            name="category_id"
            required
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-3.5 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 transition"
          >
            <option value="">Select Category</option>
            {categories.map((c) => (
              <option value={c.id}>
                {c.icon} {c.name}
              </option>
            ))}
          </select>
        </div>

        <!-- Store URL -->
        <div>
          <label for="coupon-url" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Store / Deal Link *
          </label>
          <input
            id="coupon-url"
            name="affiliate_or_store_url"
            type="url"
            required
            placeholder="https://www.example.com/deal"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          />
        </div>

        <!-- Expiry Date -->
        <div>
          <label for="coupon-expiry" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Expiry Date *
          </label>
          <input
            id="coupon-expiry"
            name="expiry_date"
            type="date"
            required
            value={defaultExpiry}
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          />
        </div>

        <!-- Description -->
        <div class="sm:col-span-2">
          <label for="coupon-desc" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Description
          </label>
          <textarea
            id="coupon-desc"
            name="description"
            rows="3"
            maxlength="1000"
            placeholder="What products or minimum purchase is required for this discount?"
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          ></textarea>
        </div>

        <!-- Terms -->
        <div class="sm:col-span-2">
          <label for="coupon-terms" class="mb-1.5 block text-xs font-bold text-slate-700 uppercase">
            Terms &amp; Conditions
          </label>
          <textarea
            id="coupon-terms"
            name="terms"
            rows="2"
            maxlength="1500"
            placeholder="e.g. Valid on prepaid orders only. Cannot be combined with other offers."
            class="w-full rounded-xl border border-slate-300 bg-slate-50 px-4 py-2.5 text-sm outline-none focus:border-[#9333EA] focus:ring-2 focus:ring-[#9333EA]/20 focus:bg-white transition"
          ></textarea>
        </div>
      </div>

      <!-- Action buttons -->
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 pt-5">
        <a
          href="/"
          class="rounded-xl border border-slate-200 px-5 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50"
        >
          Cancel
        </a>
        <button
          type="submit"
          id="submit-btn"
          class="rounded-xl bg-gradient-to-r from-[#581C87] via-[#9333EA] to-[#EC4899] px-7 py-3 text-sm font-black text-white shadow-md shadow-[#9333EA]/20 transition hover:opacity-95 disabled:opacity-60"
        >
          Submit Coupon for Verification 🚀
        </button>
      </div>
    </form>
  </div>
</MainLayout>

<script>
  const form = document.getElementById("user-coupon-form") as HTMLFormElement | null;
  const alertBox = document.getElementById("submit-alert");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (alertBox) alertBox.classList.add("hidden");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting for Review...";
    }

    const fd = new FormData(form);
    const payload = {
      title: String(fd.get("title") || ""),
      code: String(fd.get("code") || ""),
      discount_text: String(fd.get("discount_text") || ""),
      store_id: Number(fd.get("store_id")),
      category_id: Number(fd.get("category_id")),
      affiliate_or_store_url: String(fd.get("affiliate_or_store_url") || ""),
      expiry_date: String(fd.get("expiry_date") || ""),
      description: String(fd.get("description") || ""),
      terms: String(fd.get("terms") || ""),
    };

    try {
      const res = await fetch("/api/coupons/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as { ok?: boolean; id?: number; error?: string };

      if (!res.ok || !data.ok) {
        if (alertBox) {
          alertBox.textContent = data.error || "Please check all fields and try again.";
          alertBox.classList.remove("hidden");
        }
        return;
      }

      window.location.href = `/my-coupons?submitted=pending&id=${data.id}`;
    } catch {
      if (alertBox) {
        alertBox.textContent = "Network error. Please try again.";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit Coupon for Verification 🚀";
      }
    }
  });
</script>
