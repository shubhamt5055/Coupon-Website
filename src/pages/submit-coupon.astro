---
import MainLayout from "../layouts/MainLayout.astro";
import { getDb } from "../lib/cloudflare";
import { getCategoriesWithCounts, getStoresWithCounts } from "../lib/db";

const user = Astro.locals.user;
if (!user) {
  return Astro.redirect("/login?next=/submit-coupon&reason=signin-required");
}

const db = getDb();
const [stores, categories] = await Promise.all([
  getStoresWithCounts(db),
  getCategoriesWithCounts(db),
]);

const defaultExpiry = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
---

<MainLayout
  title="Submit a Coupon — CouponHub | Save On Everything"
  description="Share a verified discount coupon or promo code with the CouponHub community."
>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Header (GrabOn Style) -->
    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full border border-[#2491ef]/20 bg-[#eef5ff] px-3.5 py-1 text-xs font-bold text-[#2491ef]">
          <span class="h-2 w-2 rounded-full bg-[#60a600] animate-pulse"></span>
          Signed in as {user.name} ({user.email})
        </span>
        <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[#191f2e] sm:text-4xl">
          Share a Working Coupon
        </h1>
        <p class="mt-1 text-xs sm:text-sm text-slate-500">
          Found a discount code? Submit it below. Our editorial team hand-tests it before it goes live for millions of shoppers.
        </p>
      </div>
      <a
        href="/my-coupons"
        class="rounded-lg border border-slate-200 bg-white px-3.5 py-1.5 text-xs font-bold text-slate-700 shadow-2xs transition hover:border-[#2491ef] hover:text-[#2491ef]"
      >
        My submitted coupons →
      </a>
    </div>

    <div class="mb-6 flex items-center gap-3 rounded-xl border border-[#2491ef]/20 bg-[#eef5ff] p-3.5 text-xs text-slate-700">
      <span class="text-lg">🛡️</span>
      <p>
        <strong>100% Quality Assurance:</strong> Every submitted coupon is verified by our team to keep expired or broken promo codes off CouponHub.
      </p>
    </div>

    <div
      id="submit-alert"
      class="mb-6 hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs font-semibold text-rose-700"
    ></div>

    <!-- Form Container -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-2xs sm:p-8">
      <form id="user-coupon-form" class="space-y-6">
        <!-- Coupon Basics -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            1. Offer Essentials
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label for="coupon-title" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Coupon Title *
              </label>
              <input
                id="coupon-title"
                name="title"
                type="text"
                required
                maxlength="140"
                placeholder="e.g. Flat 25% Off on Footwear & Sneakers"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
            </div>
            <div>
              <label for="coupon-code" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Promo Code *
              </label>
              <input
                id="coupon-code"
                name="code"
                type="text"
                required
                maxlength="40"
                placeholder="e.g. SAVE25"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 font-mono text-xs sm:text-sm uppercase tracking-widest text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
            </div>
            <div>
              <label for="coupon-discount" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Discount Text / Badge *
              </label>
              <input
                id="coupon-discount"
                name="discount_text"
                type="text"
                required
                maxlength="40"
                placeholder="e.g. 25% OFF or ₹150 OFF"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
            </div>
          </div>
        </div>

        <!-- Store & Expiry -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            2. Store &amp; Link Details
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label for="coupon-store" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Store / Brand *
              </label>
              <select
                id="coupon-store"
                name="store_id"
                required
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              >
                <option value="">Select store</option>
                {stores.map((s) => (
                  <option value={s.id}>{s.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="coupon-category" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Category *
              </label>
              <select
                id="coupon-category"
                name="category_id"
                required
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              >
                <option value="">Select category</option>
                {categories.map((c) => (
                  <option value={c.id}>
                    {c.icon} {c.name}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label for="coupon-url" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Store / Deal Link *
              </label>
              <input
                id="coupon-url"
                name="affiliate_or_store_url"
                type="url"
                required
                placeholder="https://www.example.com/deal"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
            </div>
            <div>
              <label for="coupon-expiry" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Expiry Date *
              </label>
              <input
                id="coupon-expiry"
                name="expiry_date"
                type="date"
                required
                value={defaultExpiry}
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
            </div>
          </div>
        </div>

        <!-- Description & Terms -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            3. Description &amp; Terms
          </h3>
          <div class="space-y-4">
            <div>
              <label for="coupon-desc" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Description
              </label>
              <textarea
                id="coupon-desc"
                name="description"
                rows="3"
                maxlength="1000"
                placeholder="What products or minimum purchase is required for this discount?"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              ></textarea>
            </div>
            <div>
              <label for="coupon-terms" class="mb-1 block text-xs font-bold text-[#191f2e]">
                Terms &amp; Conditions
              </label>
              <textarea
                id="coupon-terms"
                name="terms"
                rows="2"
                maxlength="1500"
                placeholder="e.g. Valid on prepaid orders only. Cannot be combined with other offers."
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Submit Actions -->
        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
          <a
            href="/"
            class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 transition"
          >
            Cancel
          </a>
          <button
            type="submit"
            id="submit-btn"
            class="rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-extrabold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
          >
            Submit for Verification 🚀
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById("user-coupon-form") as HTMLFormElement | null;
  const alertBox = document.getElementById("submit-alert");
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (alertBox) alertBox.classList.add("hidden");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Submitting for Review...";
    }

    const fd = new FormData(form);
    const payload = {
      title: String(fd.get("title") || ""),
      code: String(fd.get("code") || ""),
      discount_text: String(fd.get("discount_text") || ""),
      store_id: Number(fd.get("store_id")),
      category_id: Number(fd.get("category_id")),
      affiliate_or_store_url: String(fd.get("affiliate_or_store_url") || ""),
      expiry_date: String(fd.get("expiry_date") || ""),
      description: String(fd.get("description") || ""),
      terms: String(fd.get("terms") || ""),
    };

    try {
      const res = await fetch("/api/coupons/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as {
        ok?: boolean;
        id?: number;
        error?: string;
      };

      if (!res.ok || !data.ok) {
        if (alertBox) {
          alertBox.textContent = data.error || "Please check all fields and try again.";
          alertBox.classList.remove("hidden");
        }
        return;
      }

      window.location.href = `/my-coupons?submitted=pending&id=${data.id}`;
    } catch {
      if (alertBox) {
        alertBox.textContent = "Network error. Please try again.";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Submit for Verification 🚀";
      }
    }
  });
</script>
