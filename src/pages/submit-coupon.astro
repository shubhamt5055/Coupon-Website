---
import MainLayout from "../layouts/MainLayout.astro";
import { getDb } from "../lib/cloudflare";
import { getCategoriesWithCounts, getStoresWithCounts } from "../lib/db";

const db = getDb();
const [stores, categories] = await Promise.all([
  getStoresWithCounts(db),
  getCategoriesWithCounts(db),
]);

const today = new Date().toISOString().slice(0, 10);
const defaultExpiry = new Date(Date.now() + 30 * 24 * 60 * 60 * 1000)
  .toISOString()
  .slice(0, 10);
---

<MainLayout
  title="Add a Coupon — CouponHub | Save On Everything"
  description="Add a working promo code or coupon with no login required. Live publishing immediately."
>
  <div class="mx-auto max-w-3xl px-4 py-8 sm:px-6 lg:px-8">
    <!-- Header (GrabOn Style) -->
    <div class="mb-6">
      <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-200 bg-emerald-50 px-3.5 py-1 text-xs font-bold text-emerald-800">
        <span class="h-2 w-2 rounded-full bg-[#60a600] animate-pulse"></span>
        100% Free &amp; Open: No Login Required!
      </span>
      <h1 class="mt-3 text-3xl font-extrabold tracking-tight text-[#191f2e] sm:text-4xl">
        Add a Working Coupon
      </h1>
      <p class="mt-1 text-xs sm:text-sm text-slate-500">
        Anyone can add a coupon. Fill out the details below and your deal goes
        live immediately across CouponHub!
      </p>
    </div>

    <!-- Instant Publishing Notification Banner -->
    <div class="mb-6 flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50/70 p-3.5 text-xs text-emerald-900">
      <span class="text-xl">⚡</span>
      <p>
        <strong>Zero Barrier Live Publishing:</strong> No sign-in or admin
        approval required. Fill the coupon details below and it goes live
        instantly!
      </p>
    </div>

    <div
      id="submit-alert"
      class="mb-6 hidden rounded-xl border border-rose-200 bg-rose-50 p-4 text-xs font-semibold text-rose-700"
    ></div>

    <!-- Form Container -->
    <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-2xs sm:p-8">
      <form id="user-coupon-form" class="space-y-6">
        <!-- Coupon Basics -->
        <div>
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            1. Offer Essentials
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div class="sm:col-span-2">
              <label
                for="coupon-title"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Coupon Title *
              </label>
              <input
                id="coupon-title"
                name="title"
                type="text"
                required
                minlength="5"
                maxlength="140"
                placeholder="e.g. Flat 25% Off on Footwear & Sneakers"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
              <p class="mt-1 text-[11px] text-slate-400">
                Min 5 - Max 140 characters. Special symbols (&lt; &gt; . / ?
                &quot; [ ] &#123; &#125; \ | - + * @ ! ~ # $ ^ ( ) =) are not
                allowed.
              </p>
            </div>
            <div>
              <label
                for="coupon-code"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Promo Code *
              </label>
              <input
                id="coupon-code"
                name="code"
                type="text"
                required
                minlength="2"
                maxlength="30"
                placeholder="e.g. SAVE25"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 font-mono text-xs sm:text-sm uppercase tracking-widest text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
              <p class="mt-1 text-[11px] text-slate-400">
                Letters, numbers, and hyphens (2–30 characters).
              </p>
            </div>
            <div>
              <label
                for="coupon-discount"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Discount Text / Badge *
              </label>
              <input
                id="coupon-discount"
                name="discount_text"
                type="text"
                required
                maxlength="40"
                placeholder="e.g. 25% OFF or ₹150 OFF"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
              <p class="mt-1 text-[11px] text-slate-400">
                Max 99% OFF (or flat amount, e.g. ₹150 OFF).
              </p>
            </div>
          </div>
        </div>

        <!-- Store & Expiry -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            2. Store &amp; Link Details
          </h3>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label
                for="coupon-store"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Store / Brand *
              </label>
              <select
                id="coupon-store"
                name="store_id"
                required
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              >
                <option value="">Select store</option>
                {stores.map((s) => (
                  <option value={s.id}>{s.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label
                for="coupon-category"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Category *
              </label>
              <select
                id="coupon-category"
                name="category_id"
                required
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              >
                <option value="">Select category</option>
                {categories.map((c) => (
                  <option value={c.id}>
                    {c.icon} {c.name}
                  </option>
                ))}
              </select>
            </div>
            <div>
              <label
                for="coupon-url"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Store / Deal Link *
              </label>
              <input
                id="coupon-url"
                name="affiliate_or_store_url"
                type="url"
                required
                placeholder="https://www.example.com/deal"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
              <p class="mt-1 text-[11px] text-slate-400">
                Must start with http:// or https:// with valid domain.
              </p>
            </div>
            <div>
              <label
                for="coupon-expiry"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Expiry Date *
              </label>
              <input
                id="coupon-expiry"
                name="expiry_date"
                type="date"
                required
                min={today}
                value={defaultExpiry}
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              />
              <p class="mt-1 text-[11px] text-slate-400">
                Must be today or a future date.
              </p>
            </div>
          </div>
        </div>

        <!-- Description & Terms -->
        <div class="border-t border-slate-100 pt-5">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400 mb-3">
            3. Description &amp; Terms
          </h3>
          <div class="space-y-4">
            <div>
              <label
                for="coupon-desc"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Description
              </label>
              <textarea
                id="coupon-desc"
                name="description"
                rows="3"
                maxlength="1000"
                placeholder="What products or minimum purchase is required for this discount?"
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              ></textarea>
            </div>
            <div>
              <label
                for="coupon-terms"
                class="mb-1 block text-xs font-bold text-[#191f2e]"
              >
                Terms &amp; Conditions
              </label>
              <textarea
                id="coupon-terms"
                name="terms"
                rows="2"
                maxlength="1500"
                placeholder="e.g. Valid on prepaid orders only. Cannot be combined with other offers."
                class="w-full rounded-lg border border-slate-300 bg-[#f8fafc] px-3.5 py-2.5 text-xs sm:text-sm font-medium text-[#191f2e] outline-none transition focus:border-[#2491ef] focus:bg-white focus:ring-2 focus:ring-[#2491ef]/20"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Submit Actions -->
        <div class="flex items-center justify-between border-t border-slate-100 pt-4">
          <a
            href="/"
            class="rounded-lg border border-slate-200 px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-50 transition"
          >
            Cancel
          </a>
          <button
            type="submit"
            id="submit-btn"
            class="rounded-lg bg-[#2491ef] px-6 py-2.5 text-xs font-extrabold uppercase tracking-wider text-white shadow-2xs transition hover:bg-[#129fea] active:scale-95 disabled:opacity-60"
          >
            Publish Coupon Instantly
          </button>
        </div>
      </form>
    </div>
  </div>
</MainLayout>

<script>
  const form = document.getElementById(
    "user-coupon-form",
  ) as HTMLFormElement | null;
  const alertBox = document.getElementById("submit-alert");
  const submitBtn = document.getElementById(
    "submit-btn",
  ) as HTMLButtonElement | null;

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (alertBox) alertBox.classList.add("hidden");

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.textContent = "Publishing Instantly...";
    }

    const fd = new FormData(form);
    const payload = {
      title: String(fd.get("title") || "").trim(),
      code: String(fd.get("code") || "")
        .trim()
        .toUpperCase()
        .replace(/\s+/g, ""),
      discount_text: String(fd.get("discount_text") || "").trim(),
      store_id: Number(fd.get("store_id")),
      category_id: Number(fd.get("category_id")),
      affiliate_or_store_url: String(
        fd.get("affiliate_or_store_url") || "",
      ).trim(),
      expiry_date: String(fd.get("expiry_date") || "").trim(),
      description: String(fd.get("description") || "").trim(),
      terms: String(fd.get("terms") || "").trim(),
    };

    // Client-side validations
    if (payload.title.length < 5) {
      if (alertBox) {
        alertBox.textContent =
          "Coupon title must be at least 5 characters long.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    if (payload.title.length > 140) {
      if (alertBox) {
        alertBox.textContent = "Coupon title cannot exceed 140 characters.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    const letterMatches = payload.title.match(/[\p{L}]/gu);
    if (!letterMatches || letterMatches.length < 2) {
      if (alertBox) {
        alertBox.textContent =
          "Title cannot be only numbers or symbols. Please include descriptive words.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    const disallowedTitleCharsRegex = /[<>./?"\]\[{}\\|+\-*@!~#$^()=]/;
    if (disallowedTitleCharsRegex.test(payload.title)) {
      if (alertBox) {
        alertBox.textContent =
          'Special symbols (< > . / ? " [ ] { } \\ | - + * @ ! ~ # $ ^ ( ) =) are not allowed in Title.';
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    const titleAllowedRegex = /^[\p{L}\p{N}\s%₹&',:–—]+$/u;
    if (!titleAllowedRegex.test(payload.title)) {
      if (alertBox) {
        alertBox.textContent =
          "Title contains invalid characters. Special symbols are not allowed.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    if (payload.code.length < 2 || payload.code.length > 30) {
      if (alertBox) {
        alertBox.textContent =
          "Promo code must be between 2 and 30 characters.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    if (!/^[A-Z0-9_-]+$/.test(payload.code)) {
      if (alertBox) {
        alertBox.textContent =
          "Promo code can only contain letters, numbers, hyphens, and underscores.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    const pctMatch = payload.discount_text.match(/(\d+(?:\.\d+)?)\s*%/);
    if (pctMatch) {
      const pctVal = parseFloat(pctMatch[1]);
      if (pctVal > 99) {
        if (alertBox) {
          alertBox.textContent =
            "Discount percentage cannot exceed 99% (maximum allowed is 99% OFF).";
          alertBox.classList.remove("hidden");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Publish Coupon Instantly 🚀";
        }
        return;
      }
      if (pctVal <= 0) {
        if (alertBox) {
          alertBox.textContent = "Discount percentage must be greater than 0%.";
          alertBox.classList.remove("hidden");
        }
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = "Publish Coupon Instantly 🚀";
        }
        return;
      }
    }

    try {
      const parsedUrl = new URL(payload.affiliate_or_store_url);
      if (parsedUrl.protocol !== "http:" && parsedUrl.protocol !== "https:") {
        throw new Error("Invalid protocol");
      }
      if (!parsedUrl.hostname || !parsedUrl.hostname.includes(".")) {
        throw new Error("Invalid domain");
      }
    } catch {
      if (alertBox) {
        alertBox.textContent =
          "Please enter a valid store/deal link URL (e.g. https://www.store.com/deal).";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    const todayStr = new Date().toISOString().slice(0, 10);
    if (payload.expiry_date < todayStr) {
      if (alertBox) {
        alertBox.textContent =
          "Expiry date cannot be in the past. Please choose today or a future date.";
        alertBox.classList.remove("hidden");
      }
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
      return;
    }

    try {
      const res = await fetch("/api/coupons/submit", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = (await res.json()) as {
        ok?: boolean;
        id?: number;
        error?: string;
      };

      if (!res.ok || !data.ok) {
        if (alertBox) {
          alertBox.textContent =
            data.error || "Please check all fields and try again.";
          alertBox.classList.remove("hidden");
        }
        return;
      }

      // Live immediately! Redirect directly to live coupons
      window.location.href = "/coupons";
    } catch {
      if (alertBox) {
        alertBox.textContent = "Network error. Please try again.";
        alertBox.classList.remove("hidden");
      }
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.textContent = "Publish Coupon Instantly 🚀";
      }
    }
  });
</script>
